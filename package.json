{
  "name": "sampledge-talk2tax",
  "private": true,
  "version": "0.1.0",
  "description": "Sampledge Talk2Tax: AI-native accounting, tax and finance platform (monorepo)",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "db:migrate": "pnpm --filter @talk2tax/database run migrate:deploy",
    "db:seed": "pnpm --filter @talk2tax/api run seed",
    "dev:api": "pnpm --filter @talk2tax/api run dev",
    "features:generate": "node scripts/generate-feature-registry.mjs"
  }
}
