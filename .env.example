# Copy to .env and adjust. Never commit real secrets.
NODE_ENV=development
PORT=4000
# MongoDB, the database (docs/MONGODB.md). Must be a replica set, for transactions:
# `docker compose up -d mongo` gives a one-node set named rs0.
MONGODB_URL=mongodb://localhost:27017/talk2tax?replicaSet=rs0
# Integration tests use a separate database (its name must contain "test"). They never reset it;
# each test creates its own organisations.
TEST_MONGODB_URL=mongodb://localhost:27017/talk2tax_test?replicaSet=rs0
# Generate with: openssl rand -base64 48
# Any secret here can be read from a file instead: JWT_SECRET_FILE=/run/secrets/jwt (not both).
# Production refuses example values like this one: openssl rand -hex 32
JWT_SECRET=replace-me-with-a-long-random-secret-of-at-least-32-chars
# Access tokens are short-lived; sessions are renewed with a rotating refresh token.
JWT_TTL_SECONDS=900
SESSION_TTL_DAYS=30
SESSION_IDLE_DAYS=7
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_API_PER_MINUTE=600
# Proxy hops to trust for the client IP (the web app's proxy counts as one).
TRUST_PROXY_HOPS=1
CORS_ORIGINS=http://localhost:3000
# Encryption in transit (SEC-010). HTTPS_ONLY=true refuses API requests that did not arrive over
# HTTPS (TLS ends at your proxy; needs TRUST_PROXY_HOPS >= 1); unset, it is on in production when
# APP_URL is https://. On the web app, unset means on for a production build. MONGODB_REQUIRE_TLS (default:
# the same as HTTPS_ONLY) refuses to start unless MONGODB_URL is mongodb+srv:// or has tls=true.
# HTTPS_ONLY=
# MONGODB_REQUIRE_TLS=
# Web app (apps/web): where its server-side proxy reaches the API.
T2T_API_URL=http://localhost:4000
# Web app: X-Forwarded-For entries to count from the right for the browser address (1 = the reverse proxy in front of it).
T2T_CLIENT_IP_HOPS=1
# AI (Anthropic Claude API). Optional: each organisation adds its own key and model in the app
# (Settings → Integrations). A key here is only a fallback for organisations without their own.
ANTHROPIC_API_KEY=
COPILOT_MODEL=claude-opus-5-5
COPILOT_MAX_TOOL_ROUNDS=8
# AI tasks each agent may start per hour in one organisation, unless it sets its own (0 = no default limit).
AI_AGENT_TASKS_PER_HOUR=500
COPILOT_TURN_TIMEOUT_SECONDS=240
# Workflow automations. How often the runner looks for new events, schedules and due deliveries (seconds; 0 = off).
WORKFLOW_RUNNER_INTERVAL_SECONDS=10
# Webhooks may reach http:// and private or loopback addresses. For local development only; leave it
# false in production, where webhooks must go to public https:// addresses.
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false
WEBHOOK_TIMEOUT_SECONDS=10
# Email, over SMTP. Optional: each organisation adds its own mail server in the app (Settings →
# Integrations). This is only a fallback: smtp://user:password@host:587 or smtps://user:password@host:465.
SMTP_URL=
# Or the same server as separate settings (used when SMTP_URL is empty). Zoho Mail India:
# SMTP_HOST=smtppro.zoho.in, SMTP_PORT=465, SMTP_SECURE=true, SMTP_USER=the sender address,
# SMTP_PASS=its app password. Never commit a real password.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# The sender of every email; required with SMTP_URL (with SMTP_HOST it defaults to SMTP_USER).
EMAIL_FROM=
SMTP_TIMEOUT_SECONDS=20
# Encrypts the API keys and passwords organisations enter in Settings → Integrations (at least 32
# characters). Optional: when empty, a key derived from JWT_SECRET is used.
INTEGRATIONS_ENCRYPTION_KEY=
# Key rotation: keys used before, comma-separated (an old JWT-derived key is written jwt:<old JWT_SECRET>).
# Secrets under them still open until Platform admin → Encryption keys re-encrypts them.
INTEGRATIONS_PREVIOUS_ENCRYPTION_KEYS=
# The web app's address, for links in emails to members and the single sign-on redirect URI
# (<APP_URL>/api/session/sso/callback).
APP_URL=http://localhost:3000
# Single sign-on: allow http:// and private-network identity providers (development only), and the
# DNS servers used to check sign-in domains' TXT records (empty = the system's).
SSO_ALLOW_PRIVATE_NETWORKS=
SSO_DNS_SERVERS=
# Security monitoring: how often the audit trail is checked for alerts (seconds; 0 = off), and how many
# locked sign-ins within an hour raise an alert. New alerts are emailed to platform super admins.
SECURITY_MONITOR_INTERVAL_SECONDS=300
SECURITY_LOCKOUT_ALERT_COUNT=5
# Malware scanning of uploads: ClamAV's daemon as tcp://host:3310 (empty = structural checks only).
CLAMAV_URL=
CLAMAV_TIMEOUT_SECONDS=15
# Regional deployment: the region this deployment serves (organisations are tagged with it), its
# name, and the other regions as JSON {"eu-frankfurt":{"name":"European Union (Frankfurt)","appUrl":"https://eu.example.com"}}.
DEPLOYMENT_REGION=local
DEPLOYMENT_REGION_NAME=Local server
REGION_DIRECTORY=

# Backups (SEC-021/022): the backup command (node dist/db/backup.js) encrypts with this passphrase
# (16+ characters; keep it apart from the backups). Overdue limits for Platform admin -> Backups.
# BACKUP_ENCRYPTION_KEY=
# BACKUP_MAX_AGE_HOURS=26
# RESTORE_DRILL_MAX_AGE_DAYS=35
