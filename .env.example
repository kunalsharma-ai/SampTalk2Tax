# Copy to .env and adjust. Never commit real secrets.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://talk2tax:talk2tax@localhost:5432/talk2tax?schema=public
# Integration tests use a separate database (name must contain "test"). They never reset it; each test creates its own organisations.
TEST_DATABASE_URL=postgresql://talk2tax:talk2tax@localhost:5432/talk2tax_test?schema=public
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-secret-of-at-least-32-chars
# Access tokens are short-lived; sessions are renewed with a rotating refresh token.
JWT_TTL_SECONDS=900
SESSION_TTL_DAYS=30
SESSION_IDLE_DAYS=7
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_API_PER_MINUTE=600
# Proxy hops to trust for the client IP (the web app's proxy counts as one).
TRUST_PROXY_HOPS=1
CORS_ORIGINS=http://localhost:3000
# Web app (apps/web): where its server-side proxy reaches the API.
T2T_API_URL=http://localhost:4000
# Web app: X-Forwarded-For entries to count from the right for the browser address (1 = the reverse proxy in front of it).
T2T_CLIENT_IP_HOPS=1
# AI copilot (Anthropic Claude API). Leave the key empty and the copilot says it is not set up;
# nothing is sent anywhere. An owner or admin must also turn the copilot on for each organisation.
ANTHROPIC_API_KEY=
COPILOT_MODEL=claude-opus-5-5
COPILOT_MAX_TOOL_ROUNDS=8
COPILOT_TURN_TIMEOUT_SECONDS=240
