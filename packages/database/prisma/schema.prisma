// Talk2Tax authoritative transactional schema.
// Financial invariants are enforced twice: in the accounting engine and in
// PostgreSQL itself (see the hand-written SQL appended to the first migration).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  ACCOUNTANT
  APPROVER
  VIEWER
  /// Submits and tracks their own expense claims; sees nothing else.
  EMPLOYEE
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum PeriodStatus {
  OPEN
  LOCKED
  CLOSED
}

enum JournalStatus {
  DRAFT
  POSTED
}

enum JournalSource {
  MANUAL
  DOCUMENT
  PAYMENT
  BANK
  EXPENSE
}

enum StatementLineStatus {
  UNMATCHED
  MATCHED
  EXCLUDED
}

enum BankMatchOrigin {
  EXISTING
  CREATED_ENTRY
  CREATED_PAYMENT
}

enum AttachmentEntity {
  DOCUMENT
  PAYMENT
  JOURNAL_ENTRY
  BANK_STATEMENT_LINE
  EXPENSE_CLAIM
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ReconciliationStatus {
  COMPLETED
  UNDONE
}

enum DocumentKind {
  INVOICE
  CREDIT_NOTE
  BILL
  VENDOR_CREDIT
}

enum DocumentStatus {
  DRAFT
  POSTED
  VOID
}

enum PaymentKind {
  RECEIPT
  PAYMENT
}

enum PaymentStatus {
  POSTED
  VOID
}

enum JournalType {
  STANDARD
  ADJUSTING
  REVERSING
  OPENING
  CLOSING
  RECURRING
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique
  name         String
  passwordHash String        @map("password_hash")
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships  Membership[]
  sessions     AuthSession[]

  @@map("users")
}

/// A signed-in device. The access token (JWT) names the session, so revoking the
/// session ends access at once. The refresh token is `<session id>.<secret>`; only a
/// SHA-256 of the secret is stored, and it changes on every refresh.
model AuthSession {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretHash         String    @map("secret_hash")
  /// The secret before the last rotation, accepted for a short grace window so that
  /// two refreshes racing each other do not look like token theft.
  previousSecretHash String?   @map("previous_secret_hash")
  rotatedAt          DateTime? @map("rotated_at") @db.Timestamptz(6)
  rotationCount      Int       @default(0) @map("rotation_count")
  userAgent          String?   @map("user_agent")
  ipAddress          String?   @map("ip_address")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt         DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  /// Hard limit: the session ends here however active it is.
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason      String?   @map("revoked_reason")

  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

/// Failed sign-in counter per email address, whether or not an account exists, so
/// lockout answers the same way for real and unknown addresses.
model LoginThrottle {
  email          String    @id
  failures       Int       @default(0)
  firstFailureAt DateTime  @map("first_failure_at") @db.Timestamptz(6)
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("login_throttles")
}

model Organization {
  id                   String                @id @default(uuid()) @db.Uuid
  name                 String
  legalName            String?               @map("legal_name")
  countryCode          String                @map("country_code") @db.Char(2)
  functionalCurrency   String                @map("functional_currency") @db.Char(3)
  fiscalYearStartMonth Int                   @map("fiscal_year_start_month") @db.SmallInt
  isDemo               Boolean               @default(false) @map("is_demo")
  /// Receivables / payables control accounts. Manual journals cannot post to them (DB trigger).
  arAccountId          String?               @map("ar_account_id") @db.Uuid
  apAccountId          String?               @map("ap_account_id") @db.Uuid
  /// Employee reimbursements payable. Only expense claims post to it (DB trigger).
  claimsAccountId      String?               @map("claims_account_id") @db.Uuid
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships          Membership[]
  accounts             Account[]
  periods              FiscalPeriod[]
  journalEntries       JournalEntry[]
  counters             OrgCounter[]
  auditEvents          AuditEvent[]
  contacts             Contact[]
  taxRates             TaxRate[]
  documents            Document[]
  payments             Payment[]
  statementImports     BankStatementImport[]
  statementLines       BankStatementLine[]
  bankMatches          BankMatch[]
  reconciliations      BankReconciliation[]
  attachments          Attachment[]
  approvalPolicies     ApprovalPolicy[]
  approvalRequests     ApprovalRequest[]
  expenseClaims        ExpenseClaim[]
  invitations          Invitation[]
  gstRegistration      GstRegistration?

  @@map("organizations")
}

model Membership {
  id        String       @id @default(uuid()) @db.Uuid
  orgId     String       @map("org_id") @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  role      Role
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
  @@map("memberships")
}

/// An invitation to join an organisation with a role. The link carries a random token;
/// only its SHA-256 is stored. Only the invited email can accept it, once, before it expires.
model Invitation {
  id           String       @id @default(uuid()) @db.Uuid
  orgId        String       @map("org_id") @db.Uuid
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// Lower-case.
  email        String
  role         Role
  tokenHash    String       @unique @map("token_hash")
  invitedById  String       @map("invited_by_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt    DateTime     @map("expires_at") @db.Timestamptz(6)
  acceptedAt   DateTime?    @map("accepted_at") @db.Timestamptz(6)
  acceptedById String?      @map("accepted_by_id") @db.Uuid
  revokedAt    DateTime?    @map("revoked_at") @db.Timestamptz(6)
  revokedById  String?      @map("revoked_by_id") @db.Uuid

  @@index([orgId, createdAt])
  @@map("invitations")
}

model Account {
  id               String                @id @default(uuid()) @db.Uuid
  orgId            String                @map("org_id") @db.Uuid
  code             String
  name             String
  type             AccountType
  subtype          String?
  description      String?
  parentId         String?               @map("parent_id") @db.Uuid
  isPostable       Boolean               @default(true) @map("is_postable")
  isActive         Boolean               @default(true) @map("is_active")
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  org              Organization          @relation(fields: [orgId], references: [id], onDelete: Restrict)
  parent           Account?              @relation("AccountHierarchy", fields: [parentId, orgId], references: [id, orgId], onDelete: Restrict)
  children         Account[]             @relation("AccountHierarchy")
  lines            JournalLine[]
  documentLines    DocumentLine[]
  expenseLines     ExpenseClaimLine[]
  paymentsViaBank  Payment[]
  statementImports BankStatementImport[]
  statementLines   BankStatementLine[]
  reconciliations  BankReconciliation[]

  @@unique([orgId, code])
  @@unique([id, orgId])
  @@index([orgId, type])
  @@map("accounts")
}

model FiscalPeriod {
  id         String         @id @default(uuid()) @db.Uuid
  orgId      String         @map("org_id") @db.Uuid
  fiscalYear Int            @map("fiscal_year")
  periodNo   Int            @map("period_no") @db.SmallInt
  name       String
  startDate  DateTime       @map("start_date") @db.Date
  endDate    DateTime       @map("end_date") @db.Date
  status     PeriodStatus   @default(OPEN)
  lockedAt   DateTime?      @map("locked_at") @db.Timestamptz(6)
  lockedById String?        @map("locked_by_id") @db.Uuid
  org        Organization   @relation(fields: [orgId], references: [id], onDelete: Restrict)
  entries    JournalEntry[]

  @@unique([orgId, fiscalYear, periodNo])
  @@unique([id, orgId])
  @@index([orgId, startDate])
  @@map("fiscal_periods")
}

model JournalEntry {
  id                 String        @id @default(uuid()) @db.Uuid
  orgId              String        @map("org_id") @db.Uuid
  entryNumber        Int?          @map("entry_number")
  date               DateTime      @db.Date
  periodId           String        @map("period_id") @db.Uuid
  type               JournalType   @default(STANDARD)
  source             JournalSource @default(MANUAL)
  status             JournalStatus @default(DRAFT)
  memo               String?
  reference          String?
  functionalCurrency String        @map("functional_currency") @db.Char(3)
  totalDebit         Decimal       @default(0) @map("total_debit") @db.Decimal(24, 6)
  totalCredit        Decimal       @default(0) @map("total_credit") @db.Decimal(24, 6)
  idempotencyKey     String?       @map("idempotency_key")
  idempotencyHash    String?       @map("idempotency_hash")
  reversesEntryId    String?       @unique @map("reverses_entry_id") @db.Uuid
  createdById        String        @map("created_by_id") @db.Uuid
  postedById         String?       @map("posted_by_id") @db.Uuid
  postedAt           DateTime?     @map("posted_at") @db.Timestamptz(6)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  org                Organization  @relation(fields: [orgId], references: [id], onDelete: Restrict)
  period             FiscalPeriod  @relation(fields: [periodId, orgId], references: [id, orgId], onDelete: Restrict)
  reverses           JournalEntry? @relation("Reversal", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversedBy         JournalEntry? @relation("Reversal")
  lines              JournalLine[]

  @@unique([orgId, entryNumber])
  @@unique([orgId, idempotencyKey])
  @@unique([id, orgId])
  @@index([orgId, date])
  @@index([orgId, status])
  @@map("journal_entries")
}

model JournalLine {
  id               String       @id @default(uuid()) @db.Uuid
  orgId            String       @map("org_id") @db.Uuid
  entryId          String       @map("entry_id") @db.Uuid
  lineNo           Int          @map("line_no")
  accountId        String       @map("account_id") @db.Uuid
  currency         String       @db.Char(3)
  exchangeRate     Decimal      @map("exchange_rate") @db.Decimal(24, 10)
  debit            Decimal      @default(0) @db.Decimal(24, 6)
  credit           Decimal      @default(0) @db.Decimal(24, 6)
  functionalDebit  Decimal      @default(0) @map("functional_debit") @db.Decimal(24, 6)
  functionalCredit Decimal      @default(0) @map("functional_credit") @db.Decimal(24, 6)
  description      String?
  dimensions       Json?
  entry            JournalEntry @relation(fields: [entryId, orgId], references: [id, orgId], onDelete: Restrict)
  account          Account      @relation(fields: [accountId, orgId], references: [id, orgId], onDelete: Restrict)
  bankMatches      BankMatch[]

  @@unique([entryId, lineNo])
  @@unique([id, orgId])
  @@index([orgId, accountId])
  @@map("journal_lines")
}

model OrgCounter {
  orgId String       @map("org_id") @db.Uuid
  key   String
  value Int          @default(0)
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([orgId, key])
  @@map("org_counters")
}

/// Append-only, hash-chained audit trail. UPDATE/DELETE are blocked by trigger.
model AuditEvent {
  id         BigInt        @id @default(autoincrement())
  orgId      String?       @map("org_id") @db.Uuid
  actorId    String?       @map("actor_id") @db.Uuid
  action     String
  entityType String        @map("entity_type")
  entityId   String?       @map("entity_id")
  data       Json?
  prevHash   String?       @map("prev_hash")
  hash       String
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  org        Organization? @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@index([orgId, createdAt])
  @@index([orgId, entityType, entityId])
  @@map("audit_events")
}

/// Customers and vendors. One contact can be both.
model Contact {
  id               String       @id @default(uuid()) @db.Uuid
  orgId            String       @map("org_id") @db.Uuid
  name             String
  email            String?
  phone            String?
  taxId            String?      @map("tax_id")
  /// India GST: the contact's GSTIN (upper case, check character verified). Null = unregistered.
  gstin            String?
  /// India GST state code: from the GSTIN when registered; otherwise where the contact is (default place of supply).
  stateCode        String?      @map("state_code") @db.Char(2)
  address          String?
  isCustomer       Boolean      @default(false) @map("is_customer")
  isVendor         Boolean      @default(false) @map("is_vendor")
  paymentTermsDays Int          @default(30) @map("payment_terms_days")
  creditLimit      Decimal?     @map("credit_limit") @db.Decimal(24, 6)
  isActive         Boolean      @default(true) @map("is_active")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  org              Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  documents        Document[]
  payments         Payment[]

  @@unique([id, orgId])
  @@index([orgId, name])
  @@map("contacts")
}

enum TaxRateKind {
  /// A plain percentage posted to one account per ledger.
  SIMPLE
  /// India GST: split into CGST + SGST/UTGST or IGST by place of supply, posted to the GST registration's accounts.
  GST
}

/// How a GST rate treats the supply (GSTR-1 table 8, GSTR-3B 3.1 and 5).
enum GstCategory {
  TAXABLE
  NIL_RATED
  EXEMPT
  NON_GST
}

enum SupplyNature {
  INTRA
  INTER
}

/// A tenant-configured tax rate. SIMPLE rates are a calculation aid; GST rates follow India GST rules (packages/tax-engine).
model TaxRate {
  id                String         @id @default(uuid()) @db.Uuid
  orgId             String         @map("org_id") @db.Uuid
  name              String
  rate              Decimal        @db.Decimal(9, 6)
  kind              TaxRateKind    @default(SIMPLE)
  gstCategory       GstCategory?   @map("gst_category")
  salesAccountId    String?        @map("sales_account_id") @db.Uuid
  purchaseAccountId String?        @map("purchase_account_id") @db.Uuid
  isActive          Boolean        @default(true) @map("is_active")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  org               Organization   @relation(fields: [orgId], references: [id], onDelete: Restrict)
  lines             DocumentLine[]

  expenseLines ExpenseClaimLine[]

  @@unique([orgId, name])
  @@unique([id, orgId])
  @@map("tax_rates")
}

/// Invoices, customer credit notes, bills and vendor credits.
model Document {
  id                 String            @id @default(uuid()) @db.Uuid
  orgId              String            @map("org_id") @db.Uuid
  kind               DocumentKind
  status             DocumentStatus    @default(DRAFT)
  number             String?
  contactId          String            @map("contact_id") @db.Uuid
  issueDate          DateTime          @map("issue_date") @db.Date
  dueDate            DateTime          @map("due_date") @db.Date
  reference          String?
  memo               String?
  currency           String            @db.Char(3)
  /// India GST, set on documents that use GST rates: place of supply (state code, 96 = outside India).
  placeOfSupply      String?           @map("place_of_supply") @db.Char(2)
  /// India GST: the supplier's state (the organisation's on sales, the vendor's on purchases).
  supplierState      String?           @map("supplier_state") @db.Char(2)
  supplyNature       SupplyNature?     @map("supply_nature")
  /// India GST: the contact's GSTIN when the document was saved. Null = unregistered.
  counterpartyGstin  String?           @map("counterparty_gstin")
  subtotal           Decimal           @db.Decimal(24, 6)
  taxTotal           Decimal           @map("tax_total") @db.Decimal(24, 6)
  total              Decimal           @db.Decimal(24, 6)
  journalEntryId     String?           @unique @map("journal_entry_id") @db.Uuid
  voidJournalEntryId String?           @unique @map("void_journal_entry_id") @db.Uuid
  voidDate           DateTime?         @map("void_date") @db.Date
  voidReason         String?           @map("void_reason")
  createdById        String            @map("created_by_id") @db.Uuid
  postedById         String?           @map("posted_by_id") @db.Uuid
  postedAt           DateTime?         @map("posted_at") @db.Timestamptz(6)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  org                Organization      @relation(fields: [orgId], references: [id], onDelete: Restrict)
  contact            Contact           @relation(fields: [contactId, orgId], references: [id, orgId], onDelete: Restrict)
  lines              DocumentLine[]
  allocationsIn      Allocation[]      @relation("AllocationTarget")
  allocationsOut     Allocation[]      @relation("AllocationCreditSource")
  approvalRequests   ApprovalRequest[]

  @@unique([orgId, kind, number])
  @@unique([id, orgId])
  @@index([orgId, kind, status])
  @@index([orgId, contactId])
  @@map("documents")
}

model DocumentLine {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  documentId  String   @map("document_id") @db.Uuid
  lineNo      Int      @map("line_no")
  description String?
  accountId   String   @map("account_id") @db.Uuid
  quantity    Decimal  @db.Decimal(24, 6)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(24, 6)
  taxRateId   String?  @map("tax_rate_id") @db.Uuid
  taxRate     Decimal  @default(0) @map("tax_rate") @db.Decimal(9, 6)
  netAmount   Decimal  @map("net_amount") @db.Decimal(24, 6)
  taxAmount   Decimal  @map("tax_amount") @db.Decimal(24, 6)
  /// India GST: HSN (goods) or SAC (services) code, and the tax by head. Their sum equals taxAmount on GST lines.
  hsnCode     String?  @map("hsn_code")
  cgstAmount  Decimal  @default(0) @map("cgst_amount") @db.Decimal(24, 6)
  sgstAmount  Decimal  @default(0) @map("sgst_amount") @db.Decimal(24, 6)
  igstAmount  Decimal  @default(0) @map("igst_amount") @db.Decimal(24, 6)
  document    Document @relation(fields: [documentId, orgId], references: [id, orgId], onDelete: Cascade)
  account     Account  @relation(fields: [accountId, orgId], references: [id, orgId], onDelete: Restrict)
  tax         TaxRate? @relation(fields: [taxRateId, orgId], references: [id, orgId], onDelete: Restrict)

  @@unique([documentId, lineNo])
  @@map("document_lines")
}

/// Money received from a customer (RECEIPT) or paid to a vendor (PAYMENT).
model Payment {
  id                 String        @id @default(uuid()) @db.Uuid
  orgId              String        @map("org_id") @db.Uuid
  kind               PaymentKind
  status             PaymentStatus @default(POSTED)
  number             String
  contactId          String        @map("contact_id") @db.Uuid
  date               DateTime      @db.Date
  bankAccountId      String        @map("bank_account_id") @db.Uuid
  currency           String        @db.Char(3)
  amount             Decimal       @db.Decimal(24, 6)
  reference          String?
  memo               String?
  journalEntryId     String        @unique @map("journal_entry_id") @db.Uuid
  voidJournalEntryId String?       @unique @map("void_journal_entry_id") @db.Uuid
  voidDate           DateTime?     @map("void_date") @db.Date
  idempotencyKey     String?       @map("idempotency_key")
  idempotencyHash    String?       @map("idempotency_hash")
  createdById        String        @map("created_by_id") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  org                Organization  @relation(fields: [orgId], references: [id], onDelete: Restrict)
  contact            Contact       @relation(fields: [contactId, orgId], references: [id, orgId], onDelete: Restrict)
  bankAccount        Account       @relation(fields: [bankAccountId, orgId], references: [id, orgId], onDelete: Restrict)
  allocations        Allocation[]

  @@unique([orgId, kind, number])
  @@unique([orgId, idempotencyKey])
  @@unique([id, orgId])
  @@index([orgId, contactId])
  @@map("payments")
}

/// Applies a payment or a credit document against an invoice or bill.
/// Rows are never deleted; removing an allocation stamps removed_on.
model Allocation {
  id               String    @id @default(uuid()) @db.Uuid
  orgId            String    @map("org_id") @db.Uuid
  targetId         String    @map("target_id") @db.Uuid
  paymentId        String?   @map("payment_id") @db.Uuid
  creditDocumentId String?   @map("credit_document_id") @db.Uuid
  amount           Decimal   @db.Decimal(24, 6)
  date             DateTime  @db.Date
  createdById      String    @map("created_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  removedOn        DateTime? @map("removed_on") @db.Date
  removedById      String?   @map("removed_by_id") @db.Uuid
  target           Document  @relation("AllocationTarget", fields: [targetId, orgId], references: [id, orgId], onDelete: Restrict)
  payment          Payment?  @relation(fields: [paymentId, orgId], references: [id, orgId], onDelete: Restrict)
  creditDocument   Document? @relation("AllocationCreditSource", fields: [creditDocumentId, orgId], references: [id, orgId], onDelete: Restrict)

  @@index([orgId, targetId])
  @@index([orgId, paymentId])
  @@index([orgId, creditDocumentId])
  @@map("allocations")
}

/// One uploaded bank statement file. Lines already imported (same fingerprint) are skipped.
model BankStatementImport {
  id           String              @id @default(uuid()) @db.Uuid
  orgId        String              @map("org_id") @db.Uuid
  accountId    String              @map("account_id") @db.Uuid
  fileName     String              @map("file_name")
  fileHash     String              @map("file_hash")
  lineCount    Int                 @map("line_count")
  skippedCount Int                 @map("skipped_count")
  firstDate    DateTime            @map("first_date") @db.Date
  lastDate     DateTime            @map("last_date") @db.Date
  importedById String              @map("imported_by_id") @db.Uuid
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  org          Organization        @relation(fields: [orgId], references: [id], onDelete: Restrict)
  account      Account             @relation(fields: [accountId, orgId], references: [id, orgId], onDelete: Restrict)
  lines        BankStatementLine[]

  @@unique([id, orgId])
  @@index([orgId, accountId])
  @@map("bank_statement_imports")
}

/// Money that moved in the bank: positive = in, negative = out. Never deleted.
model BankStatementLine {
  id               String              @id @default(uuid()) @db.Uuid
  orgId            String              @map("org_id") @db.Uuid
  accountId        String              @map("account_id") @db.Uuid
  importId         String              @map("import_id") @db.Uuid
  date             DateTime            @db.Date
  description      String
  reference        String?
  amount           Decimal             @db.Decimal(24, 6)
  fingerprint      String
  status           StatementLineStatus @default(UNMATCHED)
  excludedReason   String?             @map("excluded_reason")
  reconciliationId String?             @map("reconciliation_id") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  org              Organization        @relation(fields: [orgId], references: [id], onDelete: Restrict)
  account          Account             @relation(fields: [accountId, orgId], references: [id, orgId], onDelete: Restrict)
  import           BankStatementImport @relation(fields: [importId, orgId], references: [id, orgId], onDelete: Restrict)
  reconciliation   BankReconciliation? @relation(fields: [reconciliationId, orgId], references: [id, orgId], onDelete: Restrict)
  matches          BankMatch[]

  @@unique([orgId, accountId, fingerprint])
  @@unique([id, orgId])
  @@index([orgId, accountId, date])
  @@index([orgId, accountId, status])
  @@map("bank_statement_lines")
}

/// Links a statement line to a posted journal line on the same bank account.
/// Never deleted; unmatching stamps removed_at.
model BankMatch {
  id              String            @id @default(uuid()) @db.Uuid
  orgId           String            @map("org_id") @db.Uuid
  statementLineId String            @map("statement_line_id") @db.Uuid
  journalLineId   String            @map("journal_line_id") @db.Uuid
  origin          BankMatchOrigin   @default(EXISTING)
  createdById     String            @map("created_by_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  removedAt       DateTime?         @map("removed_at") @db.Timestamptz(6)
  removedById     String?           @map("removed_by_id") @db.Uuid
  org             Organization      @relation(fields: [orgId], references: [id], onDelete: Restrict)
  statementLine   BankStatementLine @relation(fields: [statementLineId, orgId], references: [id, orgId], onDelete: Restrict)
  journalLine     JournalLine       @relation(fields: [journalLineId, orgId], references: [id, orgId], onDelete: Restrict)

  @@index([orgId, statementLineId])
  @@index([orgId, journalLineId])
  @@map("bank_matches")
}

model BankReconciliation {
  id               String               @id @default(uuid()) @db.Uuid
  orgId            String               @map("org_id") @db.Uuid
  accountId        String               @map("account_id") @db.Uuid
  startDate        DateTime             @map("start_date") @db.Date
  statementDate    DateTime             @map("statement_date") @db.Date
  openingBalance   Decimal              @map("opening_balance") @db.Decimal(24, 6)
  statementBalance Decimal              @map("statement_balance") @db.Decimal(24, 6)
  ledgerBalance    Decimal              @map("ledger_balance") @db.Decimal(24, 6)
  uncleared        Decimal              @db.Decimal(24, 6)
  status           ReconciliationStatus @default(COMPLETED)
  completedById    String               @map("completed_by_id") @db.Uuid
  completedAt      DateTime             @default(now()) @map("completed_at") @db.Timestamptz(6)
  undoneById       String?              @map("undone_by_id") @db.Uuid
  undoneAt         DateTime?            @map("undone_at") @db.Timestamptz(6)
  undoReason       String?              @map("undo_reason")
  org              Organization         @relation(fields: [orgId], references: [id], onDelete: Restrict)
  account          Account              @relation(fields: [accountId, orgId], references: [id, orgId], onDelete: Restrict)
  lines            BankStatementLine[]

  @@unique([id, orgId])
  @@index([orgId, accountId, statementDate])
  @@map("bank_reconciliations")
}

/// A file kept as evidence for a record (receipt, supplier invoice, contract).
/// Bytes never change; removal is a soft delete with a reason.
model Attachment {
  id            String           @id @default(uuid()) @db.Uuid
  orgId         String           @map("org_id") @db.Uuid
  entityType    AttachmentEntity @map("entity_type")
  entityId      String           @map("entity_id") @db.Uuid
  fileName      String           @map("file_name")
  contentType   String           @map("content_type")
  sizeBytes     Int              @map("size_bytes")
  sha256        String
  content       Bytes
  uploadedById  String           @map("uploaded_by_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  removedAt     DateTime?        @map("removed_at") @db.Timestamptz(6)
  removedById   String?          @map("removed_by_id") @db.Uuid
  removedReason String?          @map("removed_reason")
  org           Organization     @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@unique([id, orgId])
  @@index([orgId, entityType, entityId])
  @@map("attachments")
}

/// Documents of this kind at or above min_amount must be approved before they post.
model ApprovalPolicy {
  id                       String       @id @default(uuid()) @db.Uuid
  orgId                    String       @map("org_id") @db.Uuid
  documentKind             DocumentKind @map("document_kind")
  minAmount                Decimal      @map("min_amount") @db.Decimal(24, 6)
  requireDifferentApprover Boolean      @default(true) @map("require_different_approver")
  isActive                 Boolean      @default(true) @map("is_active")
  updatedById              String       @map("updated_by_id") @db.Uuid
  createdAt                DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  org                      Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@unique([orgId, documentKind])
  @@map("approval_policies")
}

/// One request to approve a draft document. Never deleted. Editing the draft cancels it (trigger).
model ApprovalRequest {
  id            String         @id @default(uuid()) @db.Uuid
  orgId         String         @map("org_id") @db.Uuid
  documentId    String?        @map("document_id") @db.Uuid
  documentKind  DocumentKind   @map("document_kind")
  contactName   String         @map("contact_name")
  total         Decimal        @db.Decimal(24, 6)
  status        ApprovalStatus @default(PENDING)
  note          String?
  requestedById String         @map("requested_by_id") @db.Uuid
  requestedAt   DateTime       @default(now()) @map("requested_at") @db.Timestamptz(6)
  decidedById   String?        @map("decided_by_id") @db.Uuid
  decidedAt     DateTime?      @map("decided_at") @db.Timestamptz(6)
  decisionNote  String?        @map("decision_note")
  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Restrict)
  document      Document?      @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@unique([id, orgId])
  @@index([orgId, status])
  @@index([documentId])
  @@map("approval_requests")
}

enum ExpenseClaimStatus {
  DRAFT
  SUBMITTED
  REJECTED
  APPROVED
  REIMBURSED
  VOID
}

/// An employee's request to be paid back for money they spent. Approving posts it; reimbursing pays it.
model ExpenseClaim {
  id                          String             @id @default(uuid()) @db.Uuid
  orgId                       String             @map("org_id") @db.Uuid
  number                      String
  claimantId                  String             @map("claimant_id") @db.Uuid
  title                       String
  currency                    String             @db.Char(3)
  status                      ExpenseClaimStatus @default(DRAFT)
  netTotal                    Decimal            @map("net_total") @db.Decimal(24, 6)
  taxTotal                    Decimal            @map("tax_total") @db.Decimal(24, 6)
  total                       Decimal            @db.Decimal(24, 6)
  submittedAt                 DateTime?          @map("submitted_at") @db.Timestamptz(6)
  decidedById                 String?            @map("decided_by_id") @db.Uuid
  decidedAt                   DateTime?          @map("decided_at") @db.Timestamptz(6)
  decisionNote                String?            @map("decision_note")
  journalEntryId              String?            @unique @map("journal_entry_id") @db.Uuid
  postingDate                 DateTime?          @map("posting_date") @db.Date
  reimbursementJournalEntryId String?            @unique @map("reimbursement_journal_entry_id") @db.Uuid
  reimbursedOn                DateTime?          @map("reimbursed_on") @db.Date
  reimbursedById              String?            @map("reimbursed_by_id") @db.Uuid
  bankAccountId               String?            @map("bank_account_id") @db.Uuid
  reimbursementReference      String?            @map("reimbursement_reference")
  voidJournalEntryId          String?            @unique @map("void_journal_entry_id") @db.Uuid
  voidDate                    DateTime?          @map("void_date") @db.Date
  voidReason                  String?            @map("void_reason")
  createdAt                   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  org                         Organization       @relation(fields: [orgId], references: [id], onDelete: Restrict)
  lines                       ExpenseClaimLine[]

  @@unique([id, orgId])
  @@unique([orgId, number])
  @@index([orgId, status])
  @@index([orgId, claimantId])
  @@map("expense_claims")
}

model ExpenseClaimLine {
  id          String       @id @default(uuid()) @db.Uuid
  orgId       String       @map("org_id") @db.Uuid
  claimId     String       @map("claim_id") @db.Uuid
  lineNo      Int          @map("line_no")
  date        DateTime     @db.Date
  accountId   String       @map("account_id") @db.Uuid
  merchant    String?
  description String?
  amount      Decimal      @db.Decimal(24, 6)
  taxRateId   String?      @map("tax_rate_id") @db.Uuid
  taxRate     Decimal      @default(0) @map("tax_rate") @db.Decimal(9, 6)
  netAmount   Decimal      @map("net_amount") @db.Decimal(24, 6)
  taxAmount   Decimal      @map("tax_amount") @db.Decimal(24, 6)
  claim       ExpenseClaim @relation(fields: [claimId, orgId], references: [id, orgId], onDelete: Cascade)
  account     Account      @relation(fields: [accountId, orgId], references: [id, orgId], onDelete: Restrict)
  tax         TaxRate?     @relation(fields: [taxRateId, orgId], references: [id, orgId], onDelete: Restrict)

  @@unique([claimId, lineNo])
  @@map("expense_claim_lines")
}

/// India GST registration of an organisation (one per organisation for now) and the
/// accounts its tax posts to. Account foreign keys are enforced in SQL.
model GstRegistration {
  orgId               String       @id @map("org_id") @db.Uuid
  gstin               String
  legalName           String?      @map("legal_name")
  /// First two characters of the GSTIN.
  stateCode           String       @map("state_code") @db.Char(2)
  /// GST rates may be used on documents dated on or after this date.
  effectiveFrom       DateTime     @map("effective_from") @db.Date
  outputCgstAccountId String       @map("output_cgst_account_id") @db.Uuid
  outputSgstAccountId String       @map("output_sgst_account_id") @db.Uuid
  outputIgstAccountId String       @map("output_igst_account_id") @db.Uuid
  inputCgstAccountId  String       @map("input_cgst_account_id") @db.Uuid
  inputSgstAccountId  String       @map("input_sgst_account_id") @db.Uuid
  inputIgstAccountId  String       @map("input_igst_account_id") @db.Uuid
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  org                 Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@map("gst_registrations")
}
