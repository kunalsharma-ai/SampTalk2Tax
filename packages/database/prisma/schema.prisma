/// Append-only history of a contract (actor null: the billing runner).
model SalesContractEvent {
  id         String        @id @default(uuid()) @db.Uuid
  orgId      String        @map("org_id") @db.Uuid
  contractId String        @map("contract_id") @db.Uuid
  kind       String        @db.VarChar(40)
  body       String        @db.VarChar(1000)
  data       Json?
  actorId    String?       @map("actor_id") @db.Uuid
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  contract   SalesContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, createdAt])
  @@map("sales_contract_events")
}

/// A revenue forecast as it stood on a day (RF-0001), kept to compare with what was invoiced. Never changes.
model RevenueForecast {
  id             String       @id @default(uuid()) @db.Uuid
  orgId          String       @map("org_id") @db.Uuid
  number         Int
  asOf           DateTime     @map("as_of") @db.Date
  months         Int
  currency       String       @db.Char(3)
  actualSoFar    Decimal      @map("actual_so_far") @db.Decimal(24, 6)
  committedTotal Decimal      @map("committed_total") @db.Decimal(24, 6)
  expectedTotal  Decimal      @map("expected_total") @db.Decimal(24, 6)
  bestTotal      Decimal      @map("best_total") @db.Decimal(24, 6)
  /// { months: ForecastMonth[], items: ForecastItem[] } as worked out that day.
  data           Json
  note           String?      @db.VarChar(500)
  createdById    String       @map("created_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@unique([orgId, number])
  @@unique([id, orgId])
  @@index([orgId, asOf])
  @@map("revenue_forecasts")
}

/// A key another system uses to call the CRM API (/v1/crm-api) for one organisation. Only a
/// SHA-256 of the key is kept; the key is shown once. It acts with its creator's role, limited to
/// its scopes, and stops working when revoked or when its creator leaves. Never deleted.
model ApiKey {
  id          String       @id @default(uuid()) @db.Uuid
  orgId       String       @map("org_id") @db.Uuid
  name        String       @db.VarChar(100)
  /// The visible start of the key (t2t_<prefix>_…), used to find it and shown in lists.
  prefix      String       @unique @db.VarChar(16)
  keyHash     String       @unique @map("key_hash") @db.Char(64)
  /// crm.read and/or crm.write.
  scopes      String[]
  createdById String       @map("created_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt   DateTime?    @map("expires_at") @db.Timestamptz(6)
  lastUsedAt  DateTime?    @map("last_used_at") @db.Timestamptz(6)
  revokedAt   DateTime?    @map("revoked_at") @db.Timestamptz(6)
  revokedById String?      @map("revoked_by_id") @db.Uuid
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@unique([id, orgId])
  @@index([orgId])
  @@map("api_keys")
}

/// Sends CRM events to another system. Events are read from the audit trail after last_event_id;
/// each becomes one signed delivery, tried again on failure. The secret is sealed by the API.
model CrmWebhook {
  id           String               @id @default(uuid()) @db.Uuid
  orgId        String               @map("org_id") @db.Uuid
  name         String               @db.VarChar(100)
  url          String               @db.VarChar(500)
  events       String[]
  secretCipher String               @map("secret_cipher")
  secretKeyId  String               @map("secret_key_id") @db.VarChar(16)
  secretHint   String               @map("secret_hint") @db.VarChar(16)
  enabled      Boolean              @default(true)
  lastEventId  BigInt               @map("last_event_id")
  createdById  String               @map("created_by_id") @db.Uuid
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  org          Organization         @relation(fields: [orgId], references: [id], onDelete: Restrict)
  deliveries   CrmWebhookDelivery[]

  @@unique([id, orgId])
  @@index([orgId])
  @@map("crm_webhooks")
}

/// One event sent (or being sent) to a CRM webhook. The same body is sent on every attempt.
model CrmWebhookDelivery {
  id              String       @id @default(uuid()) @db.Uuid
  orgId           String       @map("org_id") @db.Uuid
  webhookId       String       @map("webhook_id") @db.Uuid
  /// The audit event it came from; null for a test delivery.
  eventId         BigInt?      @map("event_id")
  event           String       @db.VarChar(40)
  body            String
  /// PENDING, SUCCEEDED or FAILED.
  status          String       @default("PENDING") @db.VarChar(10)
  attempts        Int          @default(0)
  nextAttemptAt   DateTime?    @map("next_attempt_at") @db.Timestamptz(6)
  lastStatusCode  Int?         @map("last_status_code")
  lastError       String?      @map("last_error") @db.VarChar(300)
  responseSnippet String?      @map("response_snippet") @db.VarChar(500)
  durationMs      Int?         @map("duration_ms")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  finishedAt      DateTime?    @map("finished_at") @db.Timestamptz(6)
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  webhook         CrmWebhook   @relation(fields: [webhookId, orgId], references: [id, orgId], onDelete: Cascade)

  @@unique([webhookId, eventId])
  @@index([orgId, webhookId, createdAt])
  @@map("crm_webhook_deliveries")
}

enum JournalTemplateStatus {
  ACTIVE
  ARCHIVED
}

enum RecurringPostMode {
  DRAFT
  POST
}

enum RecurringScheduleStatus {
  ACTIVE
  PAUSED
  ENDED
}

/// A journal entered again and again (GL-012), optionally posting itself on a schedule (GL-007).
model JournalTemplate {
  id             String                   @id @default(uuid()) @db.Uuid
  orgId          String                   @map("org_id") @db.Uuid
  number         Int
  name           String                   @db.VarChar(120)
  description    String?                  @db.VarChar(500)
  /// STANDARD or ADJUSTING. Scheduled runs are posted as RECURRING journals.
  journalType    String                   @default("STANDARD") @map("journal_type") @db.VarChar(20)
  /// May hold placeholders such as {month}.
  memo           String?                  @db.VarChar(1000)
  reference      String?                  @db.VarChar(100)
  status         JournalTemplateStatus    @default(ACTIVE)
  /// Null: no schedule.
  frequency      ContractFrequency?
  startDate      DateTime?                @map("start_date") @db.Date
  endDate        DateTime?                @map("end_date") @db.Date
  monthEnd       Boolean                  @default(false) @map("month_end")
  postMode       RecurringPostMode        @default(DRAFT) @map("post_mode")
  scheduleStatus RecurringScheduleStatus? @map("schedule_status")
  nextRunNo      Int                      @default(1) @map("next_run_no")
  lastError      String?                  @map("last_error") @db.VarChar(1000)
  lastErrorAt    DateTime?                @map("last_error_at") @db.Timestamptz(6)
  createdById    String                   @map("created_by_id") @db.Uuid
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  org            Organization             @relation(fields: [orgId], references: [id], onDelete: Restrict)
  lines          JournalTemplateLine[]
  runs           JournalTemplateRun[]

  @@unique([orgId, number])
  @@unique([id, orgId])
  @@index([orgId, status])
  @@index([scheduleStatus])
  @@map("journal_templates")
}

model JournalTemplateLine {
  id           String          @id @default(uuid()) @db.Uuid
  orgId        String          @map("org_id") @db.Uuid
  templateId   String          @map("template_id") @db.Uuid
  lineNo       Int             @map("line_no")
  accountId    String          @map("account_id") @db.Uuid
  debit        Decimal         @default(0) @db.Decimal(24, 6)
  credit       Decimal         @default(0) @db.Decimal(24, 6)
  /// Null: the functional currency.
  currency     String?         @db.Char(3)
  description  String?         @db.VarChar(500)
  departmentId String?         @map("department_id") @db.Uuid
  projectId    String?         @map("project_id") @db.Uuid
  template     JournalTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  account      Account         @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([templateId, lineNo])
  @@map("journal_template_lines")
}

/// Append-only: one row per journal a template made (run_no null: posted by hand).
model JournalTemplateRun {
  id             String          @id @default(uuid()) @db.Uuid
  orgId          String          @map("org_id") @db.Uuid
  templateId     String          @map("template_id") @db.Uuid
  runNo          Int?            @map("run_no")
  runDate        DateTime        @map("run_date") @db.Date
  journalEntryId String?         @map("journal_entry_id") @db.Uuid
  entryNumber    Int?            @map("entry_number")
  posted         Boolean
  /// Null: the schedule runner.
  actorId        String?         @map("actor_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  template       JournalTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@unique([templateId, runNo])
  @@index([templateId, createdAt])
  @@index([journalEntryId])
  @@map("journal_template_runs")
}

enum WriteOffStatus {
  ACTIVE
  REVERSED
}

/// The accounts and provision matrix (percent per ageing bucket) for bad debts (AR-026).
model BadDebtSettings {
  orgId              String   @id @map("org_id") @db.Uuid
  expenseAccountId   String   @map("expense_account_id") @db.Uuid
  allowanceAccountId String   @map("allowance_account_id") @db.Uuid
  rates              Json
  updatedById        String   @map("updated_by_id") @db.Uuid
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("bad_debt_settings")
}

/// An invoice provided for at its own percentage (a specific provision).
model DoubtfulInvoice {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  documentId  String   @unique @map("document_id") @db.Uuid
  percent     Decimal  @db.Decimal(7, 4)
  reason      String   @db.VarChar(500)
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([orgId])
  @@map("doubtful_invoices")
}

/// A bad-debt write-off (AR-027): settles what is left on an invoice through an allocation.
model BadDebtWriteOff {
  id                      String         @id @default(uuid()) @db.Uuid
  orgId                   String         @map("org_id") @db.Uuid
  number                  Int
  documentId              String         @map("document_id") @db.Uuid
  contactId               String         @map("contact_id") @db.Uuid
  date                    DateTime       @db.Date
  currency                String         @db.Char(3)
  /// In the invoice currency.
  amount                  Decimal        @db.Decimal(24, 6)
  /// The invoice's rate.
  exchangeRate            Decimal        @map("exchange_rate") @db.Decimal(24, 10)
  functionalAmount        Decimal        @map("functional_amount") @db.Decimal(24, 6)
  /// Debited: the bad-debt expense or the allowance for doubtful debts.
  accountId               String         @map("account_id") @db.Uuid
  reason                  String         @db.VarChar(500)
  status                  WriteOffStatus @default(ACTIVE)
  journalEntryId          String         @unique @map("journal_entry_id") @db.Uuid
  reversedOn              DateTime?      @map("reversed_on") @db.Date
  reversalReason          String?        @map("reversal_reason") @db.VarChar(500)
  reversalJournalEntryId  String?        @unique @map("reversal_journal_entry_id") @db.Uuid
  reversedById            String?        @map("reversed_by_id") @db.Uuid
  createdById             String         @map("created_by_id") @db.Uuid
  createdAt               DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  allocations             Allocation[]

  @@unique([orgId, number])
  @@unique([id, orgId])
  @@index([orgId, documentId])
  @@index([orgId, contactId])
  @@map("bad_debt_write_offs")
}

/// One provision run (append-only): the matrix, the result, and the posting that set the allowance.
model BadDebtProvision {
  id             String   @id @default(uuid()) @db.Uuid
  orgId          String   @map("org_id") @db.Uuid
  number         Int
  asOf           DateTime @map("as_of") @db.Date
  rates          Json
  result         Json
  required       Decimal  @db.Decimal(24, 6)
  carried        Decimal  @db.Decimal(24, 6)
  adjustment     Decimal  @db.Decimal(24, 6)
  journalEntryId String?  @unique @map("journal_entry_id") @db.Uuid
  memo           String?  @db.VarChar(500)
  createdById    String   @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([orgId, number])
  @@map("bad_debt_provisions")
}

enum YearEndCloseStatus {
  ACTIVE
  REVERSED
}

/// A fiscal year's revenue and expense accounts closed to retained earnings by one closing journal (GL-011). Immutable apart from one reversal.
model YearEndClose {
  id                        String             @id @default(uuid()) @db.Uuid
  orgId                     String             @map("org_id") @db.Uuid
  number                    Int
  fiscalYear                Int                @map("fiscal_year")
  closingDate               DateTime           @map("closing_date") @db.Date
  retainedEarningsAccountId String             @map("retained_earnings_account_id") @db.Uuid
  /// The year's profit (revenue less expenses, closing entries left out) when this close was made.
  profit                    Decimal            @db.Decimal(24, 6)
  /// Credited to retained earnings by this close (negative: debited, a loss).
  toRetainedEarnings        Decimal            @map("to_retained_earnings") @db.Decimal(24, 6)
  accounts                  Int
  journalEntryId            String             @unique @map("journal_entry_id") @db.Uuid
  memo                      String?            @db.VarChar(400)
  status                    YearEndCloseStatus @default(ACTIVE)
  reversedOn                DateTime?          @map("reversed_on") @db.Date
  reversalReason            String?            @map("reversal_reason") @db.VarChar(500)
  reversalJournalEntryId    String?            @unique @map("reversal_journal_entry_id") @db.Uuid
  reversedById              String?            @map("reversed_by_id") @db.Uuid
  createdById               String             @map("created_by_id") @db.Uuid
  createdAt                 DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([orgId, number])
  @@unique([id, orgId])
  @@index([orgId, fiscalYear])
  @@map("year_end_closes")
}

enum PaymentBatchStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}

/// A vendor's bank account for payments (AP-027). Any change clears the verification (trigger); verified by someone other than who changed it.
model VendorBankDetails {
  contactId        String    @id @map("contact_id") @db.Uuid
  orgId            String    @map("org_id") @db.Uuid
  accountName      String    @map("account_name") @db.VarChar(140)
  accountNumber    String    @map("account_number") @db.VarChar(34)
  ifsc             String    @db.Char(11)
  bankName         String?   @map("bank_name") @db.VarChar(140)
  changedById      String    @map("changed_by_id") @db.Uuid
  changedAt        DateTime  @default(now()) @map("changed_at") @db.Timestamptz(6)
  verifiedById     String?   @map("verified_by_id") @db.Uuid
  verifiedAt       DateTime? @map("verified_at") @db.Timestamptz(6)
  verificationNote String?   @map("verification_note") @db.VarChar(500)

  @@unique([contactId, orgId])
  @@index([orgId])
  @@map("vendor_bank_details")
}

/// Every change of a vendor's bank details (append-only, account numbers masked).
model VendorBankDetailChange {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  contactId    String   @map("contact_id") @db.Uuid
  beforeMasked String?  @map("before_masked") @db.VarChar(80)
  afterMasked  String   @map("after_masked") @db.VarChar(80)
  changedById  String   @map("changed_by_id") @db.Uuid
  changedAt    DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)

  @@index([orgId, contactId])
  @@map("vendor_bank_detail_changes")
}

/// Bills paid together from one bank account on one date (AP-014): prepared, approved by a second person, sent to the bank, recorded as paid.
model PaymentBatch {
  id               String             @id @default(uuid()) @db.Uuid
  orgId            String             @map("org_id") @db.Uuid
  number           Int
  bankAccountId    String             @map("bank_account_id") @db.Uuid
  paymentDate      DateTime           @map("payment_date") @db.Date
  currency         String             @db.Char(3)
  memo             String?            @db.VarChar(400)
  status           PaymentBatchStatus @default(DRAFT)
  createdById      String             @map("created_by_id") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  approvedById     String?            @map("approved_by_id") @db.Uuid
  approvedAt       DateTime?          @map("approved_at") @db.Timestamptz(6)
  selfApproved     Boolean            @default(false) @map("self_approved")
  fileDownloadedAt DateTime?          @map("file_downloaded_at") @db.Timestamptz(6)
  paidById         String?            @map("paid_by_id") @db.Uuid
  paidAt           DateTime?          @map("paid_at") @db.Timestamptz(6)
  cancelledById    String?            @map("cancelled_by_id") @db.Uuid
  cancelledAt      DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  cancelReason     String?            @map("cancel_reason") @db.VarChar(500)
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  items            PaymentBatchItem[]

  @@unique([orgId, number])
  @@unique([id, orgId])
  @@index([orgId, status])
  @@map("payment_batches")
}

model PaymentBatchItem {
  id         String       @id @default(uuid()) @db.Uuid
  orgId      String       @map("org_id") @db.Uuid
  batchId    String       @map("batch_id") @db.Uuid
  documentId String       @map("document_id") @db.Uuid
  contactId  String       @map("contact_id") @db.Uuid
  amount     Decimal      @db.Decimal(24, 6)
  paymentId  String?      @map("payment_id") @db.Uuid
  open       Boolean      @default(true)
  batch      PaymentBatch @relation(fields: [batchId, orgId], references: [id, orgId], onDelete: Cascade)

  @@unique([batchId, documentId])
  @@index([orgId, batchId])
  @@map("payment_batch_items")
}

/// AP-005 recurring bills: a vendor bill made again on a schedule (RB-0001).
model RecurringBill {
  id                   String                  @id @default(uuid()) @db.Uuid
  orgId                String                  @map("org_id") @db.Uuid
  number               Int
  name                 String                  @db.VarChar(120)
  contactId            String                  @map("contact_id") @db.Uuid
  /// May hold placeholders such as {month}; must change from run to run (duplicate bill check).
  reference            String?                 @db.VarChar(100)
  memo                 String?                 @db.VarChar(1000)
  /// India GST: null takes the registration's state, as a bill entered by hand.
  placeOfSupply        String?                 @map("place_of_supply") @db.Char(2)
  reverseCharge        Boolean                 @default(false) @map("reverse_charge")
  withholdingSectionId String?                 @map("withholding_section_id") @db.Uuid
  /// Days after the bill date the bill is due; null: the vendor's payment terms.
  dueDays              Int?                    @map("due_days")
  frequency            ContractFrequency
  startDate            DateTime                @map("start_date") @db.Date
  endDate              DateTime?               @map("end_date") @db.Date
  monthEnd             Boolean                 @default(false) @map("month_end")
  postMode             RecurringPostMode       @default(DRAFT) @map("post_mode")
  status               RecurringScheduleStatus @default(ACTIVE)
  nextRunNo            Int                     @default(1) @map("next_run_no")
  lastError            String?                 @map("last_error") @db.VarChar(1000)
  lastErrorAt          DateTime?               @map("last_error_at") @db.Timestamptz(6)
  createdById          String                  @map("created_by_id") @db.Uuid
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  org                  Organization            @relation(fields: [orgId], references: [id], onDelete: Restrict)
  contact              Contact                 @relation(fields: [contactId, orgId], references: [id, orgId], onDelete: Restrict, map: "recurring_bills_contact_fk")
  lines                RecurringBillLine[]
  runs                 RecurringBillRun[]

  @@unique([orgId, number])
  @@unique([id, orgId])
  @@index([status])
  @@map("recurring_bills")
}

model RecurringBillLine {
  id              String        @id @default(uuid()) @db.Uuid
  orgId           String        @map("org_id") @db.Uuid
  recurringBillId String        @map("recurring_bill_id") @db.Uuid
  lineNo          Int           @map("line_no")
  accountId       String        @map("account_id") @db.Uuid
  description     String?       @db.VarChar(500)
  quantity        Decimal       @db.Decimal(24, 6)
  unitPrice       Decimal       @map("unit_price") @db.Decimal(24, 6)
  taxRateId       String?       @map("tax_rate_id") @db.Uuid
  hsnCode         String?       @map("hsn_code") @db.VarChar(8)
  departmentId    String?       @map("department_id") @db.Uuid
  projectId       String?       @map("project_id") @db.Uuid
  recurringBill   RecurringBill @relation(fields: [recurringBillId], references: [id], onDelete: Cascade)

  @@unique([recurringBillId, lineNo])
  @@map("recurring_bill_lines")
}

/// Append-only: one row per bill a schedule made.
model RecurringBillRun {
  id              String        @id @default(uuid()) @db.Uuid
  orgId           String        @map("org_id") @db.Uuid
  recurringBillId String        @map("recurring_bill_id") @db.Uuid
  runNo           Int           @map("run_no")
  runDate         DateTime      @map("run_date") @db.Date
  /// Null once a draft bill the run made was deleted.
  documentId      String?       @map("document_id") @db.Uuid
  posted          Boolean
  /// Null: the schedule runner.
  actorId         String?       @map("actor_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  recurringBill   RecurringBill @relation(fields: [recurringBillId], references: [id], onDelete: Restrict)

  @@unique([recurringBillId, runNo])
  @@index([documentId])
  @@map("recurring_bill_runs")
}

/// AP-007: the date (and amount) an open bill is planned to be paid. Planning moves no money.
model BillPaymentPlan {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  documentId  String   @unique @map("document_id") @db.Uuid
  payDate     DateTime @map("pay_date") @db.Date
  /// Null: what is left on the bill.
  amount      Decimal? @db.Decimal(24, 6)
  note        String?  @db.VarChar(300)
  updatedById String   @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([orgId, payDate])
  @@map("bill_payment_plans")
}

/// A customer's dispute about an invoice (AR-025). While OPEN, the invoice is held out of reminders.
model InvoiceDispute {
  id             String    @id @default(uuid()) @db.Uuid
  orgId          String    @map("org_id") @db.Uuid
  number         Int
  documentId     String    @map("document_id") @db.Uuid
  contactId      String    @map("contact_id") @db.Uuid
  amount         Decimal   @db.Decimal(24, 6)
  /// PRICE, QUANTITY, QUALITY, NOT_RECEIVED, DUPLICATE, TAX, OTHER
  reason         String    @db.VarChar(20)
  description    String    @db.VarChar(1000)
  /// OPEN or RESOLVED
  status         String    @default("OPEN") @db.VarChar(10)
  ownerId        String?   @map("owner_id") @db.Uuid
  targetDate     DateTime? @map("target_date") @db.Date
  openedOn       DateTime  @map("opened_on") @db.Date
  openedById     String    @map("opened_by_id") @db.Uuid
  /// CREDIT_NOTE, CUSTOMER_PAYS, WRITTEN_OFF, WITHDRAWN
  outcome        String?   @db.VarChar(20)
  creditNoteId   String?   @map("credit_note_id") @db.Uuid
  resolutionNote String?   @map("resolution_note") @db.VarChar(1000)
  resolvedOn     DateTime? @map("resolved_on") @db.Date
  resolvedById   String?   @map("resolved_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([id, orgId])
  @@unique([orgId, number])
  @@index([orgId, status])
  @@index([documentId])
  @@map("invoice_disputes")
}

/// Append-only history of a dispute: raised, notes, changes, resolution.
model InvoiceDisputeEvent {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  disputeId String   @map("dispute_id") @db.Uuid
  /// RAISED, NOTE, CHANGED, RESOLVED
  kind      String   @db.VarChar(20)
  body      String?  @db.VarChar(2000)
  data      Json?
  actorId   String   @map("actor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([disputeId, createdAt])
  @@map("invoice_dispute_events")
}

/// A pro forma invoice (AR-008): what the customer will be billed. Not a tax invoice; posts nothing.
model ProFormaInvoice {
  id            String    @id @default(uuid()) @db.Uuid
  orgId         String    @map("org_id") @db.Uuid
  /// Shown as PF-0001.
  number        Int
  contactId     String    @map("contact_id") @db.Uuid
  quoteId       String?   @map("quote_id") @db.Uuid
  issueDate     DateTime  @map("issue_date") @db.Date
  validUntil    DateTime  @map("valid_until") @db.Date
  placeOfSupply String?   @map("place_of_supply") @db.Char(2)
  reference     String?   @db.VarChar(100)
  terms         String?   @db.VarChar(4000)
  memo          String?   @db.VarChar(1000)
  currency      String    @db.Char(3)
  subtotal      Decimal   @db.Decimal(24, 6)
  taxTotal      Decimal   @map("tax_total") @db.Decimal(24, 6)
  total         Decimal   @db.Decimal(24, 6)
  /// DRAFT, ISSUED or CANCELLED (invoiced is worked out from invoiceId)
  status        String    @default("DRAFT") @db.VarChar(10)
  issuedAt      DateTime? @map("issued_at") @db.Timestamptz(6)
  cancelReason  String?   @map("cancel_reason") @db.VarChar(500)
  cancelledAt   DateTime? @map("cancelled_at") @db.Timestamptz(6)
  invoiceId     String?   @unique @map("invoice_id") @db.Uuid
  createdById   String    @map("created_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  lines         ProFormaInvoiceLine[]

  @@unique([orgId, number])
  @@unique([id, orgId])
  @@index([orgId, status])
  @@index([orgId, contactId])
  @@map("pro_forma_invoices")
}

model ProFormaInvoiceLine {
  id          String          @id @default(uuid()) @db.Uuid
  orgId       String          @map("org_id") @db.Uuid
  proFormaId  String          @map("pro_forma_id") @db.Uuid
  lineNo      Int             @map("line_no")
  description String?         @db.VarChar(500)
  accountId   String          @map("account_id") @db.Uuid
  quantity    Decimal         @db.Decimal(24, 6)
  unitPrice   Decimal         @map("unit_price") @db.Decimal(24, 6)
  taxRateId   String?         @map("tax_rate_id") @db.Uuid
  hsnCode     String?         @map("hsn_code")
  netAmount   Decimal         @map("net_amount") @db.Decimal(24, 6)
  taxAmount   Decimal         @map("tax_amount") @db.Decimal(24, 6)
  proForma    ProFormaInvoice @relation(fields: [proFormaId, orgId], references: [id, orgId], onDelete: Cascade)

  @@unique([proFormaId, lineNo])
  @@map("pro_forma_invoice_lines")
}

enum PurchaseOrderStatus {
  DRAFT
  ISSUED
  CLOSED
  CANCELLED
}

enum MatchMode {
  TWO_WAY
  THREE_WAY
}

enum GoodsReceiptStatus {
  RECORDED
  CANCELLED
}

/// AP-015: what was ordered from a vendor. Shown as PO-0001. Fixed once issued.
model PurchaseOrder {
  id                       String              @id @default(uuid()) @db.Uuid
  orgId                    String              @map("org_id") @db.Uuid
  number                   Int
  contactId                String              @map("contact_id") @db.Uuid
  orderDate                DateTime            @map("order_date") @db.Date
  expectedDate             DateTime?           @map("expected_date") @db.Date
  placeOfSupply            String?             @map("place_of_supply") @db.Char(2)
  /// The vendor's quotation or reference.
  reference                String?             @db.VarChar(100)
  terms                    String?             @db.VarChar(4000)
  memo                     String?             @db.VarChar(1000)
  currency                 String              @db.Char(3)
  subtotal                 Decimal             @db.Decimal(24, 6)
  taxTotal                 Decimal             @map("tax_total") @db.Decimal(24, 6)
  total                    Decimal             @db.Decimal(24, 6)
  status                   PurchaseOrderStatus @default(DRAFT)
  matchMode                MatchMode           @default(THREE_WAY) @map("match_mode")
  priceTolerancePercent    Decimal             @default(0) @map("price_tolerance_percent") @db.Decimal(5, 2)
  quantityTolerancePercent Decimal             @default(0) @map("quantity_tolerance_percent") @db.Decimal(5, 2)
  issuedAt                 DateTime?           @map("issued_at") @db.Timestamptz(6)
  closedAt                 DateTime?           @map("closed_at") @db.Timestamptz(6)
  closeReason              String?             @map("close_reason") @db.VarChar(500)
  cancelledAt              DateTime?           @map("cancelled_at") @db.Timestamptz(6)
  cancelReason             String?             @map("cancel_reason") @db.VarChar(500)
  createdById              String              @map("created_by_id") @db.Uuid
  createdAt                DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  lines                    PurchaseOrderLine[]
  receipts                 GoodsReceipt[]

  @@unique([orgId, number])
  @@unique([id, orgId])
  @@index([orgId, status])
  @@index([orgId, contactId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id          String             @id @default(uuid()) @db.Uuid
  orgId       String             @map("org_id") @db.Uuid
  orderId     String             @map("order_id") @db.Uuid
  lineNo      Int                @map("line_no")
  description String?            @db.VarChar(500)
  accountId   String             @map("account_id") @db.Uuid
  quantity    Decimal            @db.Decimal(24, 6)
  unitPrice   Decimal            @map("unit_price") @db.Decimal(24, 6)
  taxRateId   String?            @map("tax_rate_id") @db.Uuid
  hsnCode     String?            @map("hsn_code")
  netAmount   Decimal            @map("net_amount") @db.Decimal(24, 6)
  taxAmount   Decimal            @map("tax_amount") @db.Decimal(24, 6)
  order       PurchaseOrder      @relation(fields: [orderId, orgId], references: [id, orgId], onDelete: Cascade)
  received    GoodsReceiptLine[]

  @@unique([orderId, lineNo])
  @@unique([id, orgId])
  @@map("purchase_order_lines")
}

/// AP-016: goods received against a purchase order. Shown as GRN-0001. Never edited; cancelled instead.
model GoodsReceipt {
  id           String             @id @default(uuid()) @db.Uuid
  orgId        String             @map("org_id") @db.Uuid
  number       Int
  orderId      String             @map("order_id") @db.Uuid
  receiptDate  DateTime           @map("receipt_date") @db.Date
  /// The vendor's delivery note or challan.
  reference    String?            @db.VarChar(100)
  memo         String?            @db.VarChar(1000)
  status       GoodsReceiptStatus @default(RECORDED)
  cancelledAt  DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  cancelReason String?            @map("cancel_reason") @db.VarChar(500)
  createdById  String             @map("created_by_id") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  order        PurchaseOrder      @relation(fields: [orderId, orgId], references: [id, orgId], onDelete: Restrict)
  lines        GoodsReceiptLine[]

  @@unique([orgId, number])
  @@unique([id, orgId])
  @@index([orgId, orderId])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id          String            @id @default(uuid()) @db.Uuid
  orgId       String            @map("org_id") @db.Uuid
  receiptId   String            @map("receipt_id") @db.Uuid
  orderLineId String            @map("order_line_id") @db.Uuid
  /// Accepted into stock or use.
  quantity    Decimal           @db.Decimal(24, 6)
  rejected    Decimal           @default(0) @db.Decimal(24, 6)
  note        String?           @db.VarChar(500)
  receipt     GoodsReceipt      @relation(fields: [receiptId, orgId], references: [id, orgId], onDelete: Restrict)
  orderLine   PurchaseOrderLine @relation(fields: [orderLineId, orgId], references: [id, orgId], onDelete: Restrict)

  @@unique([receiptId, orderLineId])
  @@index([orderLineId])
  @@map("goods_receipt_lines")
}

/// AP-017: why a bill that does not match its purchase order is accepted. Applies only to the differences it records.
model BillMatchAcceptance {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  documentId   String   @map("document_id") @db.Uuid
  fingerprint  String
  reason       String   @db.VarChar(1000)
  acceptedById String   @map("accepted_by_id") @db.Uuid
  acceptedAt   DateTime @default(now()) @map("accepted_at") @db.Timestamptz(6)

  @@index([orgId, documentId])
  @@map("bill_match_acceptances")
}

enum SalesBillingMethod {
  DELIVERY
  MILESTONES
  PROGRESS
}

/// A named share of a sales order's value, billed on its own invoice (AR-013).
model SalesOrderMilestone {
  id            String     @id @default(uuid()) @db.Uuid
  orgId         String     @map("org_id") @db.Uuid
  orderId       String     @map("order_id") @db.Uuid
  seq           Int
  name          String     @db.VarChar(200)
  percent       Decimal    @db.Decimal(5, 2)
  dueDate       DateTime?  @map("due_date") @db.Date
  completedAt   DateTime?  @map("completed_at") @db.Timestamptz(6)
  completedById String?    @map("completed_by_id") @db.Uuid
  documentId    String?    @map("document_id") @db.Uuid
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  order         SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, seq])
  @@unique([id, orgId])
  @@index([orgId, documentId])
  @@map("sales_order_milestones")
}

/// A claim of how complete the work on a sales order is, billed up to that share (AR-014).
model SalesOrderProgressClaim {
  id              String     @id @default(uuid()) @db.Uuid
  orgId           String     @map("org_id") @db.Uuid
  orderId         String     @map("order_id") @db.Uuid
  percentComplete Decimal    @map("percent_complete") @db.Decimal(5, 2)
  documentId      String     @unique @map("document_id") @db.Uuid
  note            String?    @db.VarChar(500)
  createdById     String     @map("created_by_id") @db.Uuid
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  order           SalesOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orgId, orderId])
  @@map("sales_order_progress_claims")
}
