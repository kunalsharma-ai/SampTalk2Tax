// Talk2Tax authoritative transactional schema.
// Financial invariants are enforced twice: in the accounting engine and in
// PostgreSQL itself (see the hand-written SQL appended to the first migration).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  ACCOUNTANT
  APPROVER
  VIEWER
  /// Submits and tracks their own expense claims; sees nothing else.
  EMPLOYEE
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum PeriodStatus {
  OPEN
  LOCKED
  CLOSED
}

enum JournalStatus {
  DRAFT
  POSTED
}

enum JournalSource {
  MANUAL
  ASSET
  DOCUMENT
  PAYMENT
  BANK
  EXPENSE
  TAX
  PAYROLL
  CLOSE
  DEFERRAL
  ACCRUAL
  LOAN
  INTERCOMPANY
  FX_REVALUATION
  FX_SETTLEMENT
  BAD_DEBT
  YEAR_END
}

enum IntercompanyKind {
  CHARGE
  SETTLEMENT
}

enum StatementLineStatus {
  UNMATCHED
  MATCHED
  EXCLUDED
}

enum BankMatchOrigin {
  EXISTING
  CREATED_ENTRY
  CREATED_PAYMENT
}

enum AttachmentEntity {
  DOCUMENT
  PAYMENT
  JOURNAL_ENTRY
  BANK_STATEMENT_LINE
  EXPENSE_CLAIM
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ReconciliationStatus {
  COMPLETED
  UNDONE
}

enum DocumentKind {
  INVOICE
  CREDIT_NOTE
  BILL
  VENDOR_CREDIT
}

enum DocumentStatus {
  DRAFT
  POSTED
  VOID
}

enum PaymentKind {
  RECEIPT
  PAYMENT
}

enum PaymentStatus {
  POSTED
  VOID
}

enum JournalType {
  STANDARD
  ADJUSTING
  REVERSING
  OPENING
  CLOSING
  RECURRING
}

model User {
  id                     String                 @id @default(uuid()) @db.Uuid
  email                  String                 @unique
  name                   String
  passwordHash           String                 @map("password_hash")
  isActive               Boolean                @default(true) @map("is_active")
  /// Platform administration: SUPER_ADMIN or SUPPORT; null for everyone else.
  platformRole           String?                @map("platform_role") @db.VarChar(16)
  /// Interface language: en or hi.
  language               String                 @default("en") @db.VarChar(8)
  /// AUTO (by currency), IN, INTL, EU or SPACE.
  numberFormat           String                 @default("AUTO") @map("number_format") @db.VarChar(8)
  /// D_MON_Y, DMY, MDY or YMD.
  dateFormat             String                 @default("D_MON_Y") @map("date_format") @db.VarChar(8)
  /// IANA time zone for this person; null = the organisation's.
  timeZone               String?                @map("time_zone") @db.VarChar(64)
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships            Membership[]
  sessions               AuthSession[]
  announcementsCreated   PlatformAnnouncement[] @relation("AnnouncementCreatedBy")
  announcementsWithdrawn PlatformAnnouncement[] @relation("AnnouncementWithdrawnBy")

  @@map("users")
}

/// A signed-in device. The access token (JWT) names the session, so revoking the
/// session ends access at once. The refresh token is `<session id>.<secret>`; only a
/// SHA-256 of the secret is stored, and it changes on every refresh.
model AuthSession {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretHash         String    @map("secret_hash")
  /// The secret before the last rotation, accepted for a short grace window so that
  /// two refreshes racing each other do not look like token theft.
  previousSecretHash String?   @map("previous_secret_hash")
  rotatedAt          DateTime? @map("rotated_at") @db.Timestamptz(6)
  rotationCount      Int       @default(0) @map("rotation_count")
  userAgent          String?   @map("user_agent")
  ipAddress          String?   @map("ip_address")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt         DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  /// Hard limit: the session ends here however active it is.
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason      String?   @map("revoked_reason")

  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

/// Failed sign-in counter per email address, whether or not an account exists, so
/// lockout answers the same way for real and unknown addresses.
model LoginThrottle {
  email          String    @id
  failures       Int       @default(0)
  firstFailureAt DateTime  @map("first_failure_at") @db.Timestamptz(6)
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("login_throttles")
}

model Organization {
  id                       String                    @id @default(uuid()) @db.Uuid
  name                     String
  legalName                String?                   @map("legal_name")
  /// IANA time zone moments are shown in for this organisation.
  timeZone                 String                    @default("Asia/Kolkata") @map("time_zone") @db.VarChar(64)
  countryCode              String                    @map("country_code") @db.Char(2)
  functionalCurrency       String                    @map("functional_currency") @db.Char(3)
  fiscalYearStartMonth     Int                       @map("fiscal_year_start_month") @db.SmallInt
  isDemo                   Boolean                   @default(false) @map("is_demo")
  /// The region this organisation's data lives in (set at creation; see docs/REGIONAL_DEPLOYMENT.md).
  dataRegion               String?                   @map("data_region") @db.VarChar(32)
  /// Suspended by the platform: readable by members, not changeable.
  suspendedAt              DateTime?                 @map("suspended_at") @db.Timestamptz(6)
  suspendedReason          String?                   @map("suspended_reason")
  /// Receivables / payables control accounts. Manual journals cannot post to them (DB trigger).
  arAccountId              String?                   @map("ar_account_id") @db.Uuid
  apAccountId              String?                   @map("ap_account_id") @db.Uuid
  /// Employee reimbursements payable. Only expense claims post to it (DB trigger).
  claimsAccountId          String?                   @map("claims_account_id") @db.Uuid
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships              Membership[]
  subscription             Subscription?
  subscriptionEvents       SubscriptionEvent[]
  subscriptionInvoices     SubscriptionInvoice[]
  accounts                 Account[]
  periods                  FiscalPeriod[]
  journalEntries           JournalEntry[]
  counters                 OrgCounter[]
  auditEvents              AuditEvent[]
  contacts                 Contact[]
  taxRates                 TaxRate[]
  documents                Document[]
  payments                 Payment[]
  statementImports         BankStatementImport[]
  statementLines           BankStatementLine[]
  bankMatches              BankMatch[]
  reconciliations          BankReconciliation[]
  attachments              Attachment[]
  invoiceTemplates         InvoiceTemplate[]
  consolidationGroups      ConsolidationGroup[]
  consolidatedIn           ConsolidationMember[]     @relation("ConsolidationMemberOrg")
  twinScenarios            TwinScenario[]
  cfoReports               CfoReport[]
  benchmarkParticipation   BenchmarkParticipation?
  decisions                Decision[]
  recoveryPlans            RecoveryPlan[]
  integrations             OrgIntegration[]
  userSignatures           UserSignature[]
  documentSignatures       DocumentSignature[]
  approvalPolicies         ApprovalPolicy[]
  approvalRequests         ApprovalRequest[]
  expenseClaims            ExpenseClaim[]
  invitations              Invitation[]
  gstRegistration          GstRegistration?
  withholdingSettings      WithholdingSettings?
  withholdingSections      WithholdingSection[]
  withholdingDeposits      WithholdingDeposit[]
  payrollSettings          PayrollSettings?
  complianceSettings       ComplianceSettings?
  complianceFilings        ComplianceFiling[]
  eInvoiceSettings         EInvoiceSettings?
  eInvoices                EInvoice[]
  eWayBillSettings         EWayBillSettings?
  eWayBills                EWayBill[]
  eWayBillVehicles         EWayBillVehicleUpdate[]
  employees                Employee[]
  payRuns                  PayRun[]
  budgets                  Budget[]
  budgetLines              BudgetLine[]
  cashFlowSettings         CashFlowSettings?
  cashFlowItems            CashFlowItem[]
  cashForecasts            CashForecast[]
  kpiTargets               KpiTarget[]
  managementReports        ManagementReport[]
  alertRuleSettings        AlertRuleSetting[]
  alerts                   Alert[]
  alertEvents              AlertEvent[]
  alertScans               AlertScan[]
  copilotSettings          CopilotSettings?
  aiAgentSettings          AiAgentSetting[]
  fixedAssets              FixedAsset[]
  depreciationRuns         DepreciationRun[]
  depreciationLines        DepreciationLine[]
  deferralSchedules        DeferralSchedule[]
  deferralRuns             DeferralRun[]
  deferralLines            DeferralLine[]
  accruals                 Accrual[]
  loans                    Loan[]
  crmLeads                 CrmLead[]
  crmDeals                 CrmDeal[]
  crmActivities            CrmActivity[]
  salesQuotes              SalesQuote[]
  salesOrders              SalesOrder[]
  salesContracts           SalesContract[]
  journalTemplates         JournalTemplate[]
  recurringBills           RecurringBill[]
  revenueForecasts            RevenueForecast[]
  apiKeys                     ApiKey[]
  crmWebhooks                 CrmWebhook[]
  crmWebhookDeliveries        CrmWebhookDelivery[]
  loanEvents               LoanEvent[]
  dimensionValues          DimensionValue[]
  copilotConversations     CopilotConversation[]
  copilotMessages          CopilotMessage[]
  workflows                Workflow[]
  workflowVersions         WorkflowVersion[]
  workflowRuns             WorkflowRun[]
  workflowActionRuns       WorkflowActionRun[]
  workflowCursor           WorkflowCursor?
  tasks                    Task[]
  collectionRuns           CollectionRun[]
  collectionDrafts         CollectionDraft[]
  bankAiRuns               BankAiRun[]
  bankAiSuggestions        BankAiSuggestion[]
  periodCloses             PeriodClose[]
  closeCertifications      CloseCertification[]
  closeAiReviews           CloseAiReview[]
  closeAdjustments         CloseAdjustment[]
  forecastLabRuns          ForecastLabRun[]
  disasterSimulations      DisasterSimulation[]
  impactAssessments        ImpactAssessment[]
  alertNotificationSetting AlertNotificationSetting?
  policies                 Policy[]
  policyVersions           PolicyVersion[]
  dashboards               Dashboard[]
  reportDesigns            ReportDesign[]
  reportRuns               ReportRun[]
  reportAiCalls            ReportAiCall[]
  copilotActions           CopilotAction[]
  dashboardAiDrafts        DashboardAiDraft[]
  policyAiDrafts           PolicyAiDraft[]
  exchangeRates            ExchangeRate[]
  fxRevaluations           FxRevaluation[]

  @@map("organizations")
}

model Membership {
  id        String       @id @default(uuid()) @db.Uuid
  orgId     String       @map("org_id") @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  role      Role
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
  @@map("memberships")
}

/// An invitation to join an organisation with a role. The link carries a random token;
/// only its SHA-256 is stored. Only the invited email can accept it, once, before it expires.
model Invitation {
  id           String       @id @default(uuid()) @db.Uuid
  orgId        String       @map("org_id") @db.Uuid
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// Lower-case.
  email        String
  role         Role
  tokenHash    String       @unique @map("token_hash")
  invitedById  String       @map("invited_by_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt    DateTime     @map("expires_at") @db.Timestamptz(6)
  acceptedAt   DateTime?    @map("accepted_at") @db.Timestamptz(6)
  acceptedById String?      @map("accepted_by_id") @db.Uuid
  revokedAt    DateTime?    @map("revoked_at") @db.Timestamptz(6)
  revokedById  String?      @map("revoked_by_id") @db.Uuid

  @@index([orgId, createdAt])
  @@map("invitations")
}

model Account {
  id               String                @id @default(uuid()) @db.Uuid
  orgId            String                @map("org_id") @db.Uuid
  code             String
  name             String
  type             AccountType
  subtype          String?
  description      String?
  parentId         String?               @map("parent_id") @db.Uuid
  isPostable       Boolean               @default(true) @map("is_postable")
  isActive         Boolean               @default(true) @map("is_active")
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  org              Organization          @relation(fields: [orgId], references: [id], onDelete: Restrict)
  parent           Account?              @relation("AccountHierarchy", fields: [parentId, orgId], references: [id, orgId], onDelete: Restrict)
  children         Account[]             @relation("AccountHierarchy")
  lines            JournalLine[]
  documentLines    DocumentLine[]
  journalTemplateLines JournalTemplateLine[]
  expenseLines     ExpenseClaimLine[]
  paymentsViaBank  Payment[]
  statementImports BankStatementImport[]
  statementLines   BankStatementLine[]
  reconciliations  BankReconciliation[]
  budgetLines      BudgetLine[]

  @@unique([orgId, code])
  @@unique([id, orgId])
  @@index([orgId, type])
  @@map("accounts")
}

model FiscalPeriod {
  id         String         @id @default(uuid()) @db.Uuid
  orgId      String         @map("org_id") @db.Uuid
  fiscalYear Int            @map("fiscal_year")
  periodNo   Int            @map("period_no") @db.SmallInt
  name       String
  startDate  DateTime       @map("start_date") @db.Date
  endDate    DateTime       @map("end_date") @db.Date
  status     PeriodStatus   @default(OPEN)
  lockedAt   DateTime?      @map("locked_at") @db.Timestamptz(6)
  lockedById String?        @map("locked_by_id") @db.Uuid
  org        Organization   @relation(fields: [orgId], references: [id], onDelete: Restrict)
  entries    JournalEntry[]
  close      PeriodClose?

  @@unique([orgId, fiscalYear, periodNo])
  @@unique([id, orgId])
  @@index([orgId, startDate])
  @@map("fiscal_periods")
}

model JournalEntry {
  id                    String         @id @default(uuid()) @db.Uuid
  orgId                 String         @map("org_id") @db.Uuid
  entryNumber           Int?           @map("entry_number")
  date                  DateTime       @db.Date
  periodId              String         @map("period_id") @db.Uuid
  type                  JournalType    @default(STANDARD)
  source                JournalSource  @default(MANUAL)
  status                JournalStatus  @default(DRAFT)
  memo                  String?
  reference             String?
  functionalCurrency    String         @map("functional_currency") @db.Char(3)
  totalDebit            Decimal        @default(0) @map("total_debit") @db.Decimal(24, 6)
  totalCredit           Decimal        @default(0) @map("total_credit") @db.Decimal(24, 6)
  idempotencyKey        String?        @map("idempotency_key")
  idempotencyHash       String?        @map("idempotency_hash")
  reversesEntryId       String?        @unique @map("reverses_entry_id") @db.Uuid
  createdById           String         @map("created_by_id") @db.Uuid
  postedById            String?        @map("posted_by_id") @db.Uuid
  postedAt              DateTime?      @map("posted_at") @db.Timestamptz(6)
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  org                   Organization   @relation(fields: [orgId], references: [id], onDelete: Restrict)
  period                FiscalPeriod   @relation(fields: [periodId, orgId], references: [id, orgId], onDelete: Restrict)
  reverses              JournalEntry?  @relation("Reversal", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversedBy            JournalEntry?  @relation("Reversal")
  lines                 JournalLine[]
  fxRevaluation         FxRevaluation? @relation("FxRevaluationEntry")
  fxRevaluationReversal FxRevaluation? @relation("FxRevaluationReversal")

  @@unique([orgId, entryNumber])
  @@unique([orgId, idempotencyKey])
  @@unique([id, orgId])
  @@index([orgId, date])
  @@index([orgId, status])
  @@map("journal_entries")
}

model JournalLine {
  id               String       @id @default(uuid()) @db.Uuid
  orgId            String       @map("org_id") @db.Uuid
  entryId          String       @map("entry_id") @db.Uuid
  lineNo           Int          @map("line_no")
  accountId        String       @map("account_id") @db.Uuid
  currency         String       @db.Char(3)
  exchangeRate     Decimal      @map("exchange_rate") @db.Decimal(24, 10)
  debit            Decimal      @default(0) @db.Decimal(24, 6)
  credit           Decimal      @default(0) @db.Decimal(24, 6)
  functionalDebit  Decimal      @default(0) @map("functional_debit") @db.Decimal(24, 6)
  functionalCredit Decimal      @default(0) @map("functional_credit") @db.Decimal(24, 6)
  description      String?
  dimensions       Json?
  /// Financial dimensions: department (cost centre) and project.
  departmentId     String?      @map("department_id") @db.Uuid
  projectId        String?      @map("project_id") @db.Uuid
  entry            JournalEntry @relation(fields: [entryId, orgId], references: [id, orgId], onDelete: Restrict)
  account          Account      @relation(fields: [accountId, orgId], references: [id, orgId], onDelete: Restrict)
  bankMatches      BankMatch[]

  @@unique([entryId, lineNo])
  @@unique([id, orgId])
  @@index([orgId, accountId])
  @@index([orgId, departmentId])
  @@index([orgId, projectId])
  @@map("journal_lines")
}

model OrgCounter {
  orgId String       @map("org_id") @db.Uuid
  key   String
  value Int          @default(0)
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([orgId, key])
  @@map("org_counters")
}

/// Append-only, hash-chained audit trail. UPDATE/DELETE are blocked by trigger.
model AuditEvent {
  id         BigInt        @id @default(autoincrement())
  orgId      String?       @map("org_id") @db.Uuid
  actorId    String?       @map("actor_id") @db.Uuid
  action     String
  entityType String        @map("entity_type")
  entityId   String?       @map("entity_id")
  data       Json?
  prevHash   String?       @map("prev_hash")
  hash       String
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  org        Organization? @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@index([orgId, createdAt])
  @@index([orgId, entityType, entityId])
  @@map("audit_events")
}

/// Customers and vendors. One contact can be both.
model Contact {
  id                   String            @id @default(uuid()) @db.Uuid
  orgId                String            @map("org_id") @db.Uuid
  name                 String
  email                String?
  phone                String?
  taxId                String?           @map("tax_id")
  /// India GST: the contact's GSTIN (upper case, check character verified). Null = unregistered.
  gstin                String?
  /// India GST state code: from the GSTIN when registered; otherwise where the contact is (default place of supply).
  stateCode            String?           @map("state_code") @db.Char(2)
  /// India: the contact's PAN (from the GSTIN when registered). Decides TDS/TCS rates (no PAN, individual or HUF).
  pan                  String?           @db.Char(10)
  /// Default TDS (vendors) or TCS (customers) section for new documents.
  withholdingSectionId String?           @map("withholding_section_id") @db.Uuid
  address              String?
  /// City or locality (e-invoice Loc).
  city                 String?
  /// Six-digit PIN code (e-invoice Pin).
  pincode              String?           @db.Char(6)
  isCustomer           Boolean           @default(false) @map("is_customer")
  isVendor             Boolean           @default(false) @map("is_vendor")
  paymentTermsDays     Int               @default(30) @map("payment_terms_days")
  creditLimit          Decimal?          @map("credit_limit") @db.Decimal(24, 6)
  /// Credit hold: no invoice to this customer posts until it is lifted. Reason, when and who are required while on hold.
  creditHold           Boolean           @default(false) @map("credit_hold")
  creditHoldReason     String?           @map("credit_hold_reason") @db.VarChar(500)
  creditHoldAt         DateTime?         @map("credit_hold_at") @db.Timestamptz(6)
  creditHoldById       String?           @map("credit_hold_by_id") @db.Uuid
  isActive             Boolean           @default(true) @map("is_active")
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  org                  Organization      @relation(fields: [orgId], references: [id], onDelete: Restrict)
  documents            Document[]
  recurringBills       RecurringBill[]
  payments             Payment[]
  collectionDrafts     CollectionDraft[]
  /// Projects run for this customer: their costs are the customer's direct costs.
  projects             DimensionValue[]

  @@unique([id, orgId])
  @@index([orgId, name])
  @@map("contacts")
}

enum TaxRateKind {
  /// A plain percentage posted to one account per ledger.
  SIMPLE
  /// India GST: split into CGST + SGST/UTGST or IGST by place of supply, posted to the GST registration's accounts.
  GST
}

/// How a GST rate treats the supply (GSTR-1 table 8, GSTR-3B 3.1 and 5).
enum GstCategory {
  TAXABLE
  NIL_RATED
  EXEMPT
  NON_GST
}

enum SupplyNature {
  INTRA
  INTER
}

/// A tenant-configured tax rate. SIMPLE rates are a calculation aid; GST rates follow India GST rules (packages/tax-engine).
model TaxRate {
  id                String         @id @default(uuid()) @db.Uuid
  orgId             String         @map("org_id") @db.Uuid
  name              String
  rate              Decimal        @db.Decimal(9, 6)
  kind              TaxRateKind    @default(SIMPLE)
  gstCategory       GstCategory?   @map("gst_category")
  salesAccountId    String?        @map("sales_account_id") @db.Uuid
  purchaseAccountId String?        @map("purchase_account_id") @db.Uuid
  isActive          Boolean        @default(true) @map("is_active")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  org               Organization   @relation(fields: [orgId], references: [id], onDelete: Restrict)
  lines             DocumentLine[]

  expenseLines ExpenseClaimLine[]

  @@unique([orgId, name])
  @@unique([id, orgId])
  @@map("tax_rates")
}

/// Invoices, customer credit notes, bills and vendor credits.
model Document {
  id                   String                   @id @default(uuid()) @db.Uuid
  orgId                String                   @map("org_id") @db.Uuid
  kind                 DocumentKind
  status               DocumentStatus           @default(DRAFT)
  number               String?
  contactId            String                   @map("contact_id") @db.Uuid
  issueDate            DateTime                 @map("issue_date") @db.Date
  dueDate              DateTime                 @map("due_date") @db.Date
  reference            String?
  memo                 String?
  currency             String                   @db.Char(3)
  /// Functional currency per one unit of the document's currency; 1 in the functional currency. Fixed when saved.
  exchangeRate         Decimal                  @default(1) @map("exchange_rate") @db.Decimal(24, 10)
  /// India GST, set on documents that use GST rates: place of supply (state code, 96 = outside India).
  placeOfSupply        String?                  @map("place_of_supply") @db.Char(2)
  /// India GST: the supplier's state (the organisation's on sales, the vendor's on purchases).
  supplierState        String?                  @map("supplier_state") @db.Char(2)
  supplyNature         SupplyNature?            @map("supply_nature")
  /// India GST: the contact's GSTIN when the document was saved. Null = unregistered.
  counterpartyGstin    String?                  @map("counterparty_gstin")
  /// India GST reverse charge (bills and vendor credits): the organisation pays the GST, not the supplier.
  reverseCharge        Boolean                  @default(false) @map("reverse_charge")
  /// GST on a reverse-charge document: on the lines, but neither in tax_total nor owed to the supplier.
  reverseChargeTax     Decimal                  @default(0) @map("reverse_charge_tax") @db.Decimal(24, 6)
  /// Income tax withheld: TDS on bills (lowers total), TCS on invoices (raises total).
  withholdingSectionId String?                  @map("withholding_section_id") @db.Uuid
  withholdingKind      WithholdingKind?         @map("withholding_kind")
  /// This document's amount counted toward the section's threshold.
  withholdingSubject   Decimal                  @default(0) @map("withholding_subject") @db.Decimal(24, 6)
  /// The amount the tax was worked out on (can include earlier documents once a threshold is crossed).
  withholdingBase      Decimal                  @default(0) @map("withholding_base") @db.Decimal(24, 6)
  withholdingRate      Decimal                  @default(0) @map("withholding_rate") @db.Decimal(9, 6)
  withholdingAmount    Decimal                  @default(0) @map("withholding_amount") @db.Decimal(24, 6)
  /// The contact's PAN when the document was saved; null = no PAN (higher rate).
  counterpartyPan      String?                  @map("counterparty_pan") @db.Char(10)
  subtotal             Decimal                  @db.Decimal(24, 6)
  taxTotal             Decimal                  @map("tax_total") @db.Decimal(24, 6)
  total                Decimal                  @db.Decimal(24, 6)
  journalEntryId       String?                  @unique @map("journal_entry_id") @db.Uuid
  voidJournalEntryId   String?                  @unique @map("void_journal_entry_id") @db.Uuid
  voidDate             DateTime?                @map("void_date") @db.Date
  voidReason           String?                  @map("void_reason")
  createdById          String                   @map("created_by_id") @db.Uuid
  postedById           String?                  @map("posted_by_id") @db.Uuid
  postedAt             DateTime?                @map("posted_at") @db.Timestamptz(6)
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  org                  Organization             @relation(fields: [orgId], references: [id], onDelete: Restrict)
  contact              Contact                  @relation(fields: [contactId, orgId], references: [id, orgId], onDelete: Restrict)
  lines                DocumentLine[]
  allocationsIn        Allocation[]             @relation("AllocationTarget")
  allocationsOut       Allocation[]             @relation("AllocationCreditSource")
  approvalRequests     ApprovalRequest[]
  withholdingSection   WithholdingSection?      @relation(fields: [withholdingSectionId, orgId], references: [id, orgId], onDelete: Restrict, map: "documents_withholding_section_fk")
  depositItems         WithholdingDepositItem[]
  eInvoices            EInvoice[]
  eWayBills            EWayBill[]
  /// The design it prints with; null = the organisation's default template. Can change after posting.
  templateId           String?                  @map("template_id") @db.Uuid
  template             InvoiceTemplate?         @relation(fields: [templateId, orgId], references: [id, orgId], onDelete: Restrict, map: "documents_template_fk")
  signatures           DocumentSignature[]
  /// A debit note (an INVOICE row, numbered DN-) raising the value of this earlier posted invoice.
  debitNoteForId       String?                  @map("debit_note_for_id") @db.Uuid
  debitNoteFor         Document?                @relation("DebitNotes", fields: [debitNoteForId, orgId], references: [id, orgId], onDelete: Restrict, map: "documents_debit_note_for_fk")
  debitNotes           Document[]               @relation("DebitNotes")
  /// A bill matched to this purchase order (AP-015); its lines point at the order's lines.
  purchaseOrderId      String?                  @map("purchase_order_id") @db.Uuid

  @@unique([orgId, kind, number])
  @@unique([id, orgId])
  @@index([orgId, kind, status])
  @@index([orgId, contactId])
  @@index([orgId, debitNoteForId])
  @@map("documents")
}

model DocumentLine {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  documentId   String   @map("document_id") @db.Uuid
  lineNo       Int      @map("line_no")
  description  String?
  accountId    String   @map("account_id") @db.Uuid
  quantity     Decimal  @db.Decimal(24, 6)
  unitPrice    Decimal  @map("unit_price") @db.Decimal(24, 6)
  taxRateId    String?  @map("tax_rate_id") @db.Uuid
  taxRate      Decimal  @default(0) @map("tax_rate") @db.Decimal(9, 6)
  netAmount    Decimal  @map("net_amount") @db.Decimal(24, 6)
  taxAmount    Decimal  @map("tax_amount") @db.Decimal(24, 6)
  /// India GST: HSN (goods) or SAC (services) code, and the tax by head. Their sum equals taxAmount on GST lines.
  hsnCode      String?  @map("hsn_code")
  cgstAmount   Decimal  @default(0) @map("cgst_amount") @db.Decimal(24, 6)
  sgstAmount   Decimal  @default(0) @map("sgst_amount") @db.Decimal(24, 6)
  igstAmount   Decimal  @default(0) @map("igst_amount") @db.Decimal(24, 6)
  departmentId String?  @map("department_id") @db.Uuid
  projectId    String?  @map("project_id") @db.Uuid
  /// Bills: the purchase order line this line bills.
  purchaseOrderLineId String? @map("purchase_order_line_id") @db.Uuid
  document     Document @relation(fields: [documentId, orgId], references: [id, orgId], onDelete: Cascade)
  account      Account  @relation(fields: [accountId, orgId], references: [id, orgId], onDelete: Restrict)
  tax          TaxRate? @relation(fields: [taxRateId, orgId], references: [id, orgId], onDelete: Restrict)

  @@unique([documentId, lineNo])
  @@map("document_lines")
}

/// Money received from a customer (RECEIPT) or paid to a vendor (PAYMENT).
model Payment {
  id                 String        @id @default(uuid()) @db.Uuid
  orgId              String        @map("org_id") @db.Uuid
  kind               PaymentKind
  status             PaymentStatus @default(POSTED)
  number             String
  contactId          String        @map("contact_id") @db.Uuid
  date               DateTime      @db.Date
  bankAccountId      String        @map("bank_account_id") @db.Uuid
  currency           String        @db.Char(3)
  /// Functional currency per one unit of the payment's currency; 1 in the functional currency.
  exchangeRate       Decimal       @default(1) @map("exchange_rate") @db.Decimal(24, 10)
  amount             Decimal       @db.Decimal(24, 6)
  reference          String?
  memo               String?
  journalEntryId     String        @unique @map("journal_entry_id") @db.Uuid
  voidJournalEntryId String?       @unique @map("void_journal_entry_id") @db.Uuid
  voidDate           DateTime?     @map("void_date") @db.Date
  idempotencyKey     String?       @map("idempotency_key")
  idempotencyHash    String?       @map("idempotency_hash")
  createdById        String        @map("created_by_id") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  org                Organization  @relation(fields: [orgId], references: [id], onDelete: Restrict)
  contact            Contact       @relation(fields: [contactId, orgId], references: [id, orgId], onDelete: Restrict)
  bankAccount        Account       @relation(fields: [bankAccountId, orgId], references: [id, orgId], onDelete: Restrict)
  allocations        Allocation[]

  @@unique([orgId, kind, number])
  @@unique([orgId, idempotencyKey])
  @@unique([id, orgId])
  @@index([orgId, contactId])
  @@map("payments")
}

/// Applies a payment or a credit document against an invoice or bill.
/// Rows are never deleted; removing an allocation stamps removed_on.
model Allocation {
  id               String    @id @default(uuid()) @db.Uuid
  orgId            String    @map("org_id") @db.Uuid
  targetId         String    @map("target_id") @db.Uuid
  paymentId        String?   @map("payment_id") @db.Uuid
  creditDocumentId String?   @map("credit_document_id") @db.Uuid
  amount           Decimal   @db.Decimal(24, 6)
  date             DateTime  @db.Date
  createdById      String    @map("created_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  removedOn        DateTime? @map("removed_on") @db.Date
  removedById      String?   @map("removed_by_id") @db.Uuid
  /// Realised exchange gain (+) or loss (-) in the functional currency, posted when the allocation was made.
  fxGain                   Decimal   @default(0) @map("fx_gain") @db.Decimal(24, 6)
  fxJournalEntryId         String?   @unique @map("fx_journal_entry_id") @db.Uuid
  fxReversalJournalEntryId String?   @unique @map("fx_reversal_journal_entry_id") @db.Uuid
  /// A bad-debt write-off settling the target invoice (the third kind of source).
  writeOffId               String?   @map("write_off_id") @db.Uuid
  target           Document  @relation("AllocationTarget", fields: [targetId, orgId], references: [id, orgId], onDelete: Restrict)
  payment          Payment?  @relation(fields: [paymentId, orgId], references: [id, orgId], onDelete: Restrict)
  creditDocument   Document? @relation("AllocationCreditSource", fields: [creditDocumentId, orgId], references: [id, orgId], onDelete: Restrict)
  writeOff         BadDebtWriteOff? @relation(fields: [writeOffId, orgId], references: [id, orgId], onDelete: Restrict)

  @@index([orgId, targetId])
  @@index([orgId, paymentId])
  @@index([orgId, creditDocumentId])
  @@index([orgId, writeOffId])
  @@map("allocations")
}

/// One uploaded bank statement file. Lines already imported (same fingerprint) are skipped.
model BankStatementImport {
  id           String              @id @default(uuid()) @db.Uuid
  orgId        String              @map("org_id") @db.Uuid
  accountId    String              @map("account_id") @db.Uuid
  fileName     String              @map("file_name")
  fileHash     String              @map("file_hash")
  lineCount    Int                 @map("line_count")
  skippedCount Int                 @map("skipped_count")
  firstDate    DateTime            @map("first_date") @db.Date
  lastDate     DateTime            @map("last_date") @db.Date
  importedById String              @map("imported_by_id") @db.Uuid
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  org          Organization        @relation(fields: [orgId], references: [id], onDelete: Restrict)
  account      Account             @relation(fields: [accountId, orgId], references: [id, orgId], onDelete: Restrict)
  lines        BankStatementLine[]

  @@unique([id, orgId])
  @@index([orgId, accountId])
  @@map("bank_statement_imports")
}

/// Money that moved in the bank: positive = in, negative = out. Never deleted.
model BankStatementLine {
  id               String              @id @default(uuid()) @db.Uuid
  orgId            String              @map("org_id") @db.Uuid
  accountId        String              @map("account_id") @db.Uuid
  importId         String              @map("import_id") @db.Uuid
  date             DateTime            @db.Date
  description      String
  reference        String?
  amount           Decimal             @db.Decimal(24, 6)
  fingerprint      String
  status           StatementLineStatus @default(UNMATCHED)
  excludedReason   String?             @map("excluded_reason")
  reconciliationId String?             @map("reconciliation_id") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  org              Organization        @relation(fields: [orgId], references: [id], onDelete: Restrict)
  account          Account             @relation(fields: [accountId, orgId], references: [id, orgId], onDelete: Restrict)
  import           BankStatementImport @relation(fields: [importId, orgId], references: [id, orgId], onDelete: Restrict)
  reconciliation   BankReconciliation? @relation(fields: [reconciliationId, orgId], references: [id, orgId], onDelete: Restrict)
  matches          BankMatch[]
  aiSuggestions    BankAiSuggestion[]

  @@unique([orgId, accountId, fingerprint])
  @@unique([id, orgId])
  @@index([orgId, accountId, date])
  @@index([orgId, accountId, status])
  @@map("bank_statement_lines")
}

/// Links a statement line to a posted journal line on the same bank account.
/// Never deleted; unmatching stamps removed_at.
model BankMatch {
  id              String            @id @default(uuid()) @db.Uuid
  orgId           String            @map("org_id") @db.Uuid
  statementLineId String            @map("statement_line_id") @db.Uuid
  journalLineId   String            @map("journal_line_id") @db.Uuid
  origin          BankMatchOrigin   @default(EXISTING)
  createdById     String            @map("created_by_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  removedAt       DateTime?         @map("removed_at") @db.Timestamptz(6)
  removedById     String?           @map("removed_by_id") @db.Uuid
  org             Organization      @relation(fields: [orgId], references: [id], onDelete: Restrict)
  statementLine   BankStatementLine @relation(fields: [statementLineId, orgId], references: [id, orgId], onDelete: Restrict)
  journalLine     JournalLine       @relation(fields: [journalLineId, orgId], references: [id, orgId], onDelete: Restrict)

  @@index([orgId, statementLineId])
  @@index([orgId, journalLineId])
  @@map("bank_matches")
}

model BankReconciliation {
  id               String               @id @default(uuid()) @db.Uuid
  orgId            String               @map("org_id") @db.Uuid
  accountId        String               @map("account_id") @db.Uuid
  startDate        DateTime             @map("start_date") @db.Date
  statementDate    DateTime             @map("statement_date") @db.Date
  openingBalance   Decimal              @map("opening_balance") @db.Decimal(24, 6)
  statementBalance Decimal              @map("statement_balance") @db.Decimal(24, 6)
  ledgerBalance    Decimal              @map("ledger_balance") @db.Decimal(24, 6)
  uncleared        Decimal              @db.Decimal(24, 6)
  status           ReconciliationStatus @default(COMPLETED)
  completedById    String               @map("completed_by_id") @db.Uuid
  completedAt      DateTime             @default(now()) @map("completed_at") @db.Timestamptz(6)
  undoneById       String?              @map("undone_by_id") @db.Uuid
  undoneAt         DateTime?            @map("undone_at") @db.Timestamptz(6)
  undoReason       String?              @map("undo_reason")
  org              Organization         @relation(fields: [orgId], references: [id], onDelete: Restrict)
  account          Account              @relation(fields: [accountId, orgId], references: [id, orgId], onDelete: Restrict)
  lines            BankStatementLine[]

  @@unique([id, orgId])
  @@index([orgId, accountId, statementDate])
  @@map("bank_reconciliations")
}

/// A file kept as evidence for a record (receipt, supplier invoice, contract).
/// Bytes never change; removal is a soft delete with a reason.
model Attachment {
  id            String           @id @default(uuid()) @db.Uuid
  orgId         String           @map("org_id") @db.Uuid
  entityType    AttachmentEntity @map("entity_type")
  entityId      String           @map("entity_id") @db.Uuid
  fileName      String           @map("file_name")
  contentType   String           @map("content_type")
  sizeBytes     Int              @map("size_bytes")
  sha256        String
  content       Bytes
  uploadedById  String           @map("uploaded_by_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  removedAt     DateTime?        @map("removed_at") @db.Timestamptz(6)
  removedById   String?          @map("removed_by_id") @db.Uuid
  removedReason String?          @map("removed_reason")
  org           Organization     @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@unique([id, orgId])
  @@index([orgId, entityType, entityId])
  @@map("attachments")
}

/// Documents of this kind at or above min_amount must be approved before they post.
model ApprovalPolicy {
  id                       String       @id @default(uuid()) @db.Uuid
  orgId                    String       @map("org_id") @db.Uuid
  documentKind             DocumentKind @map("document_kind")
  minAmount                Decimal      @map("min_amount") @db.Decimal(24, 6)
  requireDifferentApprover Boolean      @default(true) @map("require_different_approver")
  isActive                 Boolean      @default(true) @map("is_active")
  updatedById              String       @map("updated_by_id") @db.Uuid
  createdAt                DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  org                      Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@unique([orgId, documentKind])
  @@map("approval_policies")
}

/// One request to approve a draft document. Never deleted. Editing the draft cancels it (trigger).
model ApprovalRequest {
  id            String         @id @default(uuid()) @db.Uuid
  orgId         String         @map("org_id") @db.Uuid
  documentId    String?        @map("document_id") @db.Uuid
  documentKind  DocumentKind   @map("document_kind")
  contactName   String         @map("contact_name")
  total         Decimal        @db.Decimal(24, 6)
  status        ApprovalStatus @default(PENDING)
  note          String?
  requestedById String         @map("requested_by_id") @db.Uuid
  requestedAt   DateTime       @default(now()) @map("requested_at") @db.Timestamptz(6)
  decidedById   String?        @map("decided_by_id") @db.Uuid
  decidedAt     DateTime?      @map("decided_at") @db.Timestamptz(6)
  decisionNote  String?        @map("decision_note")
  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Restrict)
  document      Document?      @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@unique([id, orgId])
  @@index([orgId, status])
  @@index([documentId])
  @@map("approval_requests")
}

enum ExpenseClaimStatus {
  DRAFT
  SUBMITTED
  REJECTED
  APPROVED
  REIMBURSED
  VOID
}

/// An employee's request to be paid back for money they spent. Approving posts it; reimbursing pays it.
model ExpenseClaim {
  id                          String             @id @default(uuid()) @db.Uuid
  orgId                       String             @map("org_id") @db.Uuid
  number                      String
  claimantId                  String             @map("claimant_id") @db.Uuid
  title                       String
  currency                    String             @db.Char(3)
  status                      ExpenseClaimStatus @default(DRAFT)
  netTotal                    Decimal            @map("net_total") @db.Decimal(24, 6)
  taxTotal                    Decimal            @map("tax_total") @db.Decimal(24, 6)
  total                       Decimal            @db.Decimal(24, 6)
  submittedAt                 DateTime?          @map("submitted_at") @db.Timestamptz(6)
  decidedById                 String?            @map("decided_by_id") @db.Uuid
  decidedAt                   DateTime?          @map("decided_at") @db.Timestamptz(6)
  decisionNote                String?            @map("decision_note")
  journalEntryId              String?            @unique @map("journal_entry_id") @db.Uuid
  postingDate                 DateTime?          @map("posting_date") @db.Date
  reimbursementJournalEntryId String?            @unique @map("reimbursement_journal_entry_id") @db.Uuid
  reimbursedOn                DateTime?          @map("reimbursed_on") @db.Date
  reimbursedById              String?            @map("reimbursed_by_id") @db.Uuid
  bankAccountId               String?            @map("bank_account_id") @db.Uuid
  reimbursementReference      String?            @map("reimbursement_reference")
  voidJournalEntryId          String?            @unique @map("void_journal_entry_id") @db.Uuid
  voidDate                    DateTime?          @map("void_date") @db.Date
  voidReason                  String?            @map("void_reason")
  createdAt                   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  org                         Organization       @relation(fields: [orgId], references: [id], onDelete: Restrict)
  lines                       ExpenseClaimLine[]

  @@unique([id, orgId])
  @@unique([orgId, number])
  @@index([orgId, status])
  @@index([orgId, claimantId])
  @@map("expense_claims")
}

model ExpenseClaimLine {
  id          String       @id @default(uuid()) @db.Uuid
  orgId       String       @map("org_id") @db.Uuid
  claimId     String       @map("claim_id") @db.Uuid
  lineNo      Int          @map("line_no")
  date        DateTime     @db.Date
  accountId   String       @map("account_id") @db.Uuid
  merchant    String?
  description String?
  amount      Decimal      @db.Decimal(24, 6)
  taxRateId   String?      @map("tax_rate_id") @db.Uuid
  taxRate     Decimal      @default(0) @map("tax_rate") @db.Decimal(9, 6)
  netAmount   Decimal      @map("net_amount") @db.Decimal(24, 6)
  taxAmount   Decimal      @map("tax_amount") @db.Decimal(24, 6)
  claim       ExpenseClaim @relation(fields: [claimId, orgId], references: [id, orgId], onDelete: Cascade)
  account     Account      @relation(fields: [accountId, orgId], references: [id, orgId], onDelete: Restrict)
  tax         TaxRate?     @relation(fields: [taxRateId, orgId], references: [id, orgId], onDelete: Restrict)

  @@unique([claimId, lineNo])
  @@map("expense_claim_lines")
}

/// India GST registration of an organisation (one per organisation for now) and the
/// accounts its tax posts to. Account foreign keys are enforced in SQL.
model GstRegistration {
  orgId               String       @id @map("org_id") @db.Uuid
  gstin               String
  legalName           String?      @map("legal_name")
  /// First two characters of the GSTIN.
  stateCode           String       @map("state_code") @db.Char(2)
  /// GST rates may be used on documents dated on or after this date.
  effectiveFrom       DateTime     @map("effective_from") @db.Date
  outputCgstAccountId String       @map("output_cgst_account_id") @db.Uuid
  outputSgstAccountId String       @map("output_sgst_account_id") @db.Uuid
  outputIgstAccountId String       @map("output_igst_account_id") @db.Uuid
  inputCgstAccountId  String       @map("input_cgst_account_id") @db.Uuid
  inputSgstAccountId  String       @map("input_sgst_account_id") @db.Uuid
  inputIgstAccountId  String       @map("input_igst_account_id") @db.Uuid
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  org                 Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@map("gst_registrations")
}

enum WithholdingKind {
  TDS
  TCS
}

enum ThresholdWindow {
  TAX_YEAR
  MONTH
}

enum ThresholdBasis {
  WHOLE
  EXCESS
}

/// India income-tax withholding: the organisation's TAN and where TDS and TCS post.
model WithholdingSettings {
  orgId               String       @id @map("org_id") @db.Uuid
  tan                 String       @db.Char(10)
  tdsPayableAccountId String       @map("tds_payable_account_id") @db.Uuid
  tcsPayableAccountId String       @map("tcs_payable_account_id") @db.Uuid
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  org                 Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@map("withholding_settings")
}

/// A TDS or TCS provision as the organisation applies it. Rates and thresholds cannot change; create a new section.
model WithholdingSection {
  id                 String          @id @default(uuid()) @db.Uuid
  orgId              String          @map("org_id") @db.Uuid
  kind               WithholdingKind
  code               String
  name               String
  rate               Decimal         @db.Decimal(9, 6)
  rateIndividualHuf  Decimal?        @map("rate_individual_huf") @db.Decimal(9, 6)
  rateNoPan          Decimal         @map("rate_no_pan") @db.Decimal(9, 6)
  singleThreshold    Decimal?        @map("single_threshold") @db.Decimal(24, 6)
  aggregateThreshold Decimal?        @map("aggregate_threshold") @db.Decimal(24, 6)
  thresholdWindow    ThresholdWindow @map("threshold_window")
  thresholdBasis     ThresholdBasis  @map("threshold_basis")
  /// Documents dated before this cannot use the section.
  validFrom          DateTime        @map("valid_from") @db.Date
  source             String?
  isActive           Boolean         @default(true) @map("is_active")
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  org                Organization    @relation(fields: [orgId], references: [id], onDelete: Restrict)
  documents          Document[]

  @@unique([orgId, kind, code])
  @@unique([id, orgId])
  @@map("withholding_sections")
}

/// A payment of TDS or TCS to the government (a challan), covering the deductions on the documents listed.
model WithholdingDeposit {
  id                 String                   @id @default(uuid()) @db.Uuid
  orgId              String                   @map("org_id") @db.Uuid
  kind               WithholdingKind
  number             String
  depositDate        DateTime                 @map("deposit_date") @db.Date
  bankAccountId      String                   @map("bank_account_id") @db.Uuid
  /// Challan identification (for example the CIN or BSR code and serial number).
  challanReference   String                   @map("challan_reference")
  taxAmount          Decimal                  @map("tax_amount") @db.Decimal(24, 6)
  interestAmount     Decimal                  @default(0) @map("interest_amount") @db.Decimal(24, 6)
  interestAccountId  String?                  @map("interest_account_id") @db.Uuid
  memo               String?
  status             PaymentStatus            @default(POSTED)
  journalEntryId     String                   @unique @map("journal_entry_id") @db.Uuid
  voidJournalEntryId String?                  @unique @map("void_journal_entry_id") @db.Uuid
  voidDate           DateTime?                @map("void_date") @db.Date
  voidReason         String?                  @map("void_reason")
  createdById        String                   @map("created_by_id") @db.Uuid
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  org                Organization             @relation(fields: [orgId], references: [id], onDelete: Restrict)
  items              WithholdingDepositItem[]

  @@unique([orgId, kind, number])
  @@unique([id, orgId])
  @@map("withholding_deposits")
}

model WithholdingDepositItem {
  id         String             @id @default(uuid()) @db.Uuid
  orgId      String             @map("org_id") @db.Uuid
  depositId  String             @map("deposit_id") @db.Uuid
  documentId String             @map("document_id") @db.Uuid
  amount     Decimal            @db.Decimal(24, 6)
  /// False once the deposit is voided; a document is in at most one active deposit.
  active     Boolean            @default(true)
  deposit    WithholdingDeposit @relation(fields: [depositId, orgId], references: [id, orgId], onDelete: Restrict)
  document   Document           @relation(fields: [documentId, orgId], references: [id, orgId], onDelete: Restrict)

  @@index([orgId, documentId])
  @@map("withholding_deposit_items")
}

// ---------------------------------------------------------------- payroll (India)

enum PayComponentKind {
  WAGES
  EXCLUDED
}

enum PtCategory {
  GENERAL
  WOMAN
  EXEMPT
}

enum PayRunStatus {
  DRAFT
  POSTED
  VOID
}

enum PayrollLiability {
  NET_PAY
  PF
  ESI
  PT
  TDS
}

/// Registrations and the accounts a pay run posts to.
model PayrollSettings {
  orgId                         String       @id @map("org_id") @db.Uuid
  pfEstablishmentCode           String?      @map("pf_establishment_code")
  esiEmployerCode               String?      @map("esi_employer_code")
  ptRegistration                String?      @map("pt_registration")
  salaryExpenseAccountId        String       @map("salary_expense_account_id") @db.Uuid
  employerContributionAccountId String       @map("employer_contribution_account_id") @db.Uuid
  netPayAccountId               String       @map("net_pay_account_id") @db.Uuid
  pfPayableAccountId            String       @map("pf_payable_account_id") @db.Uuid
  esiPayableAccountId           String       @map("esi_payable_account_id") @db.Uuid
  ptPayableAccountId            String       @map("pt_payable_account_id") @db.Uuid
  tdsPayableAccountId           String       @map("tds_payable_account_id") @db.Uuid
  createdAt                     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  org                           Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@map("payroll_settings")
}

model Employee {
  id            String            @id @default(uuid()) @db.Uuid
  orgId         String            @map("org_id") @db.Uuid
  code          String
  name          String
  email         String?
  pan           String?           @db.Char(10)
  dateOfJoining DateTime          @map("date_of_joining") @db.Date
  dateOfLeaving DateTime?         @map("date_of_leaving") @db.Date
  /// State whose professional tax applies (GST state code).
  workStateCode String?           @map("work_state_code") @db.Char(2)
  ptCategory    PtCategory        @default(GENERAL) @map("pt_category")
  pfMember      Boolean           @default(true) @map("pf_member")
  epsMember     Boolean           @default(true) @map("eps_member")
  /// PF on wages above the ceiling, by agreement between employer and employee.
  pfOnFullWages Boolean           @default(false) @map("pf_on_full_wages")
  uan           String?
  esiNumber     String?           @map("esi_number")
  /// Salary and tax from a previous employer in the tax year of joining.
  priorTaxYear  String?           @map("prior_tax_year")
  priorIncome   Decimal           @default(0) @map("prior_income") @db.Decimal(24, 6)
  priorTds      Decimal           @default(0) @map("prior_tds") @db.Decimal(24, 6)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  org           Organization      @relation(fields: [orgId], references: [id], onDelete: Restrict)
  structures    SalaryStructure[]
  payslips      Payslip[]

  @@unique([orgId, code])
  @@unique([id, orgId])
  @@map("employees")
}

/// Monthly pay from a given month. Never changed: a revision is a new structure from a later month.
model SalaryStructure {
  id            String            @id @default(uuid()) @db.Uuid
  orgId         String            @map("org_id") @db.Uuid
  employeeId    String            @map("employee_id") @db.Uuid
  effectiveFrom DateTime          @map("effective_from") @db.Date
  createdById   String            @map("created_by_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  employee      Employee          @relation(fields: [employeeId, orgId], references: [id, orgId], onDelete: Restrict)
  components    SalaryComponent[]
  payslips      Payslip[]

  @@unique([employeeId, effectiveFrom])
  @@unique([id, orgId])
  @@map("salary_structures")
}

model SalaryComponent {
  id            String           @id @default(uuid()) @db.Uuid
  orgId         String           @map("org_id") @db.Uuid
  structureId   String           @map("structure_id") @db.Uuid
  position      Int              @db.SmallInt
  code          String
  name          String
  kind          PayComponentKind
  monthlyAmount Decimal          @map("monthly_amount") @db.Decimal(24, 6)
  structure     SalaryStructure  @relation(fields: [structureId, orgId], references: [id, orgId], onDelete: Restrict)

  @@unique([structureId, code])
  @@map("salary_components")
}

/// One month's payroll. Draft payslips are recalculated freely; posting freezes them and posts one journal.
model PayRun {
  id                 String              @id @default(uuid()) @db.Uuid
  orgId              String              @map("org_id") @db.Uuid
  number             String
  /// YYYY-MM
  period             String              @db.Char(7)
  status             PayRunStatus        @default(DRAFT)
  payDate            DateTime            @map("pay_date") @db.Date
  gross              Decimal             @default(0) @db.Decimal(24, 6)
  deductions         Decimal             @default(0) @db.Decimal(24, 6)
  net                Decimal             @default(0) @db.Decimal(24, 6)
  employerCost       Decimal             @default(0) @map("employer_cost") @db.Decimal(24, 6)
  journalEntryId     String?             @unique @map("journal_entry_id") @db.Uuid
  postedAt           DateTime?           @map("posted_at") @db.Timestamptz(6)
  postedById         String?             @map("posted_by_id") @db.Uuid
  voidJournalEntryId String?             @unique @map("void_journal_entry_id") @db.Uuid
  voidDate           DateTime?           @map("void_date") @db.Date
  voidReason         String?             @map("void_reason")
  createdById        String              @map("created_by_id") @db.Uuid
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  org                Organization        @relation(fields: [orgId], references: [id], onDelete: Restrict)
  payslips           Payslip[]
  remittances        PayrollRemittance[]

  @@unique([orgId, number])
  @@unique([id, orgId])
  @@map("pay_runs")
}

model Payslip {
  id             String          @id @default(uuid()) @db.Uuid
  orgId          String          @map("org_id") @db.Uuid
  payRunId       String          @map("pay_run_id") @db.Uuid
  employeeId     String          @map("employee_id") @db.Uuid
  structureId    String          @map("structure_id") @db.Uuid
  daysInMonth    Int             @map("days_in_month") @db.SmallInt
  /// Days not worked before joining or after leaving.
  daysOutside    Decimal         @default(0) @map("days_outside") @db.Decimal(4, 1)
  lopDays        Decimal         @default(0) @map("lop_days") @db.Decimal(4, 1)
  paidDays       Decimal         @map("paid_days") @db.Decimal(4, 1)
  /// One-off earnings this month: [{ name, kind, amount }].
  oneOffs        Json            @default("[]") @map("one_offs")
  /// Earnings as paid: [{ code, name, kind, amount }].
  earnings       Json
  gross          Decimal         @db.Decimal(24, 6)
  wages          Decimal         @db.Decimal(24, 6)
  wagesAddedBack Decimal         @map("wages_added_back") @db.Decimal(24, 6)
  pfWages        Decimal         @map("pf_wages") @db.Decimal(24, 6)
  pfEmployee     Decimal         @map("pf_employee") @db.Decimal(24, 6)
  eps            Decimal         @db.Decimal(24, 6)
  epfEmployer    Decimal         @map("epf_employer") @db.Decimal(24, 6)
  edli           Decimal         @db.Decimal(24, 6)
  pfAdmin        Decimal         @map("pf_admin") @db.Decimal(24, 6)
  esiCovered     Boolean         @map("esi_covered")
  esiWages       Decimal         @map("esi_wages") @db.Decimal(24, 6)
  esiEmployee    Decimal         @map("esi_employee") @db.Decimal(24, 6)
  esiEmployer    Decimal         @map("esi_employer") @db.Decimal(24, 6)
  pt             Decimal         @db.Decimal(24, 6)
  ptNote         String          @map("pt_note")
  tds            Decimal         @db.Decimal(24, 6)
  /// How the month's TDS was worked out: projected income, taxable income, annual tax, note.
  tdsDetail      Json            @map("tds_detail")
  deductions     Decimal         @db.Decimal(24, 6)
  net            Decimal         @db.Decimal(24, 6)
  employerCost   Decimal         @map("employer_cost") @db.Decimal(24, 6)
  payRun         PayRun          @relation(fields: [payRunId, orgId], references: [id, orgId], onDelete: Cascade)
  employee       Employee        @relation(fields: [employeeId, orgId], references: [id, orgId], onDelete: Restrict)
  structure      SalaryStructure @relation(fields: [structureId, orgId], references: [id, orgId], onDelete: Restrict)

  @@unique([payRunId, employeeId])
  @@index([orgId, employeeId])
  @@map("payslips")
}

/// Paying out what a posted pay run owes: net salaries, or PF, ESI, professional tax or TDS to the authority.
model PayrollRemittance {
  id                 String           @id @default(uuid()) @db.Uuid
  orgId              String           @map("org_id") @db.Uuid
  payRunId           String           @map("pay_run_id") @db.Uuid
  liability          PayrollLiability
  number             String
  date               DateTime         @db.Date
  bankAccountId      String           @map("bank_account_id") @db.Uuid
  reference          String
  amount             Decimal          @db.Decimal(24, 6)
  status             PaymentStatus    @default(POSTED)
  journalEntryId     String           @unique @map("journal_entry_id") @db.Uuid
  voidJournalEntryId String?          @unique @map("void_journal_entry_id") @db.Uuid
  voidDate           DateTime?        @map("void_date") @db.Date
  voidReason         String?          @map("void_reason")
  createdById        String           @map("created_by_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  payRun             PayRun           @relation(fields: [payRunId, orgId], references: [id, orgId], onDelete: Restrict)

  @@unique([orgId, number])
  @@index([payRunId])
  @@map("payroll_remittances")
}

// ---------------------------------------------------------------- compliance calendar (M3)

enum GstReturnFrequency {
  MONTHLY
  QUARTERLY
}

/// What the compliance calendar needs beyond the GST, TDS/TCS and payroll set-up.
model ComplianceSettings {
  orgId              String             @id @map("org_id") @db.Uuid
  /// QUARTERLY: the QRMP scheme (quarterly GSTR-1 and GSTR-3B, monthly PMT-06).
  gstReturnFrequency GstReturnFrequency @default(MONTHLY) @map("gst_return_frequency")
  /// Advance income tax instalments from this date; NULL when not tracked.
  advanceTaxFrom     DateTime?          @map("advance_tax_from") @db.Date
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  org                Organization       @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@map("compliance_settings")
}

enum ComplianceFilingStatus {
  FILED
  VOID
}

/// A return marked filed (or an advance tax instalment marked paid) with its acknowledgement. Never changed except once to VOID.
model ComplianceFiling {
  id            String                 @id @default(uuid()) @db.Uuid
  orgId         String                 @map("org_id") @db.Uuid
  /// Obligation key from the calendar, for example GSTR3B:2026-10.
  obligationKey String                 @map("obligation_key")
  kind          String
  period        String
  dueDate       DateTime               @map("due_date") @db.Date
  filedOn       DateTime               @map("filed_on") @db.Date
  /// ARN, token number or challan identification.
  reference     String
  note          String?
  status        ComplianceFilingStatus @default(FILED)
  createdById   String                 @map("created_by_id") @db.Uuid
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  voidedById    String?                @map("voided_by_id") @db.Uuid
  voidedAt      DateTime?              @map("voided_at") @db.Timestamptz(6)
  voidReason    String?                @map("void_reason")
  org           Organization           @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@index([orgId, obligationKey])
  @@map("compliance_filings")
}

// ---------------------------------------------------------------- e-invoicing (M3)

/// E-invoicing for the organisation's GST registration: from when, the seller address on the IRP, and the IRP key.
model EInvoiceSettings {
  orgId              String       @id @map("org_id") @db.Uuid
  /// B2B invoices and credit notes dated on or after this need an IRN.
  applicableFrom     DateTime     @map("applicable_from") @db.Date
  /// Aggregate annual turnover of Rs 10 crore or more: the 30-day reporting limit applies.
  aatoTenCroreOrMore Boolean      @default(false) @map("aato_ten_crore_or_more")
  tradeName          String?      @map("trade_name")
  address1           String
  address2           String?
  city               String
  pincode            String       @db.Char(6)
  /// UQC for goods lines, for example NOS.
  goodsUnit          String       @default("NOS") @map("goods_unit")
  /// The IRP's public key (PEM); when set, signed QR codes are verified with it.
  irpPublicKey       String?      @map("irp_public_key")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  org                Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@map("e_invoice_settings")
}

enum EInvoiceStatus {
  ACTIVE
  CANCELLED
}

/// An IRN the IRP issued for a document, as imported from its response. Never changed except to record a cancellation.
model EInvoice {
  id                String         @id @default(uuid()) @db.Uuid
  orgId             String         @map("org_id") @db.Uuid
  documentId        String         @map("document_id") @db.Uuid
  irn               String         @db.Char(64)
  ackNo             String         @map("ack_no")
  ackDate           DateTime       @map("ack_date") @db.Timestamptz(6)
  signedQrCode      String         @map("signed_qr_code")
  signedInvoice     String?        @map("signed_invoice")
  /// True when the QR code's signature was checked with the IRP key in the settings.
  signatureVerified Boolean        @default(false) @map("signature_verified")
  /// SHA-256 of the JSON Talk2Tax generated for the document when the response was imported.
  payloadHash       String         @map("payload_hash") @db.Char(64)
  status            EInvoiceStatus @default(ACTIVE)
  cancelledAt       DateTime?      @map("cancelled_at") @db.Timestamptz(6)
  cancelReason      String?        @map("cancel_reason") @db.Char(1)
  cancelRemark      String?        @map("cancel_remark")
  createdById       String         @map("created_by_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  cancelledById     String?        @map("cancelled_by_id") @db.Uuid
  org               Organization   @relation(fields: [orgId], references: [id], onDelete: Restrict)
  document          Document       @relation(fields: [documentId, orgId], references: [id, orgId], onDelete: Restrict)

  @@unique([orgId, irn])
  @@index([documentId])
  @@map("e_invoices")
}

/// E-way bill set-up (India, CGST Rule 138): thresholds and the place goods are dispatched from.
model EWayBillSettings {
  orgId               String       @id @map("org_id") @db.Uuid
  /// Consignment value above which an e-way bill is needed (Rs 50,000 under Rule 138(1)).
  threshold           Decimal      @default(50000) @db.Decimal(18, 2)
  /// The organisation's state's own threshold for movement within the state, when it has one.
  intraStateThreshold Decimal?     @map("intra_state_threshold") @db.Decimal(18, 2)
  address1            String
  address2            String?
  city                String
  pincode             String       @db.Char(6)
  /// UQC for goods lines, for example NOS.
  goodsUnit           String       @default("NOS") @map("goods_unit")
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  org                 Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@map("e_way_bill_settings")
}

enum EWayBillStatus {
  ACTIVE
  CANCELLED
}

enum TransportMode {
  ROAD
  RAIL
  AIR
  SHIP
}

/// An e-way bill generated on the portal for an invoice, as recorded by the user. Never edited:
/// Part B changes are separate rows, and the only change is a single move to CANCELLED.
model EWayBill {
  id              String                  @id @default(uuid()) @db.Uuid
  orgId           String                  @map("org_id") @db.Uuid
  documentId      String                  @map("document_id") @db.Uuid
  /// The 12-digit e-way bill number.
  number          String                  @db.Char(12)
  generatedAt     DateTime                @map("generated_at") @db.Timestamptz(6)
  /// As the portal shows it; null while there is no Part B.
  validUntil      DateTime?               @map("valid_until") @db.Timestamptz(6)
  distanceKm      Int                     @map("distance_km")
  /// R regular, O over-dimensional cargo.
  vehicleType     String                  @default("R") @map("vehicle_type") @db.Char(1)
  /// null: Part A only.
  transportMode   TransportMode?          @map("transport_mode")
  vehicleNo       String?                 @map("vehicle_no")
  transporterId   String?                 @map("transporter_id") @db.Char(15)
  transporterName String?                 @map("transporter_name")
  transDocNo      String?                 @map("trans_doc_no")
  transDocDate    DateTime?               @map("trans_doc_date") @db.Date
  /// SHA-256 of the JSON Talk2Tax generated with these details.
  payloadHash     String                  @map("payload_hash") @db.Char(64)
  status          EWayBillStatus          @default(ACTIVE)
  cancelledAt     DateTime?               @map("cancelled_at") @db.Timestamptz(6)
  cancelReason    String?                 @map("cancel_reason") @db.Char(1)
  cancelRemark    String?                 @map("cancel_remark")
  createdById     String                  @map("created_by_id") @db.Uuid
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  cancelledById   String?                 @map("cancelled_by_id") @db.Uuid
  org             Organization            @relation(fields: [orgId], references: [id], onDelete: Restrict)
  document        Document                @relation(fields: [documentId, orgId], references: [id, orgId], onDelete: Restrict)
  vehicleUpdates  EWayBillVehicleUpdate[]

  @@unique([id, orgId])
  @@unique([orgId, number])
  @@index([documentId])
  @@map("e_way_bills")
}

/// A Part B update made on the portal (first vehicle, breakdown, transhipment). Append-only.
model EWayBillVehicleUpdate {
  id            String        @id @default(uuid()) @db.Uuid
  orgId         String        @map("org_id") @db.Uuid
  eWayBillId    String        @map("e_way_bill_id") @db.Uuid
  updatedAt     DateTime      @map("updated_at") @db.Timestamptz(6)
  transportMode TransportMode @map("transport_mode")
  vehicleNo     String?       @map("vehicle_no")
  transDocNo    String?       @map("trans_doc_no")
  transDocDate  DateTime?     @map("trans_doc_date") @db.Date
  fromPlace     String        @map("from_place")
  fromStateCode String        @map("from_state_code") @db.Char(2)
  reason        String        @db.Char(1)
  remark        String
  /// Validity the portal shows after the update (set on the first Part B).
  validUntil    DateTime?     @map("valid_until") @db.Timestamptz(6)
  createdById   String        @map("created_by_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  org           Organization  @relation(fields: [orgId], references: [id], onDelete: Restrict)
  eWayBill      EWayBill      @relation(fields: [eWayBillId, orgId], references: [id, orgId], onDelete: Restrict)

  @@index([eWayBillId])
  @@map("e_way_bill_vehicle_updates")
}

// ---------------------------------------------------------------- budgets (M4)

enum BudgetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  SUPERSEDED
}

/// One version of a fiscal year's budget. Versions are numbered per year; a new version
/// starts empty, from another version or from last year's actuals. Only drafts change.
/// At most one version per year is APPROVED; approving another supersedes it.
model Budget {
  id             String       @id @default(uuid()) @db.Uuid
  orgId          String       @map("org_id") @db.Uuid
  /// Labelled by the calendar year the fiscal year ends in (FY2027 = Apr 2026 to Mar 2027).
  fiscalYear     Int          @map("fiscal_year")
  version        Int
  name           String
  note           String?
  /// EMPTY, COPY (of sourceBudgetId) or PRIOR_ACTUALS (with changePercent).
  basis          String
  sourceBudgetId String?      @map("source_budget_id") @db.Uuid
  changePercent  Decimal?     @map("change_percent") @db.Decimal(7, 2)
  status         BudgetStatus @default(DRAFT)
  createdById    String       @map("created_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  submittedById  String?      @map("submitted_by_id") @db.Uuid
  submittedAt    DateTime?    @map("submitted_at") @db.Timestamptz(6)
  approvedById   String?      @map("approved_by_id") @db.Uuid
  approvedAt     DateTime?    @map("approved_at") @db.Timestamptz(6)
  supersededAt   DateTime?    @map("superseded_at") @db.Timestamptz(6)
  /// The last time it was sent back, by whom and why (the audit trail keeps every one).
  returnedById   String?      @map("returned_by_id") @db.Uuid
  returnedAt     DateTime?    @map("returned_at") @db.Timestamptz(6)
  returnReason   String?      @map("return_reason")
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  lines          BudgetLine[]

  @@unique([orgId, fiscalYear, version])
  @@unique([id, orgId])
  @@map("budgets")
}

/// One account's amount for one month of a budget, on the account's normal side.
model BudgetLine {
  id        String       @id @default(uuid()) @db.Uuid
  orgId     String       @map("org_id") @db.Uuid
  budgetId  String       @map("budget_id") @db.Uuid
  accountId String       @map("account_id") @db.Uuid
  periodNo  Int          @map("period_no") @db.SmallInt
  amount    Decimal      @db.Decimal(18, 2)
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  budget    Budget       @relation(fields: [budgetId, orgId], references: [id, orgId], onDelete: Restrict)
  account   Account      @relation(fields: [accountId, orgId], references: [id, orgId], onDelete: Restrict)

  @@unique([budgetId, accountId, periodNo])
  @@index([accountId])
  @@map("budget_lines")
}

// ---------------------------------------------------------------- cash-flow forecast (M4)

/// The cash balance below which the forecast warns.
model CashFlowSettings {
  orgId          String       @id @map("org_id") @db.Uuid
  minimumBalance Decimal      @default(0) @map("minimum_balance") @db.Decimal(18, 2)
  updatedById    String       @map("updated_by_id") @db.Uuid
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@map("cash_flow_settings")
}

enum CashFlowDirection {
  IN
  OUT
}

enum PlannedFrequency {
  ONCE
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

/// A receipt or payment the books do not hold yet: rent, a loan instalment, tax, a planned sale.
model CashFlowItem {
  id          String            @id @default(uuid()) @db.Uuid
  orgId       String            @map("org_id") @db.Uuid
  name        String
  direction   CashFlowDirection
  amount      Decimal           @db.Decimal(18, 2)
  frequency   PlannedFrequency
  startDate   DateTime          @map("start_date") @db.Date
  endDate     DateTime?         @map("end_date") @db.Date
  note        String?
  isActive    Boolean           @default(true) @map("is_active")
  createdById String            @map("created_by_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  org         Organization      @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@unique([id, orgId])
  @@index([orgId])
  @@map("cash_flow_items")
}

/// A forecast as it was worked out on a day, kept unchanged so it can be compared with what
/// happened. A backtest is worked out as of an earlier date from the records dated up to it.
model CashForecast {
  id             String       @id @default(uuid()) @db.Uuid
  orgId          String       @map("org_id") @db.Uuid
  asOf           DateTime     @map("as_of") @db.Date
  horizonDays    Int          @map("horizon_days")
  isBacktest     Boolean      @map("is_backtest")
  opening        Decimal      @db.Decimal(18, 2)
  closingBase    Decimal      @map("closing_base") @db.Decimal(18, 2)
  minimumBalance Decimal?     @map("minimum_balance") @db.Decimal(18, 2)
  /// [{ date, base, low, high }] for every day of the horizon.
  days           Json
  /// What went in: totals by kind, item counts and the payment delays used.
  inputs         Json
  note           String?
  createdById    String       @map("created_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@index([orgId, createdAt])
  @@map("cash_forecasts")
}

enum KpiComparator {
  AT_LEAST
  AT_MOST
}

/// A target for one KPI: the value it should be at least or at most.
model KpiTarget {
  id          String        @id @default(uuid()) @db.Uuid
  orgId       String        @map("org_id") @db.Uuid
  kpi         String        @db.VarChar(40)
  comparator  KpiComparator
  target      Decimal       @db.Decimal(20, 4)
  note        String?       @db.VarChar(500)
  updatedById String        @map("updated_by_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  org         Organization  @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@unique([orgId, kpi])
  @@map("kpi_targets")
}

enum ManagementReportStatus {
  DRAFT
  FINAL
}

/// The monthly management report: commentary while a draft; once final, a frozen copy of
/// its figures that later postings cannot change.
model ManagementReport {
  id            String                 @id @default(uuid()) @db.Uuid
  orgId         String                 @map("org_id") @db.Uuid
  /// The first day of the month reported on.
  month         DateTime               @db.Date
  commentary    String                 @default("")
  status        ManagementReportStatus @default(DRAFT)
  snapshot      Json?
  finalisedById String?                @map("finalised_by_id") @db.Uuid
  finalisedAt   DateTime?              @map("finalised_at") @db.Timestamptz(6)
  updatedById   String                 @map("updated_by_id") @db.Uuid
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  org           Organization           @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@unique([orgId, month])
  @@map("management_reports")
}

enum AlertSeverity {
  CRITICAL
  WARNING
  INFO
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  DISMISSED
  CLEARED
}

enum AlertAction {
  OPENED
  ACKNOWLEDGED
  DISMISSED
  REOPENED
  CLEARED
}

/// An organisation's settings for one alert check: on or off, and its thresholds.
model AlertRuleSetting {
  id          String       @id @default(uuid()) @db.Uuid
  orgId       String       @map("org_id") @db.Uuid
  rule        String       @db.VarChar(40)
  enabled     Boolean      @default(true)
  /// Threshold values as decimal strings, by setting key.
  params      Json         @default("{}")
  updatedById String       @map("updated_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@unique([orgId, rule])
  @@map("alert_rule_settings")
}

/// Something a check found. One row per rule and finding (fingerprint) for the life of the
/// organisation: it clears when no longer found, reopens when found again, and a dismissed
/// alert stays dismissed.
model Alert {
  id          String        @id @default(uuid()) @db.Uuid
  orgId       String        @map("org_id") @db.Uuid
  rule        String        @db.VarChar(40)
  fingerprint String        @db.VarChar(200)
  severity    AlertSeverity
  title       String        @db.VarChar(300)
  summary     String        @db.VarChar(2000)
  /// The amount at stake, in the functional currency, when there is one.
  amount      Decimal?      @db.Decimal(24, 6)
  /// The figures and records the alert was raised on.
  evidence    Json
  status      AlertStatus   @default(OPEN)
  /// The acknowledgement note or the reason for dismissing.
  statusNote  String?       @map("status_note") @db.VarChar(1000)
  statusById  String?       @map("status_by_id") @db.Uuid
  statusAt    DateTime?     @map("status_at") @db.Timestamptz(6)
  firstSeenAt DateTime      @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt  DateTime      @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  clearedAt   DateTime?     @map("cleared_at") @db.Timestamptz(6)
  reopenCount Int           @default(0) @map("reopen_count")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  org         Organization  @relation(fields: [orgId], references: [id], onDelete: Restrict)
  events      AlertEvent[]

  @@unique([orgId, rule, fingerprint])
  @@unique([id, orgId])
  @@index([orgId, status])
  @@map("alerts")
}

/// The history of an alert. Append-only. No actor = the checks did it.
model AlertEvent {
  id        String       @id @default(uuid()) @db.Uuid
  orgId     String       @map("org_id") @db.Uuid
  alertId   String       @map("alert_id") @db.Uuid
  action    AlertAction
  actorId   String?      @map("actor_id") @db.Uuid
  note      String?      @db.VarChar(1000)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  alert     Alert        @relation(fields: [alertId, orgId], references: [id, orgId], onDelete: Restrict)

  @@index([orgId, alertId])
  @@map("alert_events")
}

/// Who hears about new alerts: an alert opened or reopened at or above `minSeverity` becomes a
/// task for `taskRole`, due in `dueDays`. No row means the default: critical alerts, owners, due today.
model AlertNotificationSetting {
  id          String       @id @default(uuid()) @db.Uuid
  orgId       String       @unique @map("org_id") @db.Uuid
  /// CRITICAL, WARNING or OFF
  minSeverity String       @map("min_severity") @db.VarChar(10)
  taskRole    String       @map("task_role") @db.VarChar(20)
  dueDays     Int          @map("due_days")
  updatedById String       @map("updated_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@map("alert_notification_settings")
}

/// One run of the checks. Append-only.
model AlertScan {
  id         String       @id @default(uuid()) @db.Uuid
  orgId      String       @map("org_id") @db.Uuid
  /// Null when the checks ran by themselves because the last run was stale.
  ranById    String?      @map("ran_by_id") @db.Uuid
  startedAt  DateTime     @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime     @map("finished_at") @db.Timestamptz(6)
  rulesRun   Int          @map("rules_run")
  found      Int
  opened     Int
  reopened   Int
  cleared    Int
  /// Checks that could not run, with the reason.
  failures   Json         @default("[]")
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@index([orgId, finishedAt])
  @@map("alert_scans")
}

// ---------------------------------------------------------------- AI copilot (M4)

enum CopilotRole {
  USER
  ASSISTANT
}

enum CopilotMessageStatus {
  /// The assistant is still working on the answer.
  PENDING
  COMPLETE
  /// The model declined to answer.
  REFUSED
  /// Stopped before a full answer: too many steps, or the answer was cut off.
  INCOMPLETE
  /// The AI provider could not be reached or returned an error.
  FAILED
}

/// Whether the organisation lets its members use the copilot. Off until an owner or admin turns it on, because questions and figures are sent to the AI provider.
model CopilotSettings {
  orgId       String       @id @map("org_id") @db.Uuid
  enabled     Boolean      @default(false)
  /// Set when AI was turned off with the emergency stop: why, in the words of the person who stopped it.
  offReason   String?      @map("off_reason") @db.VarChar(500)
  updatedById String       @map("updated_by_id") @db.Uuid
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@map("copilot_settings")
}

/// The AI features (agents) the control center governs.
enum AiAgent {
  COPILOT
  COLLECTIONS
  BANKING
  CLOSE
  CFO
}

/// Per-organisation switch and monthly token budget for one AI agent. No row means on, with no budget.
model AiAgentSetting {
  orgId             String       @map("org_id") @db.Uuid
  agent             AiAgent
  enabled           Boolean      @default(true)
  /// Input plus output tokens the agent may use in a calendar month (India time). Null means no budget.
  monthlyTokenLimit Int?         @map("monthly_token_limit")
  updatedById       String       @map("updated_by_id") @db.Uuid
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  org               Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@id([orgId, agent])
  @@map("ai_agent_settings")
}

/// A conversation belongs to the member who started it; nobody else sees it.
model CopilotConversation {
  id             String           @id @default(uuid()) @db.Uuid
  orgId          String           @map("org_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  title          String           @db.VarChar(200)
  /// The model, instructions and tool set the conversation was started with. A conversation is only continued with the same ones, so the model always sees the history it produced.
  model          String           @db.VarChar(100)
  toolsetVersion Int              @map("toolset_version")
  systemPrompt   String           @map("system_prompt")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  org            Organization     @relation(fields: [orgId], references: [id], onDelete: Restrict)
  messages       CopilotMessage[]
  actions        CopilotAction[]

  @@unique([id, orgId])
  @@index([orgId, userId, updatedAt])
  @@map("copilot_conversations")
}

model CopilotMessage {
  id              String               @id @default(uuid()) @db.Uuid
  orgId           String               @map("org_id") @db.Uuid
  conversationId  String               @map("conversation_id") @db.Uuid
  seq             Int
  role            CopilotRole
  status          CopilotMessageStatus
  /// The question, or the answer's text.
  text            String?
  /// How a question was asked: TEXT (typed) or VOICE (spoken and turned into text by the browser).
  channel         String               @default("TEXT") @db.VarChar(10)
  /// The exact messages exchanged with the model for this turn (thinking, tool calls and tool results included), replayed unchanged on later turns.
  apiMessages     Json                 @default("[]") @map("api_messages")
  /// What the assistant looked at: one entry per tool call, with its input and the page it comes from.
  sources         Json                 @default("[]")
  errorCode       String?              @map("error_code") @db.VarChar(60)
  errorMessage    String?              @map("error_message") @db.VarChar(1000)
  /// The model that answered (can differ from the conversation's when the provider fell back to another model).
  servedModel     String?              @map("served_model") @db.VarChar(100)
  inputTokens     Int?                 @map("input_tokens")
  outputTokens    Int?                 @map("output_tokens")
  cacheReadTokens Int?                 @map("cache_read_tokens")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt     DateTime?            @map("completed_at") @db.Timestamptz(6)
  org             Organization         @relation(fields: [orgId], references: [id], onDelete: Restrict)
  conversation    CopilotConversation  @relation(fields: [conversationId, orgId], references: [id, orgId], onDelete: Cascade)

  @@unique([conversationId, seq])
  @@index([orgId, status])
  @@map("copilot_messages")
}

/// Something the assistant proposed doing (create a task, acknowledge or dismiss an alert). Nothing
/// happens until the member who asked confirms it on screen; it expires if they do not.
model CopilotAction {
  id             String              @id @default(uuid()) @db.Uuid
  orgId          String              @map("org_id") @db.Uuid
  conversationId String              @map("conversation_id") @db.Uuid
  /// The answer that proposed it.
  messageId      String              @map("message_id") @db.Uuid
  userId         String              @map("user_id") @db.Uuid
  /// CREATE_TASK, ACKNOWLEDGE_ALERT or DISMISS_ALERT.
  kind           String              @db.VarChar(30)
  input          Json
  /// What will happen, in words, as shown on the confirmation card.
  summary        String              @db.VarChar(1000)
  sensitive      Boolean             @default(false)
  /// PROPOSED, DONE, CANCELLED, FAILED or EXPIRED.
  status         String              @default("PROPOSED") @db.VarChar(12)
  result         Json?
  error          String?             @db.VarChar(1000)
  expiresAt      DateTime            @map("expires_at") @db.Timestamptz(6)
  decidedAt      DateTime?           @map("decided_at") @db.Timestamptz(6)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  org            Organization        @relation(fields: [orgId], references: [id], onDelete: Restrict)
  conversation   CopilotConversation @relation(fields: [conversationId, orgId], references: [id, orgId], onDelete: Cascade)

  @@index([orgId, conversationId])
  @@index([orgId, userId, status])
  @@map("copilot_actions")
}

// ---------------------------------------------------------------- workflow automations and tasks (M5)

enum WorkflowRunStatus {
  /// The conditions did not match: nothing was done.
  SKIPPED
  /// Actions are still being carried out (a webhook waiting for delivery or a retry).
  RUNNING
  SUCCEEDED
  /// At least one action failed for good.
  FAILED
  /// A test run: conditions checked and actions shown, nothing done.
  TEST
}

enum WorkflowActionStatus {
  PENDING
  SUCCEEDED
  FAILED
  /// Not carried out: a test run, or a webhook cancelled by a person.
  SKIPPED
}

enum TaskStatus {
  OPEN
  DONE
  CANCELLED
}

/// One automation. Its definition lives in versions; editing adds a version.
model Workflow {
  id                String            @id @default(uuid()) @db.Uuid
  orgId             String            @map("org_id") @db.Uuid
  name              String            @db.VarChar(120)
  description       String?           @db.VarChar(1000)
  enabled           Boolean           @default(false)
  currentVersion    Int               @map("current_version")
  /// Events at or before this audit-trail id are never acted on (set when the workflow is turned on), so turning a workflow on never replays history.
  activeFromEventId BigInt?           @map("active_from_event_id")
  /// When the workflow was last turned on. Schedule triggers act only on times and dates from then, so turning one on never sends a backlog.
  activatedAt       DateTime?         @map("activated_at") @db.Timestamptz(6)
  /// Secret for signing webhook deliveries (HMAC-SHA256).
  signingSecret     String            @map("signing_secret") @db.VarChar(100)
  createdById       String            @map("created_by_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  org               Organization      @relation(fields: [orgId], references: [id], onDelete: Restrict)
  versions          WorkflowVersion[]
  runs              WorkflowRun[]

  @@unique([id, orgId])
  @@index([orgId, enabled])
  @@map("workflows")
}

model WorkflowVersion {
  id            String       @id @default(uuid()) @db.Uuid
  orgId         String       @map("org_id") @db.Uuid
  workflowId    String       @map("workflow_id") @db.Uuid
  version       Int
  trigger       String       @db.VarChar(40)
  /// Settings of a schedule trigger (frequency and time, or days); {} for event triggers.
  triggerParams Json         @default("{}") @map("trigger_params")
  conditions    Json
  actions       Json
  note          String?      @db.VarChar(500)
  createdById   String       @map("created_by_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  workflow      Workflow     @relation(fields: [workflowId, orgId], references: [id, orgId], onDelete: Restrict)

  @@unique([workflowId, version])
  @@map("workflow_versions")
}

/// One event looked at by one workflow version (or a test run).
model WorkflowRun {
  id            String              @id @default(uuid()) @db.Uuid
  orgId         String              @map("org_id") @db.Uuid
  workflowId    String              @map("workflow_id") @db.Uuid
  version       Int
  trigger       String              @db.VarChar(40)
  /// The audit-trail event that started the run (null for a test run without one).
  eventId       BigInt?             @map("event_id")
  /// What a schedule trigger acted on, unique per workflow: "at:<time>" for a schedule, "doc:<id>:<days>" for a date trigger.
  occurrenceKey String?             @map("occurrence_key") @db.VarChar(100)
  entityType    String?             @map("entity_type") @db.VarChar(40)
  entityId      String?             @map("entity_id") @db.VarChar(64)
  facts         Json
  /// Each condition with its result and the value it saw.
  conditions    Json
  status        WorkflowRunStatus
  error         String?             @db.VarChar(1000)
  testedById    String?             @map("tested_by_id") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  finishedAt    DateTime?           @map("finished_at") @db.Timestamptz(6)
  org           Organization        @relation(fields: [orgId], references: [id], onDelete: Restrict)
  workflow      Workflow            @relation(fields: [workflowId, orgId], references: [id, orgId], onDelete: Restrict)
  actions       WorkflowActionRun[]

  @@unique([id, orgId])
  @@index([orgId, workflowId, createdAt])
  @@map("workflow_runs")
}

model WorkflowActionRun {
  id            String               @id @default(uuid()) @db.Uuid
  orgId         String               @map("org_id") @db.Uuid
  runId         String               @map("run_id") @db.Uuid
  position      Int
  type          String               @db.VarChar(20)
  status        WorkflowActionStatus
  /// What the action was given: the rendered task, or the webhook address and body.
  input         Json
  /// What happened: the task created, or each delivery attempt with its HTTP status.
  result        Json                 @default("{}")
  attempts      Int                  @default(0)
  nextAttemptAt DateTime?            @map("next_attempt_at") @db.Timestamptz(6)
  /// A delivery in progress holds the action until this time, so two runners never send it twice at once.
  lockedUntil   DateTime?            @map("locked_until") @db.Timestamptz(6)
  error         String?              @db.VarChar(1000)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  finishedAt    DateTime?            @map("finished_at") @db.Timestamptz(6)
  org           Organization         @relation(fields: [orgId], references: [id], onDelete: Restrict)
  run           WorkflowRun          @relation(fields: [runId, orgId], references: [id, orgId], onDelete: Restrict)

  @@unique([runId, position])
  @@index([status, nextAttemptAt])
  @@map("workflow_action_runs")
}

/// How far through the organisation's audit trail the workflows have read.
model WorkflowCursor {
  orgId       String       @id @map("org_id") @db.Uuid
  lastEventId BigInt       @map("last_event_id")
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@map("workflow_cursors")
}

/// A to-do for a person or a role, made by a person or by a workflow.
model Task {
  id             String       @id @default(uuid()) @db.Uuid
  orgId          String       @map("org_id") @db.Uuid
  title          String       @db.VarChar(200)
  description    String?      @db.VarChar(2000)
  status         TaskStatus   @default(OPEN)
  assigneeUserId String?      @map("assignee_user_id") @db.Uuid
  assigneeRole   String?      @map("assignee_role") @db.VarChar(20)
  dueDate        DateTime?    @map("due_date") @db.Date
  /// What the task is about, for a link: DOCUMENT, PAYMENT, JOURNAL, EXPENSE_CLAIM, ALERT or PERIOD_CLOSE (the period id).
  linkType       String?      @map("link_type") @db.VarChar(20)
  linkId         String?      @map("link_id") @db.VarChar(64)
  workflowRunId  String?      @map("workflow_run_id") @db.Uuid
  /// Where the task came from: PERSON, WORKFLOW (an automation), AI_AGENT (proposed by the copilot and confirmed by a member), ALERT or CLOSE (the month-end checklist).
  source         String       @default("PERSON") @db.VarChar(20)
  createdById    String?      @map("created_by_id") @db.Uuid
  closedById     String?      @map("closed_by_id") @db.Uuid
  closedAt       DateTime?    @map("closed_at") @db.Timestamptz(6)
  closeNote      String?      @map("close_note") @db.VarChar(1000)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@index([orgId, status])
  @@index([orgId, assigneeUserId, status])
  @@index([orgId, source, status])
  @@index([orgId, linkType, linkId])
  @@map("tasks")
}

// ---------------------------------------------------------------- collections (M5 slice 3)

enum CollectionRunStatus {
  RUNNING
  DONE
}

enum CollectionDraftStatus {
  /// The AI model is writing it.
  DRAFTING
  /// Written and checked; waiting for a person to send, edit or reject it.
  READY
  /// Approved by a person and accepted by the mail server.
  SENT
  /// Approved by a person, but the mail server did not accept it. It can be sent again.
  SEND_FAILED
  /// A person decided not to send it.
  REJECTED
  /// The AI model could not write it.
  FAILED
}

/// One press of "Draft reminders": which customers were looked at, drafted for or skipped and why.
model CollectionRun {
  id          String              @id @default(uuid()) @db.Uuid
  orgId       String              @map("org_id") @db.Uuid
  status      CollectionRunStatus @default(RUNNING)
  startedById String              @map("started_by_id") @db.Uuid
  /// Customers with overdue invoices left out, each with the reason: [{contactId, name, reason}].
  skipped     Json                @default("[]")
  model       String              @db.VarChar(100)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  finishedAt  DateTime?           @map("finished_at") @db.Timestamptz(6)
  org         Organization        @relation(fields: [orgId], references: [id], onDelete: Restrict)
  drafts      CollectionDraft[]

  @@unique([id, orgId])
  @@index([orgId, createdAt])
  @@map("collection_runs")
}

/// A payment reminder for one customer: the facts from the books it was written from, what
/// the AI model wrote and why, the checks against the books, and what a person decided.
model CollectionDraft {
  id           String                @id @default(uuid()) @db.Uuid
  orgId        String                @map("org_id") @db.Uuid
  runId        String                @map("run_id") @db.Uuid
  contactId    String                @map("contact_id") @db.Uuid
  status       CollectionDraftStatus @default(DRAFTING)
  toEmail      String                @map("to_email") @db.VarChar(320)
  /// The facts the draft was written from (open invoices, payment history, earlier reminders), as given to the model.
  facts        Json
  risk         String?               @db.VarChar(10)
  riskReasons  Json                  @default("[]") @map("risk_reasons")
  /// What the model wrote, kept as written even when a person edits the email.
  aiSubject    String?               @map("ai_subject") @db.VarChar(300)
  aiBody       String?               @map("ai_body")
  /// The email as it is (or was) sent: the model's words, or a person's edit.
  subject      String?               @db.VarChar(300)
  body         String?
  edited       Boolean               @default(false)
  checks       Json                  @default("[]")
  model        String                @db.VarChar(100)
  servedModel  String?               @map("served_model") @db.VarChar(100)
  inputTokens  Int?                  @map("input_tokens")
  outputTokens Int?                  @map("output_tokens")
  errorCode    String?               @map("error_code") @db.VarChar(40)
  errorMessage String?               @map("error_message") @db.VarChar(1000)
  decidedById  String?               @map("decided_by_id") @db.Uuid
  decidedAt    DateTime?             @map("decided_at") @db.Timestamptz(6)
  decisionNote String?               @map("decision_note") @db.VarChar(500)
  sendAttempts Int                   @default(0) @map("send_attempts")
  /// Each send attempt: when, the SMTP answer and any error.
  sendLog      Json                  @default("[]") @map("send_log")
  sentAt       DateTime?             @map("sent_at") @db.Timestamptz(6)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  org          Organization          @relation(fields: [orgId], references: [id], onDelete: Restrict)
  run          CollectionRun         @relation(fields: [runId, orgId], references: [id, orgId], onDelete: Restrict)
  contact      Contact               @relation(fields: [contactId, orgId], references: [id, orgId], onDelete: Restrict)

  @@index([orgId, status, createdAt])
  @@index([orgId, contactId, createdAt])
  @@map("collection_drafts")
}

enum BankAiRunStatus {
  RUNNING
  DONE
}

enum BankAiSuggestionStatus {
  /// The AI model is looking at the line.
  DRAFTING
  /// A proposal, checked; waiting for a person to accept or dismiss it.
  READY
  /// A person accepted it and it was applied.
  ACCEPTED
  /// A person dismissed it, or the line was dealt with another way.
  DISMISSED
  /// No proposal: the model declined, answered badly or could not be reached.
  FAILED
}

enum BankAiAction {
  MATCH
  PAYMENT
  ENTRY
  NONE
}

/// One run of AI reconciliation on one bank account.
model BankAiRun {
  id          String             @id @default(uuid()) @db.Uuid
  orgId       String             @map("org_id") @db.Uuid
  accountId   String             @map("account_id") @db.Uuid
  status      BankAiRunStatus    @default(RUNNING)
  startedById String             @map("started_by_id") @db.Uuid
  /// Unmatched lines left out, each with the reason: [{lineId, date, amount, description, reason}].
  skipped     Json               @default("[]")
  model       String             @db.VarChar(100)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  finishedAt  DateTime?          @map("finished_at") @db.Timestamptz(6)
  org         Organization       @relation(fields: [orgId], references: [id], onDelete: Restrict)
  suggestions BankAiSuggestion[]

  @@unique([id, orgId])
  @@index([orgId, accountId, createdAt])
  @@map("bank_ai_runs")
}

/// What the AI model proposed for one unmatched bank line: what it was shown, what it
/// proposed and why, the checks, and what a person decided.
model BankAiSuggestion {
  id              String                 @id @default(uuid()) @db.Uuid
  orgId           String                 @map("org_id") @db.Uuid
  runId           String                 @map("run_id") @db.Uuid
  statementLineId String                 @map("statement_line_id") @db.Uuid
  status          BankAiSuggestionStatus @default(DRAFTING)
  /// What the model was shown, with the ids its references stand for (BankLineContext).
  context         Json
  action          BankAiAction?
  /// What the model sent, with references (BankProposalInput).
  proposal        Json?
  /// The proposal with ids, when every check passed (ResolvedProposal).
  resolved        Json?
  confidence      String?                @db.VarChar(10)
  reason          String?
  checks          Json                   @default("[]")
  model           String                 @db.VarChar(100)
  servedModel     String?                @map("served_model") @db.VarChar(100)
  inputTokens     Int?                   @map("input_tokens")
  outputTokens    Int?                   @map("output_tokens")
  errorCode       String?                @map("error_code") @db.VarChar(40)
  errorMessage    String?                @map("error_message")
  decidedById     String?                @map("decided_by_id") @db.Uuid
  decidedAt       DateTime?              @map("decided_at") @db.Timestamptz(6)
  decisionNote    String?                @map("decision_note")
  /// What accepting it created: {journalEntryIds, paymentId, paymentNumber}.
  result          Json?
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  org             Organization           @relation(fields: [orgId], references: [id], onDelete: Restrict)
  run             BankAiRun              @relation(fields: [runId, orgId], references: [id, orgId], onDelete: Restrict)
  statementLine   BankStatementLine      @relation(fields: [statementLineId, orgId], references: [id, orgId], onDelete: Restrict)

  @@index([orgId, status, createdAt])
  @@index([orgId, statementLineId])
  @@map("bank_ai_suggestions")
}

// ---------------------------------------------------------------- month-end close (M5 slice 5)

enum PeriodCloseStatus {
  IN_PROGRESS
  CLOSED
}

/// The month-end close of one period: started by a person, closed (and the period locked) by an owner or admin.
model PeriodClose {
  id             String               @id @default(uuid()) @db.Uuid
  orgId          String               @map("org_id") @db.Uuid
  periodId       String               @unique @map("period_id") @db.Uuid
  status         PeriodCloseStatus    @default(IN_PROGRESS)
  startedById    String               @map("started_by_id") @db.Uuid
  /// Task made for each open check, by check key: { "DRAFT_JOURNALS": "<task id>" }.
  tasks          Json                 @default("{}")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  org            Organization         @relation(fields: [orgId], references: [id], onDelete: Restrict)
  period         FiscalPeriod         @relation(fields: [periodId, orgId], references: [id, orgId], onDelete: Restrict)
  certifications CloseCertification[]
  reviews        CloseAiReview[]
  adjustments    CloseAdjustment[]

  @@unique([periodId, orgId])
  @@unique([id, orgId])
  @@index([orgId, status])
  @@map("period_closes")
}

/// What was true when a month was closed, and who certified it. Never changed except once when reopened.
model CloseCertification {
  id            String       @id @default(uuid()) @db.Uuid
  orgId         String       @map("org_id") @db.Uuid
  closeId       String       @map("close_id") @db.Uuid
  certifiedById String       @map("certified_by_id") @db.Uuid
  certifiedAt   DateTime     @default(now()) @map("certified_at") @db.Timestamptz(6)
  note          String?      @db.VarChar(2000)
  checks        Json
  totals        Json
  reopenedById  String?      @map("reopened_by_id") @db.Uuid
  reopenedAt    DateTime?    @map("reopened_at") @db.Timestamptz(6)
  reopenReason  String?      @map("reopen_reason") @db.VarChar(2000)
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  close         PeriodClose  @relation(fields: [closeId, orgId], references: [id, orgId], onDelete: Restrict)

  @@index([orgId, closeId])
  @@map("close_certifications")
}

enum CloseReviewStatus {
  RUNNING
  DONE
  FAILED
}

/// One AI review of a month being closed: what it was shown, what it said, and its usage.
model CloseAiReview {
  id           String            @id @default(uuid()) @db.Uuid
  orgId        String            @map("org_id") @db.Uuid
  closeId      String            @map("close_id") @db.Uuid
  status       CloseReviewStatus @default(RUNNING)
  startedById  String            @map("started_by_id") @db.Uuid
  context      Json
  summary      String?
  findings     Json?
  model        String
  servedModel  String?           @map("served_model")
  inputTokens  Int?              @map("input_tokens")
  outputTokens Int?              @map("output_tokens")
  errorCode    String?           @map("error_code")
  errorMessage String?           @map("error_message")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  finishedAt   DateTime?         @map("finished_at") @db.Timestamptz(6)
  org          Organization      @relation(fields: [orgId], references: [id], onDelete: Restrict)
  close        PeriodClose       @relation(fields: [closeId, orgId], references: [id, orgId], onDelete: Restrict)
  adjustments  CloseAdjustment[]

  @@unique([id, orgId])
  @@index([orgId, closeId, createdAt])
  @@map("close_ai_reviews")
}

enum CloseAdjustmentStatus {
  READY
  POSTED
  REJECTED
  SUPERSEDED
}

/// An adjusting entry the AI model proposed at month end. Posted only when a person approves it.
model CloseAdjustment {
  id              String                @id @default(uuid()) @db.Uuid
  orgId           String                @map("org_id") @db.Uuid
  closeId         String                @map("close_id") @db.Uuid
  reviewId        String                @map("review_id") @db.Uuid
  status          CloseAdjustmentStatus @default(READY)
  proposal        Json
  resolved        Json?
  checks          Json
  confidence      String
  reason          String
  journalEntryId  String?               @map("journal_entry_id") @db.Uuid
  reversalEntryId String?               @map("reversal_entry_id") @db.Uuid
  decidedById     String?               @map("decided_by_id") @db.Uuid
  decidedAt       DateTime?             @map("decided_at") @db.Timestamptz(6)
  decisionNote    String?               @map("decision_note") @db.VarChar(1000)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  org             Organization          @relation(fields: [orgId], references: [id], onDelete: Restrict)
  close           PeriodClose           @relation(fields: [closeId, orgId], references: [id, orgId], onDelete: Restrict)
  review          CloseAiReview         @relation(fields: [reviewId, orgId], references: [id, orgId], onDelete: Restrict)

  @@index([orgId, closeId, status])
  @@map("close_adjustments")
}

enum DepreciationMethod {
  STRAIGHT_LINE
  WRITTEN_DOWN_VALUE
}

enum FixedAssetStatus {
  ACTIVE
  DISPOSED
}

enum DepreciationRunStatus {
  POSTED
  REVERSED
}

/// One item in the fixed asset register: what it cost, the accounts it uses, how it is depreciated, and its disposal.
model FixedAsset {
  id                   String             @id @default(uuid()) @db.Uuid
  orgId                String             @map("org_id") @db.Uuid
  /// Shown as FA-0001.
  number               Int
  name                 String             @db.VarChar(200)
  category             String?            @db.VarChar(100)
  serialNumber         String?            @map("serial_number") @db.VarChar(100)
  location             String?            @db.VarChar(200)
  assetAccountId       String             @map("asset_account_id") @db.Uuid
  accumulatedAccountId String             @map("accumulated_account_id") @db.Uuid
  expenseAccountId     String             @map("expense_account_id") @db.Uuid
  acquisitionDate      DateTime           @map("acquisition_date") @db.Date
  inServiceDate        DateTime           @map("in_service_date") @db.Date
  cost                 Decimal            @db.Decimal(24, 6)
  residualValue        Decimal            @map("residual_value") @db.Decimal(24, 6)
  method               DepreciationMethod
  usefulLifeMonths     Int?               @map("useful_life_months")
  annualRate           Decimal?           @map("annual_rate") @db.Decimal(7, 4)
  /// Accumulated depreciation brought in from before, and the month (YYYY-MM) it covers.
  openingAccumulated   Decimal            @default(0) @map("opening_accumulated") @db.Decimal(24, 6)
  depreciatedThrough   String?            @map("depreciated_through") @db.VarChar(7)
  /// The journal that recorded the purchase, when it was recorded here.
  acquisitionEntryId   String?            @map("acquisition_entry_id") @db.Uuid
  status               FixedAssetStatus   @default(ACTIVE)
  disposedOn           DateTime?          @map("disposed_on") @db.Date
  disposalProceeds     Decimal?           @map("disposal_proceeds") @db.Decimal(24, 6)
  disposalEntryId      String?            @map("disposal_entry_id") @db.Uuid
  disposalNote         String?            @map("disposal_note") @db.VarChar(500)
  disposedById         String?            @map("disposed_by_id") @db.Uuid
  createdById          String             @map("created_by_id") @db.Uuid
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  org                  Organization       @relation(fields: [orgId], references: [id], onDelete: Restrict)
  lines                DepreciationLine[]

  @@unique([orgId, number])
  @@unique([id, orgId])
  @@index([orgId, status])
  @@map("fixed_assets")
}

/// One month's depreciation for the organisation, posted as one journal.
model DepreciationRun {
  id              String                @id @default(uuid()) @db.Uuid
  orgId           String                @map("org_id") @db.Uuid
  /// YYYY-MM
  month           String                @db.VarChar(7)
  status          DepreciationRunStatus @default(POSTED)
  total           Decimal               @db.Decimal(24, 6)
  journalEntryId  String                @map("journal_entry_id") @db.Uuid
  postedById      String                @map("posted_by_id") @db.Uuid
  postedAt        DateTime              @default(now()) @map("posted_at") @db.Timestamptz(6)
  reversalEntryId String?               @map("reversal_entry_id") @db.Uuid
  reversedById    String?               @map("reversed_by_id") @db.Uuid
  reversedAt      DateTime?             @map("reversed_at") @db.Timestamptz(6)
  org             Organization          @relation(fields: [orgId], references: [id], onDelete: Restrict)
  lines           DepreciationLine[]

  @@unique([id, orgId])
  @@index([orgId, month])
  @@map("depreciation_runs")
}

model DepreciationLine {
  id      String          @id @default(uuid()) @db.Uuid
  orgId   String          @map("org_id") @db.Uuid
  runId   String          @map("run_id") @db.Uuid
  assetId String          @map("asset_id") @db.Uuid
  /// The month this charge is for (YYYY-MM): the run's month, or an earlier month caught up in it.
  month   String          @db.VarChar(7)
  amount  Decimal         @db.Decimal(24, 6)
  org     Organization    @relation(fields: [orgId], references: [id], onDelete: Restrict)
  run     DepreciationRun @relation(fields: [runId, orgId], references: [id, orgId], onDelete: Restrict)
  asset   FixedAsset      @relation(fields: [assetId, orgId], references: [id, orgId], onDelete: Restrict)

  @@unique([runId, assetId, month])
  @@index([orgId, assetId])
  @@map("depreciation_lines")
}

// ---------------------------------------------------------------- prepaid, deferred revenue, accruals

enum DeferralKind {
  PREPAID_EXPENSE
  DEFERRED_REVENUE
}

enum DeferralMethod {
  EVEN
  DAILY
}

enum DeferralStatus {
  ACTIVE
  ENDED
}

enum DeferralRunStatus {
  POSTED
  REVERSED
}

/// An amount paid in advance (prepaid expense) or received in advance (deferred revenue), released to the income statement over its period.
model DeferralSchedule {
  id               String         @id @default(uuid()) @db.Uuid
  orgId            String         @map("org_id") @db.Uuid
  kind             DeferralKind
  /// Shown as PP-0001 (prepaid) or DR-0001 (deferred revenue).
  number           Int
  name             String         @db.VarChar(200)
  counterparty     String?        @db.VarChar(200)
  /// The prepaid asset or deferred revenue liability account.
  balanceAccountId String         @map("balance_account_id") @db.Uuid
  /// The expense or revenue account it is released to.
  pnlAccountId     String         @map("pnl_account_id") @db.Uuid
  amount           Decimal        @db.Decimal(24, 6)
  startDate        DateTime       @map("start_date") @db.Date
  months           Int
  method           DeferralMethod
  /// The journal that recorded the payment or receipt, when it was recorded here.
  initialEntryId   String?        @map("initial_entry_id") @db.Uuid
  status           DeferralStatus @default(ACTIVE)
  endedOn          DateTime?      @map("ended_on") @db.Date
  endAmount        Decimal?       @map("end_amount") @db.Decimal(24, 6)
  endEntryId       String?        @map("end_entry_id") @db.Uuid
  endNote          String?        @map("end_note") @db.VarChar(500)
  endedById        String?        @map("ended_by_id") @db.Uuid
  createdById      String         @map("created_by_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  org              Organization   @relation(fields: [orgId], references: [id], onDelete: Restrict)
  lines            DeferralLine[]

  @@unique([orgId, kind, number])
  @@unique([id, orgId])
  @@index([orgId, status])
  @@map("deferral_schedules")
}

/// One month's releases for the organisation, posted as one journal.
model DeferralRun {
  id              String            @id @default(uuid()) @db.Uuid
  orgId           String            @map("org_id") @db.Uuid
  /// YYYY-MM
  month           String            @db.VarChar(7)
  status          DeferralRunStatus @default(POSTED)
  total           Decimal           @db.Decimal(24, 6)
  journalEntryId  String            @map("journal_entry_id") @db.Uuid
  postedById      String            @map("posted_by_id") @db.Uuid
  postedAt        DateTime          @default(now()) @map("posted_at") @db.Timestamptz(6)
  reversalEntryId String?           @map("reversal_entry_id") @db.Uuid
  reversedById    String?           @map("reversed_by_id") @db.Uuid
  reversedAt      DateTime?         @map("reversed_at") @db.Timestamptz(6)
  org             Organization      @relation(fields: [orgId], references: [id], onDelete: Restrict)
  lines           DeferralLine[]

  @@unique([id, orgId])
  @@index([orgId, month])
  @@map("deferral_runs")
}

model DeferralLine {
  id         String           @id @default(uuid()) @db.Uuid
  orgId      String           @map("org_id") @db.Uuid
  runId      String           @map("run_id") @db.Uuid
  scheduleId String           @map("schedule_id") @db.Uuid
  /// The month this release is for (YYYY-MM): the run's month, or an earlier month caught up in it.
  month      String           @db.VarChar(7)
  amount     Decimal          @db.Decimal(24, 6)
  org        Organization     @relation(fields: [orgId], references: [id], onDelete: Restrict)
  run        DeferralRun      @relation(fields: [runId, orgId], references: [id, orgId], onDelete: Restrict)
  schedule   DeferralSchedule @relation(fields: [scheduleId, orgId], references: [id, orgId], onDelete: Restrict)

  @@unique([runId, scheduleId, month])
  @@index([orgId, scheduleId])
  @@map("deferral_lines")
}

enum AccrualKind {
  EXPENSE
  INCOME
}

enum AccrualStatus {
  POSTED
  CANCELLED
}

/// A month-end accrual: posted on the last day of the month and reversed automatically on the first day of the next.
model Accrual {
  id                    String        @id @default(uuid()) @db.Uuid
  orgId                 String        @map("org_id") @db.Uuid
  kind                  AccrualKind
  /// Shown as AC-0001.
  number                Int
  description           String        @db.VarChar(200)
  counterparty          String?       @db.VarChar(200)
  /// YYYY-MM: the month it is accrued in.
  month                 String        @db.VarChar(7)
  /// The expense or revenue account.
  pnlAccountId          String        @map("pnl_account_id") @db.Uuid
  /// The accrued liability or accrued income account.
  balanceAccountId      String        @map("balance_account_id") @db.Uuid
  amount                Decimal       @db.Decimal(24, 6)
  entryId               String        @map("entry_id") @db.Uuid
  reversalEntryId       String        @map("reversal_entry_id") @db.Uuid
  status                AccrualStatus @default(POSTED)
  /// The two entries that undid it: the opposite of the accrual on its date, and the accrual again on its reversal's date.
  cancelEntryId         String?       @map("cancel_entry_id") @db.Uuid
  cancelReversalEntryId String?       @map("cancel_reversal_entry_id") @db.Uuid
  cancelNote            String?       @map("cancel_note") @db.VarChar(500)
  cancelledById         String?       @map("cancelled_by_id") @db.Uuid
  cancelledAt           DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  createdById           String        @map("created_by_id") @db.Uuid
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  org                   Organization  @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@unique([orgId, number])
  @@unique([id, orgId])
  @@index([orgId, month])
  @@map("accruals")
}

// ---------------------------------------------------------------- financial dimensions

enum DimensionType {
  DEPARTMENT
  PROJECT
}

/// A department (cost centre) or project that journal and document lines can be tagged with.
