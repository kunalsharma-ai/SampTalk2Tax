enum LoanMethod {
  EMI
  EQUAL_PRINCIPAL
}

enum LoanStatus {
  ACTIVE
  CLOSED
}

enum LoanEventKind {
  REPAYMENT
  PREPAYMENT
  RATE_CHANGE
}

enum LoanEventStatus {
  POSTED
  REVERSED
}

/// A loan taken by the organisation, repaid in monthly installments.
model Loan {
  id                  String       @id @default(uuid()) @db.Uuid
  orgId               String       @map("org_id") @db.Uuid
  /// Shown as LN-0001.
  number              Int
  name                String       @db.VarChar(200)
  lender              String?      @db.VarChar(200)
  accountNumber       String?      @map("account_number") @db.VarChar(60)
  method              LoanMethod
  principal           Decimal      @db.Decimal(24, 6)
  /// The rate the loan started at, annual percent.
  originalRate        Decimal      @map("original_rate") @db.Decimal(9, 4)
  months              Int
  disbursementDate    DateTime     @map("disbursement_date") @db.Date
  firstDueDate        DateTime     @map("first_due_date") @db.Date
  liabilityAccountId  String       @map("liability_account_id") @db.Uuid
  interestAccountId   String       @map("interest_account_id") @db.Uuid
  /// The bank account installments are usually paid from.
  bankAccountId       String       @map("bank_account_id") @db.Uuid
  /// The journal that recorded the money received, when it was recorded here.
  disbursementEntryId String?      @map("disbursement_entry_id") @db.Uuid
  /// Current terms: they change with prepayments and rate changes.
  annualRate          Decimal      @map("annual_rate") @db.Decimal(9, 4)
  installment         Decimal      @db.Decimal(24, 6)
  /// The installment that clears the loan when the term is fixed; null when it runs until paid.
  lastNo              Int?         @map("last_no")
  status              LoanStatus   @default(ACTIVE)
  closedOn            DateTime?    @map("closed_on") @db.Date
  notes               String?      @db.VarChar(1000)
  createdById         String       @map("created_by_id") @db.Uuid
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  org                 Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  events              LoanEvent[]

  @@unique([orgId, number])
  @@unique([id, orgId])
  @@index([orgId, status])
  @@map("loans")
}

/// Something that happened to a loan: an installment paid, a prepayment, a change of rate.
model LoanEvent {
  id                String          @id @default(uuid()) @db.Uuid
  orgId             String          @map("org_id") @db.Uuid
  loanId            String          @map("loan_id") @db.Uuid
  /// Order of events on the loan, from 1.
  seq               Int
  kind              LoanEventKind
  date              DateTime        @db.Date
  /// The installment paid, for repayments.
  installmentNo     Int?            @map("installment_no")
  principal         Decimal         @default(0) @db.Decimal(24, 6)
  interest          Decimal         @default(0) @db.Decimal(24, 6)
  charges           Decimal         @default(0) @db.Decimal(24, 6)
  bankAccountId     String?         @map("bank_account_id") @db.Uuid
  chargesAccountId  String?         @map("charges_account_id") @db.Uuid
  entryId           String?         @map("entry_id") @db.Uuid
  /// PREPAYMENT: REDUCE_TENURE or REDUCE_INSTALLMENT; RATE_CHANGE: KEEP_INSTALLMENT or KEEP_TENURE.
  mode              String?         @db.VarChar(30)
  balanceBefore     Decimal         @map("balance_before") @db.Decimal(24, 6)
  balanceAfter      Decimal         @map("balance_after") @db.Decimal(24, 6)
  rateBefore        Decimal         @map("rate_before") @db.Decimal(9, 4)
  rateAfter         Decimal         @map("rate_after") @db.Decimal(9, 4)
  installmentBefore Decimal         @map("installment_before") @db.Decimal(24, 6)
  installmentAfter  Decimal         @map("installment_after") @db.Decimal(24, 6)
  lastNoBefore      Int?            @map("last_no_before")
  lastNoAfter       Int?            @map("last_no_after")
  note              String?         @db.VarChar(500)
  status            LoanEventStatus @default(POSTED)
  reversalEntryId   String?         @map("reversal_entry_id") @db.Uuid
  reversedById      String?         @map("reversed_by_id") @db.Uuid
  reversedAt        DateTime?       @map("reversed_at") @db.Timestamptz(6)
  createdById       String          @map("created_by_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  org               Organization    @relation(fields: [orgId], references: [id], onDelete: Restrict)
  loan              Loan            @relation(fields: [loanId, orgId], references: [id, orgId], onDelete: Restrict)

  @@unique([loanId, seq])
  @@index([orgId, kind, date])
  @@map("loan_events")
}

enum InvoiceTemplateEngine {
  /// Built from a theme, a palette and sections.
  LAYOUT
  /// The organisation's own HTML with placeholders.
  HTML
}

enum SignatureKind {
  DRAWN
  UPLOADED
  TYPED
}

/// A design for printed invoices and credit notes.
model InvoiceTemplate {
  id          String                @id @default(uuid()) @db.Uuid
  orgId       String                @map("org_id") @db.Uuid
  name        String                @db.VarChar(120)
  /// The country preset it started from (IN_GST, AE_VAT, ...); its rules drive the warnings.
  presetId    String                @map("preset_id") @db.VarChar(20)
  engine      InvoiceTemplateEngine @default(LAYOUT)
  /// Theme, palette, font, labels and sections (see the engine's LayoutConfig). Also used by HTML templates for page size, dates and labels.
  layout      Json
  /// HTML engine only: the page body with placeholders.
  html        String?
  logo        Bytes?
  logoType    String?               @map("logo_type") @db.VarChar(20)
  logoSha256  String?               @map("logo_sha256") @db.Char(64)
  isDefault   Boolean               @default(false) @map("is_default")
  archivedAt  DateTime?             @map("archived_at") @db.Timestamptz(6)
  createdById String                @map("created_by_id") @db.Uuid
  updatedById String?               @map("updated_by_id") @db.Uuid
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  org         Organization          @relation(fields: [orgId], references: [id], onDelete: Restrict)
  documents   Document[]

  @@unique([id, orgId])
  @@index([orgId])
  @@map("invoice_templates")
}

/// A member's e-signature in an organisation: drawn, uploaded or typed, kept as a PNG/JPEG/WebP image.
model UserSignature {
  id          String              @id @default(uuid()) @db.Uuid
  orgId       String              @map("org_id") @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  kind        SignatureKind
  signerName  String              @map("signer_name") @db.VarChar(120)
  designation String?             @db.VarChar(120)
  image       Bytes
  imageType   String              @map("image_type") @db.VarChar(20)
  imageSha256 String              @map("image_sha256") @db.Char(64)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Replaced or removed; invoices already signed keep their own copy.
  revokedAt   DateTime?           @map("revoked_at") @db.Timestamptz(6)
  org         Organization        @relation(fields: [orgId], references: [id], onDelete: Restrict)
  uses        DocumentSignature[]

  @@unique([id, orgId])
  @@index([orgId, userId])
  @@map("user_signatures")
}

/// An e-signature placed on a posted invoice or credit note, with a copy of the image and a hash of what was signed.
model DocumentSignature {
  id             String        @id @default(uuid()) @db.Uuid
  orgId          String        @map("org_id") @db.Uuid
  documentId     String        @map("document_id") @db.Uuid
  signatureId    String        @map("signature_id") @db.Uuid
  signedById     String        @map("signed_by_id") @db.Uuid
  signerName     String        @map("signer_name") @db.VarChar(120)
  designation    String?       @db.VarChar(120)
  image          Bytes
  imageType      String        @map("image_type") @db.VarChar(20)
  /// SHA-256 of the engine's canonicalInvoiceContent at signing.
  contentHash    String        @map("content_hash") @db.Char(64)
  signedAt       DateTime      @default(now()) @map("signed_at") @db.Timestamptz(6)
  userAgent      String?       @map("user_agent") @db.VarChar(300)
  withdrawnAt    DateTime?     @map("withdrawn_at") @db.Timestamptz(6)
  withdrawnById  String?       @map("withdrawn_by_id") @db.Uuid
  withdrawReason String?       @map("withdraw_reason") @db.VarChar(300)
  org            Organization  @relation(fields: [orgId], references: [id], onDelete: Restrict)
  document       Document      @relation(fields: [documentId, orgId], references: [id, orgId], onDelete: Restrict, map: "document_signatures_document_fk")
  signature      UserSignature @relation(fields: [signatureId, orgId], references: [id, orgId], onDelete: Restrict, map: "document_signatures_signature_fk")

  @@index([orgId, documentId])
  @@map("document_signatures")
}

/// A group of organisations reported together. Owned by one organisation (the parent), whose
/// owners and admins set it up; consolidated reports also need access to every member.
model ConsolidationGroup {
  id           String                    @id @default(uuid()) @db.Uuid
  orgId        String                    @map("org_id") @db.Uuid
  name         String                    @db.VarChar(120)
  /// Presentation currency of the consolidated statements.
  currency     String                    @db.Char(3)
  createdById  String                    @map("created_by_id") @db.Uuid
  createdAt    DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  org          Organization              @relation(fields: [orgId], references: [id], onDelete: Restrict)
  members      ConsolidationMember[]
  rates        ConsolidationRate[]
  rules        EliminationRule[]
  intercompany IntercompanyTransaction[]

  @@unique([id, orgId])
  @@unique([orgId, name])
  @@map("consolidation_groups")
}

model ConsolidationMember {
  id               String             @id @default(uuid()) @db.Uuid
  /// The parent organisation (the group's owner), for row-level security.
  orgId            String             @map("org_id") @db.Uuid
  groupId          String             @map("group_id") @db.Uuid
  memberOrgId      String             @map("member_org_id") @db.Uuid
  /// The group's share of this organisation; below 100 shows non-controlling interests.
  ownershipPercent Decimal            @default(100) @map("ownership_percent") @db.Decimal(7, 4)
  /// Accounts this company uses for intercompany transactions (codes in its own chart).
  icReceivableCode String?            @map("ic_receivable_code") @db.VarChar(20)
  icPayableCode    String?            @map("ic_payable_code") @db.VarChar(20)
  icRevenueCode    String?            @map("ic_revenue_code") @db.VarChar(20)
  icExpenseCode    String?            @map("ic_expense_code") @db.VarChar(20)
  addedById        String             @map("added_by_id") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  group            ConsolidationGroup @relation(fields: [groupId, orgId], references: [id, orgId], onDelete: Cascade)
  memberOrg        Organization       @relation("ConsolidationMemberOrg", fields: [memberOrgId], references: [id], onDelete: Restrict)

  @@unique([groupId, memberOrgId])
  @@index([orgId])
  @@map("consolidation_members")
}

/// Translation rates for a member keeping its books in another currency, for one period end:
/// presentation currency per one unit of the member's currency.
model ConsolidationRate {
  id          String             @id @default(uuid()) @db.Uuid
  orgId       String             @map("org_id") @db.Uuid
  groupId     String             @map("group_id") @db.Uuid
  memberOrgId String             @map("member_org_id") @db.Uuid
  periodEnd   DateTime           @map("period_end") @db.Date
  closing     Decimal            @db.Decimal(22, 10)
  average     Decimal            @db.Decimal(22, 10)
  historical  Decimal            @db.Decimal(22, 10)
  updatedById String             @map("updated_by_id") @db.Uuid
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  group       ConsolidationGroup @relation(fields: [groupId, orgId], references: [id, orgId], onDelete: Cascade)

  @@unique([groupId, memberOrgId, periodEnd])
  @@index([orgId])
  @@map("consolidation_rates")
}

/// Pairs one member's account with another's; both balances are removed on consolidation.
model EliminationRule {
  id          String             @id @default(uuid()) @db.Uuid
  orgId       String             @map("org_id") @db.Uuid
  groupId     String             @map("group_id") @db.Uuid
  name        String             @db.VarChar(120)
  leftOrgId   String             @map("left_org_id") @db.Uuid
  leftCode    String             @map("left_code") @db.VarChar(20)
  rightOrgId  String             @map("right_org_id") @db.Uuid
  rightCode   String             @map("right_code") @db.VarChar(20)
  isActive    Boolean            @default(true) @map("is_active")
  createdById String             @map("created_by_id") @db.Uuid
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  group       ConsolidationGroup @relation(fields: [groupId, orgId], references: [id, orgId], onDelete: Cascade)

  @@index([orgId])
  @@index([groupId])
  @@map("elimination_rules")
}

/// A charge or settlement between two companies of a group, posted in both sets of books in one
/// database transaction. Owned by the group's parent organisation (row-level security); each
/// company's journal lives in that company.
model IntercompanyTransaction {
  id                 String             @id @default(uuid()) @db.Uuid
  orgId              String             @map("org_id") @db.Uuid
  groupId            String             @map("group_id") @db.Uuid
  number             Int
  kind               IntercompanyKind
  fromOrgId          String             @map("from_org_id") @db.Uuid
  toOrgId            String             @map("to_org_id") @db.Uuid
  date               DateTime           @db.Date
  description        String             @db.VarChar(200)
  amount             Decimal            @db.Decimal(20, 4)
  fromCurrency       String             @map("from_currency") @db.Char(3)
  toAmount           Decimal            @map("to_amount") @db.Decimal(20, 4)
  toCurrency         String             @map("to_currency") @db.Char(3)
  fromReceivableCode String             @map("from_receivable_code") @db.VarChar(20)
  toPayableCode      String             @map("to_payable_code") @db.VarChar(20)
  fromRevenueCode    String?            @map("from_revenue_code") @db.VarChar(20)
  toExpenseCode      String?            @map("to_expense_code") @db.VarChar(20)
  fromBankCode       String?            @map("from_bank_code") @db.VarChar(20)
  toBankCode         String?            @map("to_bank_code") @db.VarChar(20)
  fromEntryId        String             @map("from_entry_id") @db.Uuid
  toEntryId          String             @map("to_entry_id") @db.Uuid
  reversedOn         DateTime?          @map("reversed_on") @db.Date
  fromReversalId     String?            @map("from_reversal_id") @db.Uuid
  toReversalId       String?            @map("to_reversal_id") @db.Uuid
  createdById        String             @map("created_by_id") @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  reversedById       String?            @map("reversed_by_id") @db.Uuid
  group              ConsolidationGroup @relation(fields: [groupId, orgId], references: [id, orgId], onDelete: Restrict)

  @@unique([groupId, number])
  @@index([orgId])
  @@index([groupId, date])
  @@map("intercompany_transactions")
}

/// A what-if scenario in the financial digital twin: the changes (drivers) to play forward from
/// the organisation's actual figures. Purely hypothetical: nothing here is posted to the books.
model TwinScenario {
  id             String                @id @default(uuid()) @db.Uuid
  orgId          String                @map("org_id") @db.Uuid
  name           String                @db.VarChar(120)
  description    String?               @db.VarChar(1000)
  /// Actual months the baseline averages (3, 6 or 12).
  baselineMonths Int                   @map("baseline_months")
  horizonMonths  Int                   @map("horizon_months")
  /// The list of drivers, validated by the engine on every save.
  drivers        Json
  createdById    String                @map("created_by_id") @db.Uuid
  updatedById    String                @map("updated_by_id") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// War room: where the scenario is in its approval, and its current version number.
  status         ScenarioStatus        @default(DRAFT)
  version        Int                   @default(1)
  submittedById  String?               @map("submitted_by_id") @db.Uuid
  submittedAt    DateTime?             @map("submitted_at") @db.Timestamptz(6)
  decidedById    String?               @map("decided_by_id") @db.Uuid
  decidedAt      DateTime?             @map("decided_at") @db.Timestamptz(6)
  decisionNote   String?               @map("decision_note") @db.VarChar(1000)
  org            Organization          @relation(fields: [orgId], references: [id], onDelete: Restrict)
  versions       TwinScenarioVersion[]
  notes          TwinScenarioNote[]

  @@unique([orgId, name])
  @@unique([id, orgId], map: "twin_scenarios_id_org_key")
  @@index([orgId])
  @@map("twin_scenarios")
}

enum IntegrationKind {
  AI_ANTHROPIC
  EMAIL_SMTP
}

enum IntegrationTestStatus {
  NOT_TESTED
  OK
  FAILED
}

/// An organisation's own connection to an outside service, set up in the app (Settings → Integrations).
/// Secrets are encrypted with AES-256-GCM by the API and never returned; only a hint of the last characters is kept.
model OrgIntegration {
  id           String                @id @default(uuid()) @db.Uuid
  orgId        String                @map("org_id") @db.Uuid
  kind         IntegrationKind
  enabled      Boolean               @default(true)
  /// Settings that are not secret (model, host, port, sender address…), checked per kind by the API.
  settings     Json
  /// base64(iv | tag | ciphertext) of the secret (API key or SMTP password); null when none.
  secretCipher String?               @map("secret_cipher")
  /// Which encryption key sealed the secret, so a key change is reported instead of failing silently.
  keyId        String?               @map("key_id") @db.VarChar(16)
  secretHint   String?               @map("secret_hint") @db.VarChar(16)
  testStatus   IntegrationTestStatus @default(NOT_TESTED) @map("test_status")
  testMessage  String?               @map("test_message") @db.VarChar(500)
  testedAt     DateTime?             @map("tested_at") @db.Timestamptz(6)
  testedById   String?               @map("tested_by_id") @db.Uuid
  updatedById  String                @map("updated_by_id") @db.Uuid
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  org          Organization          @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@unique([orgId, kind])
  @@index([orgId])
  @@map("org_integrations")
}

enum ScenarioStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

/// Every saved set of inputs of a scenario, kept so earlier versions can be read and restored.
model TwinScenarioVersion {
  id             String       @id @default(uuid()) @db.Uuid
  orgId          String       @map("org_id") @db.Uuid
  scenarioId     String       @map("scenario_id") @db.Uuid
  version        Int
  name           String       @db.VarChar(120)
  description    String?      @db.VarChar(1000)
  baselineMonths Int          @map("baseline_months")
  horizonMonths  Int          @map("horizon_months")
  drivers        Json
  /// Why this version exists: CREATED, EDITED or RESTORED (from version n).
  reason         String       @db.VarChar(40)
  createdById    String       @map("created_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  scenario       TwinScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@unique([scenarioId, version])
  @@index([orgId])
  @@map("twin_scenario_versions")
}

/// War-room annotations on a scenario, optionally pinned to a projected month or to one change.
model TwinScenarioNote {
  id           String       @id @default(uuid()) @db.Uuid
  orgId        String       @map("org_id") @db.Uuid
  scenarioId   String       @map("scenario_id") @db.Uuid
  /// The scenario version the note was written against.
  version      Int
  /// 1-based projected month the note is about, if any.
  month        Int?
  /// 1-based position of the change the note is about, if any.
  changeNumber Int?         @map("change_number")
  body         String       @db.VarChar(2000)
  authorId     String       @map("author_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedById String?      @map("resolved_by_id") @db.Uuid
  resolvedAt   DateTime?    @map("resolved_at") @db.Timestamptz(6)
  scenario     TwinScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([scenarioId])
  @@map("twin_scenario_notes")
}

enum RecoveryPlanStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum RecoveryActionStatus {
  PLANNED
  IN_PROGRESS
  DONE
  DROPPED
}

/// A financial recovery plan: options chosen from the recovery planner, forecast together with the
/// digital twin. A plan only tracks what people decide to do; nothing in it is executed by the system.
model RecoveryPlan {
  id             String             @id @default(uuid()) @db.Uuid
  orgId          String             @map("org_id") @db.Uuid
  name           String             @db.VarChar(120)
  description    String?            @db.VarChar(1000)
  status         RecoveryPlanStatus @default(DRAFT)
  baselineMonths Int                @map("baseline_months")
  horizonMonths  Int                @map("horizon_months")
  createdById    String             @map("created_by_id") @db.Uuid
  updatedById    String             @map("updated_by_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  closedAt       DateTime?          @map("closed_at") @db.Timestamptz(6)
  org            Organization       @relation(fields: [orgId], references: [id], onDelete: Restrict)
  actions        RecoveryAction[]

  @@unique([orgId, name])
  @@unique([id, orgId], map: "recovery_plans_id_org_key")
  @@index([orgId])
  @@map("recovery_plans")
}

/// One option taken into a recovery plan, with the twin changes it stood for when it was added,
/// who owns it, when it is due and how far it has got.
model RecoveryAction {
  id            String               @id @default(uuid()) @db.Uuid
  orgId         String               @map("org_id") @db.Uuid
  planId        String               @map("plan_id") @db.Uuid
  optionKey     String               @map("option_key") @db.VarChar(40)
  category      String               @db.VarChar(30)
  title         String               @db.VarChar(200)
  detail        String               @db.VarChar(2000)
  drivers       Json
  targets       Json
  risks         Json
  needsDecision Boolean              @map("needs_decision")
  status        RecoveryActionStatus @default(PLANNED)
  ownerId       String?              @map("owner_id") @db.Uuid
  dueDate       DateTime?            @map("due_date") @db.Date
  note          String?              @db.VarChar(2000)
  createdById   String               @map("created_by_id") @db.Uuid
  updatedById   String               @map("updated_by_id") @db.Uuid
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  plan          RecoveryPlan         @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, optionKey])
  @@index([orgId])
  @@map("recovery_actions")
}

enum CfoReportKind {
  BOARD
  INVESTOR
}

enum CfoReportStatus {
  DRAFT
  FINAL
}

enum CfoAiStatus {
  NONE
  RUNNING
  DONE
  FAILED
}

/// A board pack or investor update from the virtual CFO: the assessment as it stood when the pack
/// was made (snapshot), the facts text an AI summary may be written from, people's commentary,
/// and an optional AI summary that passed the figure check. A final pack cannot be changed.
model CfoReport {
  id             String          @id @default(uuid()) @db.Uuid
  orgId          String          @map("org_id") @db.Uuid
  kind           CfoReportKind
  month          String          @db.Char(7)
  title          String          @db.VarChar(160)
  status         CfoReportStatus @default(DRAFT)
  snapshot       Json
  facts          String
  commentary     String?         @db.VarChar(10000)
  aiStatus       CfoAiStatus     @default(NONE) @map("ai_status")
  aiSummary      String?         @map("ai_summary") @db.VarChar(6000)
  aiModel        String?         @map("ai_model") @db.VarChar(100)
  servedModel    String?         @map("served_model") @db.VarChar(100)
  aiErrorCode    String?         @map("ai_error_code") @db.VarChar(60)
  aiErrorMessage String?         @map("ai_error_message") @db.VarChar(1000)
  inputTokens    Int?            @map("input_tokens")
  outputTokens   Int?            @map("output_tokens")
  aiStartedById  String?         @map("ai_started_by_id") @db.Uuid
  aiStartedAt    DateTime?       @map("ai_started_at") @db.Timestamptz(6)
  aiFinishedAt   DateTime?       @map("ai_finished_at") @db.Timestamptz(6)
  createdById    String          @map("created_by_id") @db.Uuid
  finalisedById  String?         @map("finalised_by_id") @db.Uuid
  finalisedAt    DateTime?       @map("finalised_at") @db.Timestamptz(6)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  org            Organization    @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@unique([orgId, kind, month])
  @@index([orgId])
  @@map("cfo_reports")
}

enum BenchmarkStatus {
  OPTED_IN
  WITHDRAWN
}

/// An organisation's consent to the benchmarking network: its peer profile, the metrics it shares
/// and who agreed. While opted in, `participantKey` links it to its one row in the pool; the key is
/// random and replaced each time the organisation joins again.
model BenchmarkParticipation {
  id                String          @id @default(uuid()) @db.Uuid
  orgId             String          @unique @map("org_id") @db.Uuid
  status            BenchmarkStatus
  industry          String
  sizeBand          String          @map("size_band")
  /// Entered when payroll has no employees; payroll's count wins when it has some.
  headcount         Int?
  sharedMetrics     String[]        @map("shared_metrics")
  consentVersion    Int             @map("consent_version")
  participantKey    String?         @unique @map("participant_key") @db.Uuid
  contributedPeriod String?         @map("contributed_period") @db.Char(7)
  contributedAt     DateTime?       @map("contributed_at") @db.Timestamptz(6)
  consentedById     String          @map("consented_by_id") @db.Uuid
  consentedAt       DateTime        @map("consented_at") @db.Timestamptz(6)
  withdrawnById     String?         @map("withdrawn_by_id") @db.Uuid
  withdrawnAt       DateTime?       @map("withdrawn_at") @db.Timestamptz(6)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  org               Organization    @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@map("benchmark_participations")
}

/// The benchmarking pool. Platform-wide and pseudonymous: no organisation id, name or amount, only a
/// random participant key, the peer profile and rounded ratios. Tenants cannot read it; only
/// aggregates over at least five other participants leave the server.
model BenchmarkContribution {
  id             String   @id @default(uuid()) @db.Uuid
  participantKey String   @unique @map("participant_key") @db.Uuid
  period         String   @db.Char(7)
  industry       String
  sizeBand       String   @map("size_band")
  countryCode    String   @map("country_code") @db.Char(2)
  currency       String   @db.Char(3)
  /// Synthetic demonstration peers, compared only with demo organisations.
  isSynthetic    Boolean  @map("is_synthetic")
  metrics        Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([period, isSynthetic])
  @@map("benchmark_contributions")
}

enum DecisionStatus {
  ACTIVE
  REVIEWED
  WITHDRAWN
}

/// Decision memory: an approved management decision, the assumptions behind it, the outcomes it
/// was expected to produce (KPIs measured later from the books) and, once reviewed, what happened
/// and the lessons learned. A reviewed or withdrawn decision cannot be changed.
model Decision {
  id              String         @id @default(uuid()) @db.Uuid
  orgId           String         @map("org_id") @db.Uuid
  number          Int
  title           String         @db.VarChar(200)
  /// What was decided.
  decision        String         @db.VarChar(4000)
  /// Why: the situation and the options considered.
  context         String?        @db.VarChar(4000)
  category        String         @db.VarChar(20)
  tags            String[]
  decidedOn       DateTime       @map("decided_on") @db.Date
  decidedBy       String?        @map("decided_by") @db.VarChar(200)
  reviewDue       DateTime?      @map("review_due") @db.Date
  /// [{ text, held: boolean | null, note }]
  assumptions     Json
  /// [{ kpi, comparator, target, measureMonth, baselineMonth, baseline, actual?, status? }]
  outcomes        Json
  sourceType      String?        @map("source_type") @db.VarChar(20)
  sourceId        String?        @map("source_id") @db.Uuid
  status          DecisionStatus @default(ACTIVE)
  verdict         String?        @db.VarChar(20)
  outcomeNotes    String?        @map("outcome_notes") @db.VarChar(4000)
  lessons         String?        @db.VarChar(4000)
  reviewedById    String?        @map("reviewed_by_id") @db.Uuid
  reviewedAt      DateTime?      @map("reviewed_at") @db.Timestamptz(6)
  withdrawnReason String?        @map("withdrawn_reason") @db.VarChar(1000)
  withdrawnById   String?        @map("withdrawn_by_id") @db.Uuid
  withdrawnAt     DateTime?      @map("withdrawn_at") @db.Timestamptz(6)
  createdById     String         @map("created_by_id") @db.Uuid
  updatedById     String         @map("updated_by_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  org             Organization   @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@unique([orgId, number])
  @@unique([id, orgId], map: "decisions_id_org_key")
  @@index([orgId, status])
  @@map("decisions")
}

/// Forecast evaluation lab: a saved run. It keeps the backtest results as they were and every
/// model's forecasts for the following months, so they can be measured later against what the
/// books show. Never changed or deleted.
model ForecastLabRun {
  id          String       @id @default(uuid()) @db.Uuid
  orgId       String       @map("org_id") @db.Uuid
  number      Int
  /// YYYY-MM: the last complete month the run saw.
  baseMonth   String       @map("base_month") @db.Char(7)
  window      Int
  note        String?      @db.VarChar(1000)
  /// Backtest results by series (statistics only).
  results     Json
  /// [{ series, model, month, horizon, value }]
  forecasts   Json
  createdById String       @map("created_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@unique([orgId, number])
  @@index([orgId, baseMonth])
  @@map("forecast_lab_runs")
}

/// A saved disaster simulation: the shocks only. Every run reads the baseline afresh from the
/// posted books and plays the shocks through the digital twin. Never writes to the ledger.
model DisasterSimulation {
  id             String       @id @default(uuid()) @db.Uuid
  orgId          String       @map("org_id") @db.Uuid
  number         Int
  name           String       @db.VarChar(120)
  description    String?      @db.VarChar(1000)
  baselineMonths Int          @map("baseline_months")
  horizonMonths  Int          @map("horizon_months")
  /// [{ kind, ... }] as checked by the engine's checkShock
  shocks         Json
  createdById    String       @map("created_by_id") @db.Uuid
  updatedById    String       @map("updated_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@unique([orgId, number])
  @@unique([orgId, name])
  @@map("disaster_simulations")
}

/// A saved business impact assessment: the business changes only (sales, HR, procurement,
/// operations). Every view re-runs them against the books as they stand.
model ImpactAssessment {
  id             String       @id @default(uuid()) @db.Uuid
  orgId          String       @map("org_id") @db.Uuid
  number         Int
  name           String       @db.VarChar(120)
  description    String?      @db.VarChar(1000)
  baselineMonths Int          @map("baseline_months")
  horizonMonths  Int          @map("horizon_months")
  /// [{ lever, ... }] as checked by the engine's checkChange
  changes        Json
  createdById    String       @map("created_by_id") @db.Uuid
  updatedById    String       @map("updated_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@unique([orgId, number])
  @@unique([orgId, name])
  @@map("impact_assessments")
}

/// A financial policy: the policy in words, the workflow rules that enforce it, and tests.
/// `version` is the latest version; `activeVersion` is the one whose rules are running.
model Policy {
  id            String          @id @default(uuid()) @db.Uuid
  orgId         String          @map("org_id") @db.Uuid
  number        Int
  name          String          @db.VarChar(120)
  statement     String          @db.VarChar(4000)
  /// DRAFT: the latest version is not approved; ACTIVE: the latest version is running; RETIRED: nothing runs.
  status        String          @db.VarChar(10)
  version       Int
  activeVersion Int?            @map("active_version")
  rules         Json
  tests         Json
  /// Workflow ids, by rule position, of the workflows running the active version.
  workflowIds   String[]        @map("workflow_ids") @db.Uuid
  createdById   String          @map("created_by_id") @db.Uuid
  updatedById   String          @map("updated_by_id") @db.Uuid
  approvedById  String?         @map("approved_by_id") @db.Uuid
  approvedAt    DateTime?       @map("approved_at") @db.Timestamptz(6)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  org           Organization    @relation(fields: [orgId], references: [id], onDelete: Restrict)
  versions      PolicyVersion[]

  @@unique([orgId, number])
  @@unique([orgId, name])
  @@unique([orgId, id], map: "policies_org_id_id_key")
  @@map("policies")
}

/// Every saved version of a policy. Never changed or deleted.
model PolicyVersion {
  id          String       @id @default(uuid()) @db.Uuid
  orgId       String       @map("org_id") @db.Uuid
  policyId    String       @map("policy_id") @db.Uuid
  version     Int
  name        String       @db.VarChar(120)
  statement   String       @db.VarChar(4000)
  rules       Json
  tests       Json
  /// CREATED, EDITED, APPROVED, RETIRED
  event       String       @db.VarChar(10)
  note        String?      @db.VarChar(1000)
  createdById String       @map("created_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  policy      Policy       @relation(fields: [policyId], references: [id], onDelete: Restrict)

  @@unique([policyId, version, event], map: "policy_versions_policy_version_event_key")
  @@index([orgId, policyId, version])
  @@map("policy_versions")
}

/// Each AI drafting call: what was asked, what came back, and the tokens used (counted under the copilot's budget).
model PolicyAiDraft {
  id           String       @id @default(uuid()) @db.Uuid
  orgId        String       @map("org_id") @db.Uuid
  request      String       @db.VarChar(8000)
  /// DONE or FAILED
  status       String       @db.VarChar(10)
  result       Json?
  errorCode    String?      @map("error_code") @db.VarChar(40)
  errorMessage String?      @map("error_message") @db.VarChar(500)
  model        String?      @db.VarChar(100)
  inputTokens  Int          @default(0) @map("input_tokens")
  outputTokens Int          @default(0) @map("output_tokens")
  createdById  String       @map("created_by_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@index([orgId, createdAt])
  @@map("policy_ai_drafts")
}

/// A dashboard of approved metrics, built by hand or drafted by the AI from a description.
model Dashboard {
  id          String       @id @default(uuid()) @db.Uuid
  orgId       String       @map("org_id") @db.Uuid
  number      Int
  name        String       @db.VarChar(120)
  description String?      @db.VarChar(1000)
  /// { widgets: [...] }, checked by the engine before saving.
  config      Json
  version     Int          @default(1)
  createdById String       @map("created_by_id") @db.Uuid
  updatedById String       @map("updated_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@unique([orgId, number])
  @@unique([orgId, name])
  @@map("dashboards")
}

/// Each AI draft of a dashboard, with its tokens.
model DashboardAiDraft {
  id           String       @id @default(uuid()) @db.Uuid
  orgId        String       @map("org_id") @db.Uuid
  request      String       @db.VarChar(8000)
  /// DONE or FAILED
  status       String       @db.VarChar(10)
  result       Json?
  errorCode    String?      @map("error_code") @db.VarChar(40)
  errorMessage String?      @map("error_message") @db.VarChar(500)
  model        String?      @db.VarChar(100)
  inputTokens  Int          @default(0) @map("input_tokens")
  outputTokens Int          @default(0) @map("output_tokens")
  createdById  String       @map("created_by_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@index([orgId, createdAt])
  @@map("dashboard_ai_drafts")
}

/// A report layout: headings, text, commentary and figures of approved metrics.
model ReportDesign {
  id          String       @id @default(uuid()) @db.Uuid
  orgId       String       @map("org_id") @db.Uuid
  number      Int
  name        String       @db.VarChar(120)
  description String?      @db.VarChar(1000)
  /// { sections: [...] }, checked by the engine before saving.
  layout      Json
  version     Int          @default(1)
  createdById String       @map("created_by_id") @db.Uuid
  updatedById String       @map("updated_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  runs        ReportRun[]

  @@unique([orgId, number])
  @@unique([orgId, name])
  @@unique([orgId, id], map: "report_designs_org_id_id_key")
  @@map("report_designs")
}

/// A report produced from a design for a month: its figures frozen, its commentary, and once final, never changed.
model ReportRun {
  id            String       @id @default(uuid()) @db.Uuid
  orgId         String       @map("org_id") @db.Uuid
  designId      String       @map("design_id") @db.Uuid
  number        Int
  month         String       @db.VarChar(7)
  title         String       @db.VarChar(200)
  /// The layout as it was, the figures, and the facts the commentary must stick to.
  content       Json
  /// One entry per commentary section: { text, source: AI | PERSON | NONE, issues }.
  commentary    Json
  /// DRAFT or FINAL
  status        String       @db.VarChar(10)
  version       Int          @default(1)
  createdById   String       @map("created_by_id") @db.Uuid
  updatedById   String       @map("updated_by_id") @db.Uuid
  finalisedById String?      @map("finalised_by_id") @db.Uuid
  finalisedAt   DateTime?    @map("finalised_at") @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  design        ReportDesign @relation(fields: [designId], references: [id], onDelete: Restrict)

  @@unique([orgId, number])
  @@index([orgId, designId, month])
  @@map("report_runs")
}

/// Each AI call of the report designer (drafting a layout or writing commentary), with its tokens.
model ReportAiCall {
  id           String       @id @default(uuid()) @db.Uuid
  orgId        String       @map("org_id") @db.Uuid
  /// DESIGN or COMMENTARY
  kind         String       @db.VarChar(12)
  request      String       @db.VarChar(8000)
  /// DONE or FAILED
  status       String       @db.VarChar(10)
  result       Json?
  errorCode    String?      @map("error_code") @db.VarChar(40)
  errorMessage String?      @map("error_message") @db.VarChar(500)
  model        String?      @db.VarChar(100)
  inputTokens  Int          @default(0) @map("input_tokens")
  outputTokens Int          @default(0) @map("output_tokens")
  createdById  String       @map("created_by_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@index([orgId, createdAt])
  @@map("report_ai_calls")
}

/// Exchange rates an organisation records: functional currency per one unit of `currency`, from `date`.
model ExchangeRate {
  id          String       @id @default(uuid()) @db.Uuid
  orgId       String       @map("org_id") @db.Uuid
  currency    String       @db.Char(3)
  date        DateTime     @db.Date
  rate        Decimal      @db.Decimal(24, 10)
  source      String?      @db.VarChar(200)
  createdById String       @map("created_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  org         Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, currency, date])
  @@map("exchange_rates")
}

/// A period-end revaluation of foreign-currency balances: posted on `date`, reversed on `reversalDate`. Immutable.
model FxRevaluation {
  id              String       @id @default(uuid()) @db.Uuid
  orgId           String       @map("org_id") @db.Uuid
  number          Int
  date            DateTime     @db.Date
  reversalDate    DateTime     @map("reversal_date") @db.Date
  rates           Json
  lines           Json
  gain            Decimal      @db.Decimal(24, 6)
  journalEntryId  String       @unique @map("journal_entry_id") @db.Uuid
  reversalEntryId String       @unique @map("reversal_entry_id") @db.Uuid
  createdById     String       @map("created_by_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  org             Organization @relation(fields: [orgId], references: [id])
  journalEntry    JournalEntry @relation("FxRevaluationEntry", fields: [journalEntryId], references: [id])
  reversalEntry   JournalEntry @relation("FxRevaluationReversal", fields: [reversalEntryId], references: [id])

  @@unique([orgId, number])
  @@unique([orgId, date])
  @@map("fx_revaluations")
}

/// A message shown to every signed-in person while current (platform administration).
model PlatformAnnouncement {
  id          String    @id @db.Uuid
  message     String
  tone        String    @default("INFO") @db.VarChar(8)
  startsAt    DateTime  @map("starts_at") @db.Timestamptz(6)
  endsAt      DateTime? @map("ends_at") @db.Timestamptz(6)
  createdBy   String    @map("created_by") @db.Uuid
  creator     User      @relation("AnnouncementCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  withdrawnAt DateTime? @map("withdrawn_at") @db.Timestamptz(6)
  withdrawnBy String?   @map("withdrawn_by") @db.Uuid
  withdrawer  User?     @relation("AnnouncementWithdrawnBy", fields: [withdrawnBy], references: [id], onDelete: Restrict)

  @@index([startsAt])
  @@map("platform_announcements")
}

/// A Talk2Tax plan (platform billing; not an organisation's books). Edited by platform administrators.
model Plan {
  id            String                @id @db.Uuid
  code          String                @unique @db.VarChar(24)
  name          String                @db.VarChar(60)
  description   String                @default("") @db.VarChar(300)
  prices        Json
  limits        Json
  features      String[]              @default([])
  isActive      Boolean               @default(true) @map("is_active")
  sortOrder     Int                   @default(0) @map("sort_order")
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  subscriptions Subscription[]        @relation("SubscriptionPlan")
  invoices      SubscriptionInvoice[]
  requestedBy   Subscription[]        @relation("SubscriptionRequestedPlan")

  @@map("plans")
}

/// An organisation's Talk2Tax subscription (one per organisation).
model Subscription {
  orgId              String       @id @map("org_id") @db.Uuid
  org                Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  planId             String       @map("plan_id") @db.Uuid
  plan               Plan         @relation("SubscriptionPlan", fields: [planId], references: [id], onDelete: Restrict)
  status             String       @db.VarChar(16)
  billingInterval    String?      @map("billing_interval") @db.VarChar(8)
  currency           String       @db.Char(3)
  price              Decimal?     @db.Decimal(12, 2)
  trialEndsAt        DateTime?    @map("trial_ends_at") @db.Timestamptz(6)
  currentPeriodStart DateTime?    @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime?    @map("current_period_end") @db.Timestamptz(6)
  paymentReference   String?      @map("payment_reference") @db.VarChar(200)
  requestedPlanId    String?      @map("requested_plan_id") @db.Uuid
  requestedPlan      Plan?        @relation("SubscriptionRequestedPlan", fields: [requestedPlanId], references: [id], onDelete: Restrict)
  requestedInterval  String?      @map("requested_interval") @db.VarChar(8)
  requestedAt        DateTime?    @map("requested_at") @db.Timestamptz(6)
  requestedBy        String?      @map("requested_by") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("subscriptions")
}

/// What happened to a subscription (immutable).
model SubscriptionEvent {
  id        String       @id @db.Uuid
  orgId     String       @map("org_id") @db.Uuid
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  kind      String       @db.VarChar(32)
  data      Json         @default("{}")
  actorId   String?      @map("actor_id") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([orgId, createdAt])
  @@map("subscription_events")
}

/// A payment gateway the platform takes subscription payments through (set up in Platform administration).
model PlatformPaymentGateway {
  provider        String    @id @db.VarChar(16)
  enabled         Boolean   @default(false)
  mode            String    @default("TEST") @db.VarChar(8)
  currencies      String[]  @default([])
  keyId           String?   @map("key_id") @db.VarChar(100)
  secretCipher    String?   @map("secret_cipher")
  secretKeyId     String?   @map("secret_key_id") @db.VarChar(16)
  secretHint      String?   @map("secret_hint") @db.VarChar(16)
  webhookCipher   String?   @map("webhook_cipher")
  webhookKeyId    String?   @map("webhook_key_id") @db.VarChar(16)
  webhookHint     String?   @map("webhook_hint") @db.VarChar(16)
  lastTestAt      DateTime? @map("last_test_at") @db.Timestamptz(6)
  lastTestOk      Boolean?  @map("last_test_ok")
