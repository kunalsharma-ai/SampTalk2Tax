  @@map("payroll_settings")
}

model Employee {
  id            String            @id @default(uuid()) @db.Uuid
  orgId         String            @map("org_id") @db.Uuid
  code          String
  name          String
  email         String?
  pan           String?           @db.Char(10)
  dateOfJoining DateTime          @map("date_of_joining") @db.Date
  dateOfLeaving DateTime?         @map("date_of_leaving") @db.Date
  /// State whose professional tax applies (GST state code).
  workStateCode String?           @map("work_state_code") @db.Char(2)
  ptCategory    PtCategory        @default(GENERAL) @map("pt_category")
  pfMember      Boolean           @default(true) @map("pf_member")
  epsMember     Boolean           @default(true) @map("eps_member")
  /// PF on wages above the ceiling, by agreement between employer and employee.
  pfOnFullWages Boolean           @default(false) @map("pf_on_full_wages")
  uan           String?
  esiNumber     String?           @map("esi_number")
  /// Salary and tax from a previous employer in the tax year of joining.
  priorTaxYear  String?           @map("prior_tax_year")
  priorIncome   Decimal           @default(0) @map("prior_income") @db.Decimal(24, 6)
  priorTds      Decimal           @default(0) @map("prior_tds") @db.Decimal(24, 6)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  org           Organization      @relation(fields: [orgId], references: [id], onDelete: Restrict)
  structures    SalaryStructure[]
  payslips      Payslip[]

  @@unique([orgId, code])
  @@unique([id, orgId])
  @@map("employees")
}

/// Monthly pay from a given month. Never changed: a revision is a new structure from a later month.
model SalaryStructure {
  id            String            @id @default(uuid()) @db.Uuid
  orgId         String            @map("org_id") @db.Uuid
  employeeId    String            @map("employee_id") @db.Uuid
  effectiveFrom DateTime          @map("effective_from") @db.Date
  createdById   String            @map("created_by_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  employee      Employee          @relation(fields: [employeeId, orgId], references: [id, orgId], onDelete: Restrict)
  components    SalaryComponent[]
  payslips      Payslip[]

  @@unique([employeeId, effectiveFrom])
  @@unique([id, orgId])
  @@map("salary_structures")
}

model SalaryComponent {
  id            String           @id @default(uuid()) @db.Uuid
  orgId         String           @map("org_id") @db.Uuid
  structureId   String           @map("structure_id") @db.Uuid
  position      Int              @db.SmallInt
  code          String
  name          String
  kind          PayComponentKind
  monthlyAmount Decimal          @map("monthly_amount") @db.Decimal(24, 6)
  structure     SalaryStructure  @relation(fields: [structureId, orgId], references: [id, orgId], onDelete: Restrict)

  @@unique([structureId, code])
  @@map("salary_components")
}

/// One month's payroll. Draft payslips are recalculated freely; posting freezes them and posts one journal.
model PayRun {
  id                 String              @id @default(uuid()) @db.Uuid
  orgId              String              @map("org_id") @db.Uuid
  number             String
  /// YYYY-MM
  period             String              @db.Char(7)
  status             PayRunStatus        @default(DRAFT)
  payDate            DateTime            @map("pay_date") @db.Date
  gross              Decimal             @default(0) @db.Decimal(24, 6)
  deductions         Decimal             @default(0) @db.Decimal(24, 6)
  net                Decimal             @default(0) @db.Decimal(24, 6)
  employerCost       Decimal             @default(0) @map("employer_cost") @db.Decimal(24, 6)
  journalEntryId     String?             @unique @map("journal_entry_id") @db.Uuid
  postedAt           DateTime?           @map("posted_at") @db.Timestamptz(6)
  postedById         String?             @map("posted_by_id") @db.Uuid
  voidJournalEntryId String?             @unique @map("void_journal_entry_id") @db.Uuid
  voidDate           DateTime?           @map("void_date") @db.Date
  voidReason         String?             @map("void_reason")
  createdById        String              @map("created_by_id") @db.Uuid
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  org                Organization        @relation(fields: [orgId], references: [id], onDelete: Restrict)
  payslips           Payslip[]
  remittances        PayrollRemittance[]

  @@unique([orgId, number])
  @@unique([id, orgId])
  @@map("pay_runs")
}

model Payslip {
  id             String          @id @default(uuid()) @db.Uuid
  orgId          String          @map("org_id") @db.Uuid
  payRunId       String          @map("pay_run_id") @db.Uuid
  employeeId     String          @map("employee_id") @db.Uuid
  structureId    String          @map("structure_id") @db.Uuid
  daysInMonth    Int             @map("days_in_month") @db.SmallInt
  /// Days not worked before joining or after leaving.
  daysOutside    Decimal         @default(0) @map("days_outside") @db.Decimal(4, 1)
  lopDays        Decimal         @default(0) @map("lop_days") @db.Decimal(4, 1)
  paidDays       Decimal         @map("paid_days") @db.Decimal(4, 1)
  /// One-off earnings this month: [{ name, kind, amount }].
  oneOffs        Json            @default("[]") @map("one_offs")
  /// Earnings as paid: [{ code, name, kind, amount }].
  earnings       Json
  gross          Decimal         @db.Decimal(24, 6)
  wages          Decimal         @db.Decimal(24, 6)
  wagesAddedBack Decimal         @map("wages_added_back") @db.Decimal(24, 6)
  pfWages        Decimal         @map("pf_wages") @db.Decimal(24, 6)
  pfEmployee     Decimal         @map("pf_employee") @db.Decimal(24, 6)
  eps            Decimal         @db.Decimal(24, 6)
  epfEmployer    Decimal         @map("epf_employer") @db.Decimal(24, 6)
  edli           Decimal         @db.Decimal(24, 6)
  pfAdmin        Decimal         @map("pf_admin") @db.Decimal(24, 6)
  esiCovered     Boolean         @map("esi_covered")
  esiWages       Decimal         @map("esi_wages") @db.Decimal(24, 6)
  esiEmployee    Decimal         @map("esi_employee") @db.Decimal(24, 6)
  esiEmployer    Decimal         @map("esi_employer") @db.Decimal(24, 6)
  pt             Decimal         @db.Decimal(24, 6)
  ptNote         String          @map("pt_note")
  tds            Decimal         @db.Decimal(24, 6)
  /// How the month's TDS was worked out: projected income, taxable income, annual tax, note.
  tdsDetail      Json            @map("tds_detail")
  deductions     Decimal         @db.Decimal(24, 6)
  net            Decimal         @db.Decimal(24, 6)
  employerCost   Decimal         @map("employer_cost") @db.Decimal(24, 6)
  payRun         PayRun          @relation(fields: [payRunId, orgId], references: [id, orgId], onDelete: Cascade)
  employee       Employee        @relation(fields: [employeeId, orgId], references: [id, orgId], onDelete: Restrict)
  structure      SalaryStructure @relation(fields: [structureId, orgId], references: [id, orgId], onDelete: Restrict)

  @@unique([payRunId, employeeId])
  @@index([orgId, employeeId])
  @@map("payslips")
}

/// Paying out what a posted pay run owes: net salaries, or PF, ESI, professional tax or TDS to the authority.
model PayrollRemittance {
  id                 String           @id @default(uuid()) @db.Uuid
  orgId              String           @map("org_id") @db.Uuid
  payRunId           String           @map("pay_run_id") @db.Uuid
  liability          PayrollLiability
  number             String
  date               DateTime         @db.Date
  bankAccountId      String           @map("bank_account_id") @db.Uuid
  reference          String
  amount             Decimal          @db.Decimal(24, 6)
  status             PaymentStatus    @default(POSTED)
  journalEntryId     String           @unique @map("journal_entry_id") @db.Uuid
  voidJournalEntryId String?          @unique @map("void_journal_entry_id") @db.Uuid
  voidDate           DateTime?        @map("void_date") @db.Date
  voidReason         String?          @map("void_reason")
  createdById        String           @map("created_by_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  payRun             PayRun           @relation(fields: [payRunId, orgId], references: [id, orgId], onDelete: Restrict)

  @@unique([orgId, number])
  @@index([payRunId])
  @@map("payroll_remittances")
}

// ---------------------------------------------------------------- compliance calendar (M3)

enum GstReturnFrequency {
  MONTHLY
  QUARTERLY
}

/// What the compliance calendar needs beyond the GST, TDS/TCS and payroll set-up.
model ComplianceSettings {
  orgId              String             @id @map("org_id") @db.Uuid
  /// QUARTERLY: the QRMP scheme (quarterly GSTR-1 and GSTR-3B, monthly PMT-06).
  gstReturnFrequency GstReturnFrequency @default(MONTHLY) @map("gst_return_frequency")
  /// Advance income tax instalments from this date; NULL when not tracked.
  advanceTaxFrom     DateTime?          @map("advance_tax_from") @db.Date
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  org                Organization       @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@map("compliance_settings")
}

enum ComplianceFilingStatus {
  FILED
  VOID
}

/// A return marked filed (or an advance tax instalment marked paid) with its acknowledgement. Never changed except once to VOID.
model ComplianceFiling {
  id            String                 @id @default(uuid()) @db.Uuid
  orgId         String                 @map("org_id") @db.Uuid
  /// Obligation key from the calendar, for example GSTR3B:2026-10.
  obligationKey String                 @map("obligation_key")
  kind          String
  period        String
  dueDate       DateTime               @map("due_date") @db.Date
  filedOn       DateTime               @map("filed_on") @db.Date
  /// ARN, token number or challan identification.
  reference     String
  note          String?
  status        ComplianceFilingStatus @default(FILED)
  createdById   String                 @map("created_by_id") @db.Uuid
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  voidedById    String?                @map("voided_by_id") @db.Uuid
  voidedAt      DateTime?              @map("voided_at") @db.Timestamptz(6)
  voidReason    String?                @map("void_reason")
  org           Organization           @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@index([orgId, obligationKey])
  @@map("compliance_filings")
}

// ---------------------------------------------------------------- e-invoicing (M3)

/// E-invoicing for the organisation's GST registration: from when, the seller address on the IRP, and the IRP key.
model EInvoiceSettings {
  orgId              String       @id @map("org_id") @db.Uuid
  /// B2B invoices and credit notes dated on or after this need an IRN.
  applicableFrom     DateTime     @map("applicable_from") @db.Date
  /// Aggregate annual turnover of Rs 10 crore or more: the 30-day reporting limit applies.
  aatoTenCroreOrMore Boolean      @default(false) @map("aato_ten_crore_or_more")
  tradeName          String?      @map("trade_name")
  address1           String
  address2           String?
  city               String
  pincode            String       @db.Char(6)
  /// UQC for goods lines, for example NOS.
  goodsUnit          String       @default("NOS") @map("goods_unit")
  /// The IRP's public key (PEM); when set, signed QR codes are verified with it.
  irpPublicKey       String?      @map("irp_public_key")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  org                Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@map("e_invoice_settings")
}

enum EInvoiceStatus {
  ACTIVE
  CANCELLED
}

/// An IRN the IRP issued for a document, as imported from its response. Never changed except to record a cancellation.
model EInvoice {
  id                String         @id @default(uuid()) @db.Uuid
  orgId             String         @map("org_id") @db.Uuid
  documentId        String         @map("document_id") @db.Uuid
  irn               String         @db.Char(64)
  ackNo             String         @map("ack_no")
  ackDate           DateTime       @map("ack_date") @db.Timestamptz(6)
  signedQrCode      String         @map("signed_qr_code")
  signedInvoice     String?        @map("signed_invoice")
  /// True when the QR code's signature was checked with the IRP key in the settings.
  signatureVerified Boolean        @default(false) @map("signature_verified")
  /// SHA-256 of the JSON Talk2Tax generated for the document when the response was imported.
  payloadHash       String         @map("payload_hash") @db.Char(64)
  status            EInvoiceStatus @default(ACTIVE)
  cancelledAt       DateTime?      @map("cancelled_at") @db.Timestamptz(6)
  cancelReason      String?        @map("cancel_reason") @db.Char(1)
  cancelRemark      String?        @map("cancel_remark")
  createdById       String         @map("created_by_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  cancelledById     String?        @map("cancelled_by_id") @db.Uuid
  org               Organization   @relation(fields: [orgId], references: [id], onDelete: Restrict)
  document          Document       @relation(fields: [documentId, orgId], references: [id, orgId], onDelete: Restrict)

  @@unique([orgId, irn])
  @@index([documentId])
  @@map("e_invoices")
}

/// E-way bill set-up (India, CGST Rule 138): thresholds and the place goods are dispatched from.
model EWayBillSettings {
  orgId               String       @id @map("org_id") @db.Uuid
  /// Consignment value above which an e-way bill is needed (Rs 50,000 under Rule 138(1)).
  threshold           Decimal      @default(50000) @db.Decimal(18, 2)
  /// The organisation's state's own threshold for movement within the state, when it has one.
  intraStateThreshold Decimal?     @map("intra_state_threshold") @db.Decimal(18, 2)
  address1            String
  address2            String?
  city                String
  pincode             String       @db.Char(6)
  /// UQC for goods lines, for example NOS.
  goodsUnit           String       @default("NOS") @map("goods_unit")
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  org                 Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@map("e_way_bill_settings")
}

enum EWayBillStatus {
  ACTIVE
  CANCELLED
}

enum TransportMode {
  ROAD
  RAIL
  AIR
  SHIP
}

/// An e-way bill generated on the portal for an invoice, as recorded by the user. Never edited:
/// Part B changes are separate rows, and the only change is a single move to CANCELLED.
model EWayBill {
  id              String                  @id @default(uuid()) @db.Uuid
  orgId           String                  @map("org_id") @db.Uuid
  documentId      String                  @map("document_id") @db.Uuid
  /// The 12-digit e-way bill number.
  number          String                  @db.Char(12)
  generatedAt     DateTime                @map("generated_at") @db.Timestamptz(6)
  /// As the portal shows it; null while there is no Part B.
  validUntil      DateTime?               @map("valid_until") @db.Timestamptz(6)
  distanceKm      Int                     @map("distance_km")
  /// R regular, O over-dimensional cargo.
  vehicleType     String                  @default("R") @map("vehicle_type") @db.Char(1)
  /// null: Part A only.
  transportMode   TransportMode?          @map("transport_mode")
  vehicleNo       String?                 @map("vehicle_no")
  transporterId   String?                 @map("transporter_id") @db.Char(15)
  transporterName String?                 @map("transporter_name")
  transDocNo      String?                 @map("trans_doc_no")
  transDocDate    DateTime?               @map("trans_doc_date") @db.Date
  /// SHA-256 of the JSON Talk2Tax generated with these details.
  payloadHash     String                  @map("payload_hash") @db.Char(64)
  status          EWayBillStatus          @default(ACTIVE)
  cancelledAt     DateTime?               @map("cancelled_at") @db.Timestamptz(6)
  cancelReason    String?                 @map("cancel_reason") @db.Char(1)
  cancelRemark    String?                 @map("cancel_remark")
  createdById     String                  @map("created_by_id") @db.Uuid
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  cancelledById   String?                 @map("cancelled_by_id") @db.Uuid
  org             Organization            @relation(fields: [orgId], references: [id], onDelete: Restrict)
  document        Document                @relation(fields: [documentId, orgId], references: [id, orgId], onDelete: Restrict)
  vehicleUpdates  EWayBillVehicleUpdate[]

  @@unique([id, orgId])
  @@unique([orgId, number])
  @@index([documentId])
  @@map("e_way_bills")
}

/// A Part B update made on the portal (first vehicle, breakdown, transhipment). Append-only.
model EWayBillVehicleUpdate {
  id            String        @id @default(uuid()) @db.Uuid
  orgId         String        @map("org_id") @db.Uuid
  eWayBillId    String        @map("e_way_bill_id") @db.Uuid
  updatedAt     DateTime      @map("updated_at") @db.Timestamptz(6)
  transportMode TransportMode @map("transport_mode")
  vehicleNo     String?       @map("vehicle_no")
  transDocNo    String?       @map("trans_doc_no")
  transDocDate  DateTime?     @map("trans_doc_date") @db.Date
  fromPlace     String        @map("from_place")
  fromStateCode String        @map("from_state_code") @db.Char(2)
  reason        String        @db.Char(1)
  remark        String
  /// Validity the portal shows after the update (set on the first Part B).
  validUntil    DateTime?     @map("valid_until") @db.Timestamptz(6)
  createdById   String        @map("created_by_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  org           Organization  @relation(fields: [orgId], references: [id], onDelete: Restrict)
  eWayBill      EWayBill      @relation(fields: [eWayBillId, orgId], references: [id, orgId], onDelete: Restrict)

  @@index([eWayBillId])
  @@map("e_way_bill_vehicle_updates")
}

// ---------------------------------------------------------------- budgets (M4)

enum BudgetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  SUPERSEDED
}

/// One version of a fiscal year's budget. Versions are numbered per year; a new version
/// starts empty, from another version or from last year's actuals. Only drafts change.
/// At most one version per year is APPROVED; approving another supersedes it.
model Budget {
  id             String       @id @default(uuid()) @db.Uuid
  orgId          String       @map("org_id") @db.Uuid
  /// Labelled by the calendar year the fiscal year ends in (FY2027 = Apr 2026 to Mar 2027).
  fiscalYear     Int          @map("fiscal_year")
  version        Int
  name           String
  note           String?
  /// EMPTY, COPY (of sourceBudgetId) or PRIOR_ACTUALS (with changePercent).
  basis          String
  sourceBudgetId String?      @map("source_budget_id") @db.Uuid
  changePercent  Decimal?     @map("change_percent") @db.Decimal(7, 2)
  status         BudgetStatus @default(DRAFT)
  createdById    String       @map("created_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  submittedById  String?      @map("submitted_by_id") @db.Uuid
  submittedAt    DateTime?    @map("submitted_at") @db.Timestamptz(6)
  approvedById   String?      @map("approved_by_id") @db.Uuid
  approvedAt     DateTime?    @map("approved_at") @db.Timestamptz(6)
  supersededAt   DateTime?    @map("superseded_at") @db.Timestamptz(6)
  /// The last time it was sent back, by whom and why (the audit trail keeps every one).
  returnedById   String?      @map("returned_by_id") @db.Uuid
  returnedAt     DateTime?    @map("returned_at") @db.Timestamptz(6)
  returnReason   String?      @map("return_reason")
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  lines          BudgetLine[]

  @@unique([orgId, fiscalYear, version])
  @@unique([id, orgId])
  @@map("budgets")
}

/// One account's amount for one month of a budget, on the account's normal side.
model BudgetLine {
  id        String       @id @default(uuid()) @db.Uuid
  orgId     String       @map("org_id") @db.Uuid
  budgetId  String       @map("budget_id") @db.Uuid
  accountId String       @map("account_id") @db.Uuid
  periodNo  Int          @map("period_no") @db.SmallInt
  amount    Decimal      @db.Decimal(18, 2)
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  budget    Budget       @relation(fields: [budgetId, orgId], references: [id, orgId], onDelete: Restrict)
  account   Account      @relation(fields: [accountId, orgId], references: [id, orgId], onDelete: Restrict)

  @@unique([budgetId, accountId, periodNo])
  @@index([accountId])
  @@map("budget_lines")
}

// ---------------------------------------------------------------- cash-flow forecast (M4)

/// The cash balance below which the forecast warns.
model CashFlowSettings {
  orgId          String       @id @map("org_id") @db.Uuid
  minimumBalance Decimal      @default(0) @map("minimum_balance") @db.Decimal(18, 2)
  updatedById    String       @map("updated_by_id") @db.Uuid
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@map("cash_flow_settings")
}

enum CashFlowDirection {
  IN
  OUT
}

enum PlannedFrequency {
  ONCE
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

/// A receipt or payment the books do not hold yet: rent, a loan instalment, tax, a planned sale.
model CashFlowItem {
  id          String            @id @default(uuid()) @db.Uuid
  orgId       String            @map("org_id") @db.Uuid
  name        String
  direction   CashFlowDirection
  amount      Decimal           @db.Decimal(18, 2)
  frequency   PlannedFrequency
  startDate   DateTime          @map("start_date") @db.Date
  endDate     DateTime?         @map("end_date") @db.Date
  note        String?
  isActive    Boolean           @default(true) @map("is_active")
  createdById String            @map("created_by_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  org         Organization      @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@unique([id, orgId])
  @@index([orgId])
  @@map("cash_flow_items")
}

/// A forecast as it was worked out on a day, kept unchanged so it can be compared with what
/// happened. A backtest is worked out as of an earlier date from the records dated up to it.
model CashForecast {
  id             String       @id @default(uuid()) @db.Uuid
  orgId          String       @map("org_id") @db.Uuid
  asOf           DateTime     @map("as_of") @db.Date
  horizonDays    Int          @map("horizon_days")
  isBacktest     Boolean      @map("is_backtest")
  opening        Decimal      @db.Decimal(18, 2)
  closingBase    Decimal      @map("closing_base") @db.Decimal(18, 2)
  minimumBalance Decimal?     @map("minimum_balance") @db.Decimal(18, 2)
  /// [{ date, base, low, high }] for every day of the horizon.
  days           Json
  /// What went in: totals by kind, item counts and the payment delays used.
  inputs         Json
  note           String?
  createdById    String       @map("created_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@index([orgId, createdAt])
  @@map("cash_forecasts")
}

enum KpiComparator {
  AT_LEAST
  AT_MOST
}

/// A target for one KPI: the value it should be at least or at most.
model KpiTarget {
  id          String        @id @default(uuid()) @db.Uuid
  orgId       String        @map("org_id") @db.Uuid
  kpi         String        @db.VarChar(40)
  comparator  KpiComparator
  target      Decimal       @db.Decimal(20, 4)
  note        String?       @db.VarChar(500)
  updatedById String        @map("updated_by_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  org         Organization  @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@unique([orgId, kpi])
  @@map("kpi_targets")
}

enum ManagementReportStatus {
  DRAFT
  FINAL
}

/// The monthly management report: commentary while a draft; once final, a frozen copy of
/// its figures that later postings cannot change.
model ManagementReport {
  id            String                 @id @default(uuid()) @db.Uuid
  orgId         String                 @map("org_id") @db.Uuid
  /// The first day of the month reported on.
  month         DateTime               @db.Date
  commentary    String                 @default("")
  status        ManagementReportStatus @default(DRAFT)
  snapshot      Json?
  finalisedById String?                @map("finalised_by_id") @db.Uuid
  finalisedAt   DateTime?              @map("finalised_at") @db.Timestamptz(6)
  updatedById   String                 @map("updated_by_id") @db.Uuid
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  org           Organization           @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@unique([orgId, month])
  @@map("management_reports")
}

enum AlertSeverity {
  CRITICAL
  WARNING
  INFO
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  DISMISSED
  CLEARED
}

enum AlertAction {
  OPENED
  ACKNOWLEDGED
  DISMISSED
  REOPENED
  CLEARED
}

/// An organisation's settings for one alert check: on or off, and its thresholds.
model AlertRuleSetting {
  id          String       @id @default(uuid()) @db.Uuid
  orgId       String       @map("org_id") @db.Uuid
  rule        String       @db.VarChar(40)
  enabled     Boolean      @default(true)
  /// Threshold values as decimal strings, by setting key.
  params      Json         @default("{}")
  updatedById String       @map("updated_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@unique([orgId, rule])
  @@map("alert_rule_settings")
}

/// Something a check found. One row per rule and finding (fingerprint) for the life of the
/// organisation: it clears when no longer found, reopens when found again, and a dismissed
/// alert stays dismissed.
model Alert {
  id          String        @id @default(uuid()) @db.Uuid
  orgId       String        @map("org_id") @db.Uuid
  rule        String        @db.VarChar(40)
  fingerprint String        @db.VarChar(200)
  severity    AlertSeverity
  title       String        @db.VarChar(300)
  summary     String        @db.VarChar(2000)
  /// The amount at stake, in the functional currency, when there is one.
  amount      Decimal?      @db.Decimal(24, 6)
  /// The figures and records the alert was raised on.
  evidence    Json
  status      AlertStatus   @default(OPEN)
  /// The acknowledgement note or the reason for dismissing.
  statusNote  String?       @map("status_note") @db.VarChar(1000)
  statusById  String?       @map("status_by_id") @db.Uuid
  statusAt    DateTime?     @map("status_at") @db.Timestamptz(6)
  firstSeenAt DateTime      @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt  DateTime      @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  clearedAt   DateTime?     @map("cleared_at") @db.Timestamptz(6)
  reopenCount Int           @default(0) @map("reopen_count")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  org         Organization  @relation(fields: [orgId], references: [id], onDelete: Restrict)
  events      AlertEvent[]

  @@unique([orgId, rule, fingerprint])
  @@unique([id, orgId])
  @@index([orgId, status])
  @@map("alerts")
}

/// The history of an alert. Append-only. No actor = the checks did it.
model AlertEvent {
  id        String       @id @default(uuid()) @db.Uuid
  orgId     String       @map("org_id") @db.Uuid
  alertId   String       @map("alert_id") @db.Uuid
  action    AlertAction
  actorId   String?      @map("actor_id") @db.Uuid
  note      String?      @db.VarChar(1000)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  alert     Alert        @relation(fields: [alertId, orgId], references: [id, orgId], onDelete: Restrict)

  @@index([orgId, alertId])
  @@map("alert_events")
}

/// One run of the checks. Append-only.
model AlertScan {
  id         String       @id @default(uuid()) @db.Uuid
  orgId      String       @map("org_id") @db.Uuid
  /// Null when the checks ran by themselves because the last run was stale.
  ranById    String?      @map("ran_by_id") @db.Uuid
  startedAt  DateTime     @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime     @map("finished_at") @db.Timestamptz(6)
  rulesRun   Int          @map("rules_run")
  found      Int
  opened     Int
  reopened   Int
  cleared    Int
  /// Checks that could not run, with the reason.
  failures   Json         @default("[]")
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@index([orgId, finishedAt])
  @@map("alert_scans")
}

// ---------------------------------------------------------------- AI copilot (M4)

enum CopilotRole {
  USER
  ASSISTANT
}

enum CopilotMessageStatus {
  /// The assistant is still working on the answer.
  PENDING
  COMPLETE
  /// The model declined to answer.
  REFUSED
  /// Stopped before a full answer: too many steps, or the answer was cut off.
  INCOMPLETE
  /// The AI provider could not be reached or returned an error.
  FAILED
}

/// Whether the organisation lets its members use the copilot. Off until an owner or admin turns it on, because questions and figures are sent to the AI provider.
model CopilotSettings {
  orgId       String       @id @map("org_id") @db.Uuid
  enabled     Boolean      @default(false)
  /// Set when AI was turned off with the emergency stop: why, in the words of the person who stopped it.
  offReason   String?      @map("off_reason") @db.VarChar(500)
  updatedById String       @map("updated_by_id") @db.Uuid
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@map("copilot_settings")
}

/// The AI features (agents) the control center governs.
enum AiAgent {
  COPILOT
  COLLECTIONS
  BANKING
  CLOSE
}

/// Per-organisation switch and monthly token budget for one AI agent. No row means on, with no budget.
model AiAgentSetting {
  orgId             String       @map("org_id") @db.Uuid
  agent             AiAgent
  enabled           Boolean      @default(true)
  /// Input plus output tokens the agent may use in a calendar month (India time). Null means no budget.
  monthlyTokenLimit Int?         @map("monthly_token_limit")
  updatedById       String       @map("updated_by_id") @db.Uuid
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  org               Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@id([orgId, agent])
  @@map("ai_agent_settings")
}

/// A conversation belongs to the member who started it; nobody else sees it.
model CopilotConversation {
  id             String           @id @default(uuid()) @db.Uuid
  orgId          String           @map("org_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  title          String           @db.VarChar(200)
  /// The model, instructions and tool set the conversation was started with. A conversation is only continued with the same ones, so the model always sees the history it produced.
  model          String           @db.VarChar(100)
  toolsetVersion Int              @map("toolset_version")
  systemPrompt   String           @map("system_prompt")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  org            Organization     @relation(fields: [orgId], references: [id], onDelete: Restrict)
  messages       CopilotMessage[]

  @@unique([id, orgId])
  @@index([orgId, userId, updatedAt])
  @@map("copilot_conversations")
}

model CopilotMessage {
  id              String               @id @default(uuid()) @db.Uuid
  orgId           String               @map("org_id") @db.Uuid
  conversationId  String               @map("conversation_id") @db.Uuid
  seq             Int
  role            CopilotRole
  status          CopilotMessageStatus
  /// The question, or the answer's text.
  text            String?
  /// The exact messages exchanged with the model for this turn (thinking, tool calls and tool results included), replayed unchanged on later turns.
  apiMessages     Json                 @default("[]") @map("api_messages")
  /// What the assistant looked at: one entry per tool call, with its input and the page it comes from.
  sources         Json                 @default("[]")
  errorCode       String?              @map("error_code") @db.VarChar(60)
  errorMessage    String?              @map("error_message") @db.VarChar(1000)
  /// The model that answered (can differ from the conversation's when the provider fell back to another model).
  servedModel     String?              @map("served_model") @db.VarChar(100)
  inputTokens     Int?                 @map("input_tokens")
  outputTokens    Int?                 @map("output_tokens")
  cacheReadTokens Int?                 @map("cache_read_tokens")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt     DateTime?            @map("completed_at") @db.Timestamptz(6)
  org             Organization         @relation(fields: [orgId], references: [id], onDelete: Restrict)
  conversation    CopilotConversation  @relation(fields: [conversationId, orgId], references: [id, orgId], onDelete: Cascade)

  @@unique([conversationId, seq])
  @@index([orgId, status])
  @@map("copilot_messages")
}

// ---------------------------------------------------------------- workflow automations and tasks (M5)

enum WorkflowRunStatus {
  /// The conditions did not match: nothing was done.
  SKIPPED
  /// Actions are still being carried out (a webhook waiting for delivery or a retry).
  RUNNING
  SUCCEEDED
  /// At least one action failed for good.
  FAILED
  /// A test run: conditions checked and actions shown, nothing done.
  TEST
}

enum WorkflowActionStatus {
  PENDING
  SUCCEEDED
  FAILED
  /// Not carried out: a test run, or a webhook cancelled by a person.
  SKIPPED
}

enum TaskStatus {
  OPEN
  DONE
  CANCELLED
}

/// One automation. Its definition lives in versions; editing adds a version.
model Workflow {
  id                String            @id @default(uuid()) @db.Uuid
  orgId             String            @map("org_id") @db.Uuid
  name              String            @db.VarChar(120)
  description       String?           @db.VarChar(1000)
  enabled           Boolean           @default(false)
  currentVersion    Int               @map("current_version")
  /// Events at or before this audit-trail id are never acted on (set when the workflow is turned on), so turning a workflow on never replays history.
  activeFromEventId BigInt?           @map("active_from_event_id")
  /// When the workflow was last turned on. Schedule triggers act only on times and dates from then, so turning one on never sends a backlog.
  activatedAt       DateTime?         @map("activated_at") @db.Timestamptz(6)
  /// Secret for signing webhook deliveries (HMAC-SHA256).
  signingSecret     String            @map("signing_secret") @db.VarChar(100)
  createdById       String            @map("created_by_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  org               Organization      @relation(fields: [orgId], references: [id], onDelete: Restrict)
  versions          WorkflowVersion[]
  runs              WorkflowRun[]

  @@unique([id, orgId])
  @@index([orgId, enabled])
  @@map("workflows")
}

model WorkflowVersion {
  id            String       @id @default(uuid()) @db.Uuid
  orgId         String       @map("org_id") @db.Uuid
  workflowId    String       @map("workflow_id") @db.Uuid
  version       Int
  trigger       String       @db.VarChar(40)
  /// Settings of a schedule trigger (frequency and time, or days); {} for event triggers.
  triggerParams Json         @default("{}") @map("trigger_params")
  conditions    Json
  actions       Json
  note          String?      @db.VarChar(500)
  createdById   String       @map("created_by_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  workflow      Workflow     @relation(fields: [workflowId, orgId], references: [id, orgId], onDelete: Restrict)

  @@unique([workflowId, version])
  @@map("workflow_versions")
}

/// One event looked at by one workflow version (or a test run).
model WorkflowRun {
  id            String              @id @default(uuid()) @db.Uuid
  orgId         String              @map("org_id") @db.Uuid
  workflowId    String              @map("workflow_id") @db.Uuid
  version       Int
  trigger       String              @db.VarChar(40)
  /// The audit-trail event that started the run (null for a test run without one).
  eventId       BigInt?             @map("event_id")
  /// What a schedule trigger acted on, unique per workflow: "at:<time>" for a schedule, "doc:<id>:<days>" for a date trigger.
  occurrenceKey String?             @map("occurrence_key") @db.VarChar(100)
  entityType    String?             @map("entity_type") @db.VarChar(40)
  entityId      String?             @map("entity_id") @db.VarChar(64)
  facts         Json
  /// Each condition with its result and the value it saw.
  conditions    Json
  status        WorkflowRunStatus
  error         String?             @db.VarChar(1000)
  testedById    String?             @map("tested_by_id") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  finishedAt    DateTime?           @map("finished_at") @db.Timestamptz(6)
  org           Organization        @relation(fields: [orgId], references: [id], onDelete: Restrict)
  workflow      Workflow            @relation(fields: [workflowId, orgId], references: [id, orgId], onDelete: Restrict)
  actions       WorkflowActionRun[]

  @@unique([id, orgId])
  @@index([orgId, workflowId, createdAt])
  @@map("workflow_runs")
}

model WorkflowActionRun {
  id            String               @id @default(uuid()) @db.Uuid
  orgId         String               @map("org_id") @db.Uuid
  runId         String               @map("run_id") @db.Uuid
  position      Int
  type          String               @db.VarChar(20)
  status        WorkflowActionStatus
  /// What the action was given: the rendered task, or the webhook address and body.
  input         Json
  /// What happened: the task created, or each delivery attempt with its HTTP status.
  result        Json                 @default("{}")
  attempts      Int                  @default(0)
  nextAttemptAt DateTime?            @map("next_attempt_at") @db.Timestamptz(6)
  /// A delivery in progress holds the action until this time, so two runners never send it twice at once.
  lockedUntil   DateTime?            @map("locked_until") @db.Timestamptz(6)
  error         String?              @db.VarChar(1000)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  finishedAt    DateTime?            @map("finished_at") @db.Timestamptz(6)
  org           Organization         @relation(fields: [orgId], references: [id], onDelete: Restrict)
  run           WorkflowRun          @relation(fields: [runId, orgId], references: [id, orgId], onDelete: Restrict)

  @@unique([runId, position])
  @@index([status, nextAttemptAt])
  @@map("workflow_action_runs")
}

/// How far through the organisation's audit trail the workflows have read.
model WorkflowCursor {
  orgId       String       @id @map("org_id") @db.Uuid
  lastEventId BigInt       @map("last_event_id")
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@map("workflow_cursors")
}

/// A to-do for a person or a role, made by a person or by a workflow.
model Task {
  id             String       @id @default(uuid()) @db.Uuid
  orgId          String       @map("org_id") @db.Uuid
  title          String       @db.VarChar(200)
  description    String?      @db.VarChar(2000)
  status         TaskStatus   @default(OPEN)
  assigneeUserId String?      @map("assignee_user_id") @db.Uuid
  assigneeRole   String?      @map("assignee_role") @db.VarChar(20)
  dueDate        DateTime?    @map("due_date") @db.Date
  /// What the task is about, for a link: DOCUMENT, PAYMENT, JOURNAL, EXPENSE_CLAIM, ALERT or PERIOD_CLOSE (the period id).
  linkType       String?      @map("link_type") @db.VarChar(20)
  linkId         String?      @map("link_id") @db.VarChar(64)
  workflowRunId  String?      @map("workflow_run_id") @db.Uuid
  createdById    String?      @map("created_by_id") @db.Uuid
  closedById     String?      @map("closed_by_id") @db.Uuid
  closedAt       DateTime?    @map("closed_at") @db.Timestamptz(6)
  closeNote      String?      @map("close_note") @db.VarChar(1000)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@index([orgId, status])
  @@index([orgId, assigneeUserId, status])
  @@map("tasks")
}

// ---------------------------------------------------------------- collections (M5 slice 3)

enum CollectionRunStatus {
  RUNNING
  DONE
}

enum CollectionDraftStatus {
  /// The AI model is writing it.
  DRAFTING
  /// Written and checked; waiting for a person to send, edit or reject it.
  READY
  /// Approved by a person and accepted by the mail server.
  SENT
  /// Approved by a person, but the mail server did not accept it. It can be sent again.
  SEND_FAILED
  /// A person decided not to send it.
  REJECTED
  /// The AI model could not write it.
  FAILED
}

/// One press of "Draft reminders": which customers were looked at, drafted for or skipped and why.
model CollectionRun {
  id          String              @id @default(uuid()) @db.Uuid
  orgId       String              @map("org_id") @db.Uuid
  status      CollectionRunStatus @default(RUNNING)
  startedById String              @map("started_by_id") @db.Uuid
  /// Customers with overdue invoices left out, each with the reason: [{contactId, name, reason}].
  skipped     Json                @default("[]")
  model       String              @db.VarChar(100)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  finishedAt  DateTime?           @map("finished_at") @db.Timestamptz(6)
  org         Organization        @relation(fields: [orgId], references: [id], onDelete: Restrict)
  drafts      CollectionDraft[]

  @@unique([id, orgId])
  @@index([orgId, createdAt])
  @@map("collection_runs")
}

/// A payment reminder for one customer: the facts from the books it was written from, what
/// the AI model wrote and why, the checks against the books, and what a person decided.
model CollectionDraft {
  id           String                @id @default(uuid()) @db.Uuid
  orgId        String                @map("org_id") @db.Uuid
  runId        String                @map("run_id") @db.Uuid
  contactId    String                @map("contact_id") @db.Uuid
  status       CollectionDraftStatus @default(DRAFTING)
  toEmail      String                @map("to_email") @db.VarChar(320)
  /// The facts the draft was written from (open invoices, payment history, earlier reminders), as given to the model.
  facts        Json
  risk         String?               @db.VarChar(10)
  riskReasons  Json                  @default("[]") @map("risk_reasons")
  /// What the model wrote, kept as written even when a person edits the email.
  aiSubject    String?               @map("ai_subject") @db.VarChar(300)
  aiBody       String?               @map("ai_body")
  /// The email as it is (or was) sent: the model's words, or a person's edit.
  subject      String?               @db.VarChar(300)
  body         String?
  edited       Boolean               @default(false)
  checks       Json                  @default("[]")
  model        String                @db.VarChar(100)
  servedModel  String?               @map("served_model") @db.VarChar(100)
  inputTokens  Int?                  @map("input_tokens")
  outputTokens Int?                  @map("output_tokens")
  errorCode    String?               @map("error_code") @db.VarChar(40)
  errorMessage String?               @map("error_message") @db.VarChar(1000)
  decidedById  String?               @map("decided_by_id") @db.Uuid
  decidedAt    DateTime?             @map("decided_at") @db.Timestamptz(6)
  decisionNote String?               @map("decision_note") @db.VarChar(500)
  sendAttempts Int                   @default(0) @map("send_attempts")
  /// Each send attempt: when, the SMTP answer and any error.
  sendLog      Json                  @default("[]") @map("send_log")
  sentAt       DateTime?             @map("sent_at") @db.Timestamptz(6)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  org          Organization          @relation(fields: [orgId], references: [id], onDelete: Restrict)
  run          CollectionRun         @relation(fields: [runId, orgId], references: [id, orgId], onDelete: Restrict)
  contact      Contact               @relation(fields: [contactId, orgId], references: [id, orgId], onDelete: Restrict)

  @@index([orgId, status, createdAt])
  @@index([orgId, contactId, createdAt])
  @@map("collection_drafts")
}

enum BankAiRunStatus {
  RUNNING
  DONE
}

enum BankAiSuggestionStatus {
  /// The AI model is looking at the line.
  DRAFTING
  /// A proposal, checked; waiting for a person to accept or dismiss it.
  READY
  /// A person accepted it and it was applied.
  ACCEPTED
  /// A person dismissed it, or the line was dealt with another way.
  DISMISSED
  /// No proposal: the model declined, answered badly or could not be reached.
  FAILED
}

enum BankAiAction {
  MATCH
  PAYMENT
  ENTRY
  NONE
}

/// One run of AI reconciliation on one bank account.
model BankAiRun {
  id          String             @id @default(uuid()) @db.Uuid
  orgId       String             @map("org_id") @db.Uuid
  accountId   String             @map("account_id") @db.Uuid
  status      BankAiRunStatus    @default(RUNNING)
  startedById String             @map("started_by_id") @db.Uuid
  /// Unmatched lines left out, each with the reason: [{lineId, date, amount, description, reason}].
  skipped     Json               @default("[]")
  model       String             @db.VarChar(100)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  finishedAt  DateTime?          @map("finished_at") @db.Timestamptz(6)
  org         Organization       @relation(fields: [orgId], references: [id], onDelete: Restrict)
  suggestions BankAiSuggestion[]

  @@unique([id, orgId])
  @@index([orgId, accountId, createdAt])
  @@map("bank_ai_runs")
}

/// What the AI model proposed for one unmatched bank line: what it was shown, what it
/// proposed and why, the checks, and what a person decided.
model BankAiSuggestion {
  id              String                 @id @default(uuid()) @db.Uuid
  orgId           String                 @map("org_id") @db.Uuid
  runId           String                 @map("run_id") @db.Uuid
  statementLineId String                 @map("statement_line_id") @db.Uuid
  status          BankAiSuggestionStatus @default(DRAFTING)
  /// What the model was shown, with the ids its references stand for (BankLineContext).
  context         Json
  action          BankAiAction?
  /// What the model sent, with references (BankProposalInput).
  proposal        Json?
  /// The proposal with ids, when every check passed (ResolvedProposal).
  resolved        Json?
  confidence      String?                @db.VarChar(10)
  reason          String?
  checks          Json                   @default("[]")
  model           String                 @db.VarChar(100)
  servedModel     String?                @map("served_model") @db.VarChar(100)
  inputTokens     Int?                   @map("input_tokens")
  outputTokens    Int?                   @map("output_tokens")
  errorCode       String?                @map("error_code") @db.VarChar(40)
  errorMessage    String?                @map("error_message")
  decidedById     String?                @map("decided_by_id") @db.Uuid
  decidedAt       DateTime?              @map("decided_at") @db.Timestamptz(6)
  decisionNote    String?                @map("decision_note")
  /// What accepting it created: {journalEntryIds, paymentId, paymentNumber}.
  result          Json?
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  org             Organization           @relation(fields: [orgId], references: [id], onDelete: Restrict)
  run             BankAiRun              @relation(fields: [runId, orgId], references: [id, orgId], onDelete: Restrict)
  statementLine   BankStatementLine      @relation(fields: [statementLineId, orgId], references: [id, orgId], onDelete: Restrict)

  @@index([orgId, status, createdAt])
  @@index([orgId, statementLineId])
  @@map("bank_ai_suggestions")
}

// ---------------------------------------------------------------- month-end close (M5 slice 5)

enum PeriodCloseStatus {
  IN_PROGRESS
  CLOSED
}

/// The month-end close of one period: started by a person, closed (and the period locked) by an owner or admin.
model PeriodClose {
  id             String               @id @default(uuid()) @db.Uuid
  orgId          String               @map("org_id") @db.Uuid
  periodId       String               @unique @map("period_id") @db.Uuid
  status         PeriodCloseStatus    @default(IN_PROGRESS)
  startedById    String               @map("started_by_id") @db.Uuid
  /// Task made for each open check, by check key: { "DRAFT_JOURNALS": "<task id>" }.
  tasks          Json                 @default("{}")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  org            Organization         @relation(fields: [orgId], references: [id], onDelete: Restrict)
  period         FiscalPeriod         @relation(fields: [periodId, orgId], references: [id, orgId], onDelete: Restrict)
  certifications CloseCertification[]
  reviews        CloseAiReview[]
  adjustments    CloseAdjustment[]

  @@unique([periodId, orgId])
  @@unique([id, orgId])
  @@index([orgId, status])
  @@map("period_closes")
}

/// What was true when a month was closed, and who certified it. Never changed except once when reopened.
model CloseCertification {
  id            String       @id @default(uuid()) @db.Uuid
  orgId         String       @map("org_id") @db.Uuid
  closeId       String       @map("close_id") @db.Uuid
  certifiedById String       @map("certified_by_id") @db.Uuid
  certifiedAt   DateTime     @default(now()) @map("certified_at") @db.Timestamptz(6)
  note          String?      @db.VarChar(2000)
  checks        Json
  totals        Json
  reopenedById  String?      @map("reopened_by_id") @db.Uuid
  reopenedAt    DateTime?    @map("reopened_at") @db.Timestamptz(6)
  reopenReason  String?      @map("reopen_reason") @db.VarChar(2000)
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  close         PeriodClose  @relation(fields: [closeId, orgId], references: [id, orgId], onDelete: Restrict)

  @@index([orgId, closeId])
  @@map("close_certifications")
}

enum CloseReviewStatus {
  RUNNING
  DONE
  FAILED
}

/// One AI review of a month being closed: what it was shown, what it said, and its usage.
model CloseAiReview {
  id           String            @id @default(uuid()) @db.Uuid
  orgId        String            @map("org_id") @db.Uuid
  closeId      String            @map("close_id") @db.Uuid
  status       CloseReviewStatus @default(RUNNING)
  startedById  String            @map("started_by_id") @db.Uuid
  context      Json
  summary      String?
  findings     Json?
  model        String
