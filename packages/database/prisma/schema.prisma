  errorCode    String?           @map("error_code")
  errorMessage String?           @map("error_message")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  finishedAt   DateTime?         @map("finished_at") @db.Timestamptz(6)
  org          Organization      @relation(fields: [orgId], references: [id], onDelete: Restrict)
  close        PeriodClose       @relation(fields: [closeId, orgId], references: [id, orgId], onDelete: Restrict)
  adjustments  CloseAdjustment[]

  @@unique([id, orgId])
  @@index([orgId, closeId, createdAt])
  @@map("close_ai_reviews")
}

enum CloseAdjustmentStatus {
  READY
  POSTED
  REJECTED
  SUPERSEDED
}

/// An adjusting entry the AI model proposed at month end. Posted only when a person approves it.
model CloseAdjustment {
  id              String                @id @default(uuid()) @db.Uuid
  orgId           String                @map("org_id") @db.Uuid
  closeId         String                @map("close_id") @db.Uuid
  reviewId        String                @map("review_id") @db.Uuid
  status          CloseAdjustmentStatus @default(READY)
  proposal        Json
  resolved        Json?
  checks          Json
  confidence      String
  reason          String
  journalEntryId  String?               @map("journal_entry_id") @db.Uuid
  reversalEntryId String?               @map("reversal_entry_id") @db.Uuid
  decidedById     String?               @map("decided_by_id") @db.Uuid
  decidedAt       DateTime?             @map("decided_at") @db.Timestamptz(6)
  decisionNote    String?               @map("decision_note") @db.VarChar(1000)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  org             Organization          @relation(fields: [orgId], references: [id], onDelete: Restrict)
