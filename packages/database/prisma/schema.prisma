enum CrmLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  DISQUALIFIED
  CONVERTED
}

enum CrmLeadSource {
  WEBSITE
  REFERRAL
  EVENT
  OUTBOUND
  PARTNER
  ADVERTISING
  OTHER
}

enum CrmDealStage {
  PROSPECTING
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum CrmActivityKind {
  CREATED
  NOTE
  CALL
  EMAIL
  MEETING
  STATUS_CHANGED
  STAGE_CHANGED
  CONVERTED
  UPDATED
}

/// Someone who might buy. Never deleted; once converted to a customer it is closed for good.
model CrmLead {
  id                 String        @id @default(uuid()) @db.Uuid
  orgId              String        @map("org_id") @db.Uuid
  /// Shown as LD-0001.
  number             Int
  name               String        @db.VarChar(200)
  company            String?       @db.VarChar(200)
  email              String?       @db.VarChar(254)
  phone              String?       @db.VarChar(40)
  source             CrmLeadSource @default(OTHER)
  status             CrmLeadStatus @default(NEW)
  /// The member working the lead.
  ownerId            String?       @map("owner_id") @db.Uuid
  /// A first guess at what the lead might buy, in the functional currency.
  estimatedValue     Decimal?      @map("estimated_value") @db.Decimal(24, 6)
  notes              String?       @db.VarChar(2000)
  /// The other system's id when the lead came through the CRM API; unique in the organisation.
  externalRef        String?       @map("external_ref") @db.VarChar(100)
  disqualifiedReason String?       @map("disqualified_reason") @db.VarChar(500)
  convertedContactId String?       @map("converted_contact_id") @db.Uuid
  convertedDealId    String?       @map("converted_deal_id") @db.Uuid
  convertedAt        DateTime?     @map("converted_at") @db.Timestamptz(6)
  createdById        String        @map("created_by_id") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  org                Organization  @relation(fields: [orgId], references: [id], onDelete: Restrict)
  activities         CrmActivity[]

  @@unique([orgId, number])
  @@unique([id, orgId])
  @@unique([orgId, externalRef])
  @@index([orgId, status])
  @@map("crm_leads")
}

/// A sale being worked on for a customer, through the pipeline stages to won or lost. Never deleted.
model CrmDeal {
  id                String        @id @default(uuid()) @db.Uuid
  orgId             String        @map("org_id") @db.Uuid
  /// Shown as DL-0001.
  number            Int
  name              String        @db.VarChar(200)
  contactId         String        @map("contact_id") @db.Uuid
  /// The lead it came from, when it was converted from one.
  leadId            String?       @map("lead_id") @db.Uuid
  /// In the organisation's functional currency.
  amount            Decimal       @db.Decimal(24, 6)
  stage             CrmDealStage  @default(PROSPECTING)
  /// Whole percent, 0 to 100.
  probability       Int
  expectedCloseDate DateTime      @map("expected_close_date") @db.Date
  ownerId           String?       @map("owner_id") @db.Uuid
  closedOn          DateTime?     @map("closed_on") @db.Date
  lostReason        String?       @map("lost_reason") @db.VarChar(500)
  notes             String?       @db.VarChar(2000)
  /// The other system's id when the deal came through the CRM API; unique in the organisation.
  externalRef       String?       @map("external_ref") @db.VarChar(100)
  createdById       String        @map("created_by_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  org               Organization  @relation(fields: [orgId], references: [id], onDelete: Restrict)
  activities        CrmActivity[]

  @@unique([orgId, number])
  @@unique([id, orgId])
  @@unique([orgId, externalRef])
  @@index([orgId, stage])
  @@index([orgId, contactId])
  @@map("crm_deals")
}

/// What happened on a lead or a deal: notes, calls, emails, meetings and every change. Append-only.
model CrmActivity {
  id        String          @id @default(uuid()) @db.Uuid
  orgId     String          @map("org_id") @db.Uuid
  leadId    String?         @map("lead_id") @db.Uuid
  dealId    String?         @map("deal_id") @db.Uuid
  kind      CrmActivityKind
  body      String?         @db.VarChar(4000)
  data      Json?
  actorId   String          @map("actor_id") @db.Uuid
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  org       Organization    @relation(fields: [orgId], references: [id], onDelete: Restrict)
  lead      CrmLead?        @relation(fields: [leadId], references: [id], onDelete: Restrict)
  deal      CrmDeal?        @relation(fields: [dealId], references: [id], onDelete: Restrict)

  @@index([orgId, leadId, createdAt])
  @@index([orgId, dealId, createdAt])
  @@map("crm_activities")
}

enum SalesQuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  SUPERSEDED
}

enum SalesOrderStatus {
  OPEN
  CANCELLED
}

/// A quotation offered to a customer, valid until a date. Revisions keep the number with a higher revision.
model SalesQuote {
  id            String           @id @default(uuid()) @db.Uuid
  orgId         String           @map("org_id") @db.Uuid
  /// Shown as QT-0001 (revision 2 as QT-0001-R2).
  number        Int
  revision      Int              @default(1)
  previousId    String?          @map("previous_id") @db.Uuid
  contactId     String           @map("contact_id") @db.Uuid
  dealId        String?          @map("deal_id") @db.Uuid
  status        SalesQuoteStatus @default(DRAFT)
  issueDate     DateTime         @map("issue_date") @db.Date
  validUntil    DateTime         @map("valid_until") @db.Date
  placeOfSupply String?          @map("place_of_supply") @db.Char(2)
  reference     String?          @db.VarChar(100)
  terms         String?          @db.VarChar(4000)
  memo          String?          @db.VarChar(1000)
  currency      String           @db.Char(3)
  subtotal      Decimal          @db.Decimal(24, 6)
  taxTotal      Decimal          @map("tax_total") @db.Decimal(24, 6)
  total         Decimal          @db.Decimal(24, 6)
  sentAt        DateTime?        @map("sent_at") @db.Timestamptz(6)
  decidedAt     DateTime?        @map("decided_at") @db.Timestamptz(6)
  declineReason String?          @map("decline_reason") @db.VarChar(500)
  orderId       String?          @map("order_id") @db.Uuid
  createdById   String           @map("created_by_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  org           Organization     @relation(fields: [orgId], references: [id], onDelete: Restrict)
  lines         SalesQuoteLine[]

  @@unique([orgId, number, revision])
  @@unique([id, orgId])
  @@index([orgId, status])
  @@index([orgId, contactId])
  @@map("sales_quotes")
}

model SalesQuoteLine {
  id          String     @id @default(uuid()) @db.Uuid
  orgId       String     @map("org_id") @db.Uuid
  quoteId     String     @map("quote_id") @db.Uuid
  lineNo      Int        @map("line_no")
  description String?    @db.VarChar(500)
  accountId   String     @map("account_id") @db.Uuid
  quantity    Decimal    @db.Decimal(24, 6)
  unitPrice   Decimal    @map("unit_price") @db.Decimal(24, 6)
