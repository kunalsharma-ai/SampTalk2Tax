{
  "name": "@talk2tax/database",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, migrations and database client for Talk2Tax",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "test": "echo 'database invariants are exercised by apps/api integration tests'",
    "migrate:status": "dotenv -e ../../.env -- prisma migrate status"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "typescript": "5.9.3",
    "dotenv-cli": "11.1.0"
  }
}
