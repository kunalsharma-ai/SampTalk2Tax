# syntax=docker/dockerfile:1
# Build from the repository root:
#   docker build -f apps/api/Dockerfile --target api .       the API server
#   docker build -f apps/api/Dockerfile --target migrate .   applies database migrations, then exits
#
# Behind a TLS-inspecting proxy, pass its CA as an optional build secret:
#   --secret id=extra_ca,src=<ca.pem>

# The full Node image already has OpenSSL (for Prisma) and CA certificates; no apt needed.
FROM node:22-bookworm AS build
RUN corepack enable
WORKDIR /repo
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages ./packages
COPY apps/api ./apps/api
RUN --mount=type=secret,id=extra_ca,required=false NODE_EXTRA_CA_CERTS=/run/secrets/extra_ca \
  pnpm install --frozen-lockfile --filter "@talk2tax/api..." && pnpm --filter "@talk2tax/api..." run build
# A production-only copy of the API and the workspace packages it uses. pnpm deploy installs the
# packages afresh without the generated Prisma client, so the one generated by the build (for this
# OS and OpenSSL) is copied next to @prisma/client in the copy, and loaded once to check it.
RUN --mount=type=secret,id=extra_ca,required=false NODE_EXTRA_CA_CERTS=/run/secrets/extra_ca \
  pnpm deploy --filter @talk2tax/api --prod --legacy /out \
  && cp -r apps/api/dist /out/dist \
  && cp -r /repo/node_modules/.pnpm/@prisma+client@*/node_modules/.prisma /out/node_modules/.pnpm/@prisma+client@*/node_modules/ \
  && cd /out && node -e "const { PrismaClient } = require(require.resolve('@prisma/client', { paths: [require.resolve('@talk2tax/database')] })); new PrismaClient()"

# Release step, run once before new API containers start: `prisma migrate deploy` against
# DATABASE_URL, then the MongoDB migrations against MONGODB_URL (while both databases are in use).
FROM build AS migrate
WORKDIR /repo/packages/database
USER node
CMD ["sh", "-c", "npx --no-install prisma migrate deploy && node /repo/apps/api/dist/db/migrate.js"]

# The API server: distroless (no shell or package manager), as a non-root user.
FROM gcr.io/distroless/nodejs22-debian12:nonroot AS api
WORKDIR /app
ENV NODE_ENV=production PORT=4000
# The commit the image was built from; shown under Platform admin → System health.
ARG GIT_SHA=""
ENV GIT_SHA=${GIT_SHA}
COPY --from=build /out ./
EXPOSE 4000
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
  CMD ["/nodejs/bin/node", "-e", "fetch('http://127.0.0.1:'+process.env.PORT+'/health').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"]
CMD ["dist/main.js"]
