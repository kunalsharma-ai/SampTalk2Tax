{
  "name": "@talk2tax/api",
  "version": "0.1.0",
  "private": true,
  "description": "Talk2Tax REST API (NestJS modular monolith)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "dev": "tsc -p tsconfig.build.json && node --enable-source-maps --env-file-if-exists=../../.env dist/main.js",
    "seed": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/seed/seed-demo.js",
    "seed:benchmark-peers": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/seed/seed-benchmark-peers.js",
    "admin:grant": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/admin/grant-admin.js",
    "region:move": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/regions/move-org.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "@talk2tax/accounting-engine": "workspace:*",
    "@talk2tax/database": "workspace:*",
    "@talk2tax/security": "workspace:*",
    "@talk2tax/tax-engine": "workspace:*",
    "helmet": "8.3.0",
    "jose": "6.2.14",
    "nodemailer": "10.3.1",
    "pdfkit": "0.17.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.8",
    "@swc/core": "1.16.21",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pdfkit": "0.17.7",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "typescript": "5.9.3",
    "unplugin-swc": "2.0.0",
    "vitest": "3.2.7"
  }
}
